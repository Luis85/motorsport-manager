{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wildlands:game-manifest:1",
  "title": "Wildlands game folder manifest (game.json)",
  "description": "Engine-owned grammar of a data-only game folder (docs/concepts/<id>/game.json). Paths are folder-relative POSIX paths. Rules that compare values (id equals the folder name, storage namespace wildlands.<id> or the legacy littlewild namespace for the littlewild game, html output demos/<id>.html, referenced files exist, closed file inventory) are checked by source/tools/game-folder.cts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "version",
    "template",
    "engine",
    "content",
    "presentation",
    "storage",
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "format": {
      "const": "wildlands-game"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})(?:-[0-9A-Za-z.-]{1,40})?$"
    },
    "template": {
      "enum": [
        "colony",
        "rts",
        "pet"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api"
      ],
      "properties": {
        "api": {
          "const": 1
        }
      }
    },
    "features": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "storytelling-player",
          "renderers-2d"
        ]
      }
    },
    "content": {
      "type": "object"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "accent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 7,
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*$"
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "html"
      ],
      "properties": {
        "html": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output",
            "budgetBytes"
          ],
          "properties": {
            "output": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^demos/[a-z][a-z0-9-]{0,63}\\.html$"
            },
            "budgetBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        },
        "godot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engineSources"
          ],
          "properties": {
            "engineSources": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "template": {
            "const": "colony"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/colonyContent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "rts"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/rtsContent"
          },
          "features": {
            "type": "array",
            "maxItems": 0
          },
          "targets": {
            "type": "object",
            "properties": {
              "godot": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "template": {
            "const": "pet"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/petContent"
          },
          "features": {
            "type": "array",
            "maxItems": 0
          },
          "targets": {
            "type": "object",
            "properties": {
              "godot": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "colonyContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "balancing",
        "assets",
        "creatures",
        "interactions",
        "packs",
        "defaultId"
      ],
      "properties": {
        "balancing": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
        },
        "assets": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$"
        },
        "creatures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog",
            "editorFields"
          ],
          "properties": {
            "catalog": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
            },
            "editorFields": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
            }
          }
        },
        "interactions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
        },
        "packs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.pack\\.json$"
          }
        },
        "defaultId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "canonicalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "skillTree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
        },
        "adventureExamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
          }
        }
      }
    },
    "rtsContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog"
      ],
      "properties": {
        "catalog": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
        }
      }
    },
    "petContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog"
      ],
      "properties": {
        "catalog": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*\\.json$"
        },
        "assets": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?:[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*/){0,7}[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9_-]+)*$"
        }
      }
    }
  }
}
