{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "littlewild-3d-asset.schema.json",
  "title": "Littlewild bundled 3D asset",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "schemaVersion",
    "category",
    "id",
    "name",
    "materials",
    "models",
    "metadata"
  ],
  "properties": {
    "format": {
      "const": "littlewild-3d-asset"
    },
    "schemaVersion": {
      "const": 1
    },
    "category": {
      "enum": [
        "building",
        "item",
        "actor",
        "pet"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          {
            "$ref": "#/$defs/material"
          }
        ]
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "behaviors": {
      "type": "object",
      "properties": {
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bodyBob",
            "breath",
            "earSway",
            "tailSway",
            "footLift",
            "footStride",
            "walkArmSwing",
            "workArmBase",
            "workArmSwing",
            "blinkThreshold",
            "idleHeadYaw",
            "idleHeadRoll"
          ],
          "properties": {
            "bodyBob": {
              "type": "number"
            },
            "breath": {
              "type": "number"
            },
            "earSway": {
              "type": "number"
            },
            "tailSway": {
              "type": "number"
            },
            "footLift": {
              "type": "number"
            },
            "footStride": {
              "type": "number"
            },
            "walkArmSwing": {
              "type": "number"
            },
            "workArmBase": {
              "type": "number"
            },
            "workArmSwing": {
              "type": "number"
            },
            "blinkThreshold": {
              "type": "number",
              "minimum": 0.8,
              "exclusiveMaximum": 1
            },
            "idleHeadYaw": {
              "type": "number"
            },
            "idleHeadRoll": {
              "type": "number"
            }
          }
        },
        "appearances": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "scale",
              "labelHeight",
              "contextHeight",
              "bubbleHeight",
              "materials"
            ],
            "properties": {
              "model": {
                "type": "string"
              },
              "scale": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "labelHeight": {
                "type": "number"
              },
              "contextHeight": {
                "type": "number"
              },
              "bubbleHeight": {
                "type": "number"
              },
              "materials": {
                "type": "object"
              }
            }
          }
        },
        "expression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "angerAt",
            "tiredEnergyBelow",
            "concernFoodBelow",
            "concernWaterBelow",
            "happyJoyAbove"
          ],
          "properties": {
            "angerAt": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "tiredEnergyBelow": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "concernFoodBelow": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "concernWaterBelow": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "happyJoyAbove": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    "rig": {
      "type": "object"
    },
    "meshes": {
      "type": "object",
      "description": "Baked indexed triangle meshes referenced by mesh primitives.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "positions"
        ],
        "properties": {
          "positions": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 9,
            "maxItems": 24576
          },
          "normals": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 49152
          }
        }
      }
    }
  },
  "$defs": {
    "materialProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "emissive": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "sheenColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metalness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sheen": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sheenRoughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clearcoat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clearcoatRoughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transparent": {
          "type": "boolean"
        },
        "depthWrite": {
          "type": "boolean"
        },
        "flatShading": {
          "type": "boolean"
        },
        "doubleSided": {
          "type": "boolean"
        },
        "emissiveIntensity": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "material": {
      "allOf": [
        {
          "$ref": "#/$defs/materialProps"
        },
        {
          "required": [
            "color"
          ]
        }
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "materialProps": {
          "$ref": "#/$defs/materialProps"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
