import path from 'node:path';
import {admit,limits,type Storyboard,type StoryboardCard} from './storyboard-schema.cjs';
import {StoryboardFiles,sha256,type ImageEvidence,type InputReceipt} from './storyboard-files.cjs';
import {facts,record,type Fact} from './storyboard-facts.cjs';
export interface CardReceipt {id:string;sourceKind:string|null;facts:Fact[];images:Omit<ImageEvidence,'data'>[];}
export interface StoryboardReceipt {format:'wildlands-storyboard-receipt';schemaVersion:1;title:string;layout:string;sectionCount:number;cardCount:number;cards:CardReceipt[];inputs:InputReceipt[];html:{sha256:string;bytes:number};validation:'presentation-only';warnings:string[];}
const escape=(value:unknown):string=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const paragraph=(text:string|undefined,style=''):string=>text?'<p'+(style?' class="'+style+'"':'')+'>'+escape(text)+'</p>':'';
const styles=`
:root{color-scheme:light;--ink:#243b30;--paper:#f6f3e9;--rule:#d7dccc;--muted:#566653;--accent:#8b672e}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 system-ui,sans-serif}main{max-width:1440px;margin:auto;padding:64px 4vw}header{max-width:960px;margin-bottom:52px}h1,h2,h3{font-family:Georgia,serif;font-weight:500;line-height:1.15;text-wrap:balance;overflow-wrap:anywhere}h1{font-size:clamp(2.4rem,5vw,4.8rem);margin:.3em 0}h2{font-size:2rem;margin:0}h3{font-size:1.55rem;margin:0}p{white-space:pre-wrap;overflow-wrap:anywhere}.intro{font-size:1.15rem}nav{display:flex;gap:10px;flex-wrap:wrap}nav a{min-width:0;max-width:100%;overflow-wrap:anywhere;color:var(--ink);padding:8px 14px;border:1px solid var(--rule);border-radius:99px;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px}section{margin:64px 0;scroll-margin-top:30px}.section-head{max-width:900px;margin-bottom:24px}.cards{display:grid;gap:24px;grid-template-columns:repeat(2,minmax(0,1fr))}.sequence .cards{grid-template-columns:1fr}.sequence .card{max-width:1120px}.comparison .cards{align-items:start}.card{background:#fffef9;border:1px solid var(--rule);border-radius:18px;padding:26px;min-width:0;overflow:hidden}.card-index{color:var(--accent);font-size:.78rem;font-weight:700;margin-bottom:8px}.intent{padding:12px 16px;background:#f0f4e9}.label{font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;font-weight:700;margin-bottom:0}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:20px 0}.gallery figure:first-child{grid-column:1/-1}figure{margin:0}img{display:block;width:100%;height:auto;max-height:760px;object-fit:contain;border-radius:10px;background:#edece3}figcaption{font-size:.83rem;color:var(--muted);margin-top:7px;overflow-wrap:anywhere}.empty{margin:20px 0;padding:24px;border:1px dashed var(--rule);border-radius:10px;color:var(--muted)}dl{display:grid;grid-template-columns:minmax(100px,.7fr) minmax(0,1.3fr);gap:6px 14px;font-size:.88rem}dt{color:var(--muted)}dd{margin:0;overflow-wrap:anywhere}.source{font-size:.76rem;color:var(--muted);overflow-wrap:anywhere}details{margin-top:18px;border-top:1px solid var(--rule);padding-top:12px}summary{cursor:pointer;font-size:.88rem}pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:440px;overflow:auto;font-size:.75rem;background:#f1f1e9;padding:16px}.notes{font-size:.86rem;color:var(--muted);border-top:1px solid var(--rule);padding-top:20px}footer{margin-top:60px;font-size:.8rem;color:var(--muted)}@media(max-width:760px){main{padding:30px 20px}.cards,.gallery{grid-template-columns:1fr}.card{padding:20px}section{margin:42px 0}dl{grid-template-columns:1fr}dd{margin-bottom:8px}}@media print{body{background:white}main{padding:0;max-width:none}nav,details{display:none}.cards,.gallery{display:block}.card{break-inside:auto;border-radius:0;margin-bottom:20px}figure{break-inside:avoid;margin:12px 0}img{max-height:90mm;object-fit:contain}h2,h3{break-after:avoid}section{margin:30px 0}h1{font-size:36pt}a{color:inherit}}
`;
function autoProject(value:unknown,source:string):Storyboard {
 const doc=record(value),pack=record(doc.pack);
 if(doc.format!=='wildlands-project'||![1,2].includes(Number(doc.schemaVersion))||!Array.isArray(pack.scenes))throw Error('--project needs a wildlands-project schemaVersion 1 or 2 with pack.scenes. Use --input with a storyboard manifest for other artifacts.');
 const title=typeof doc.name==='string'&&doc.name.trim()?doc.name.slice(0,240):'Wildlands project';
 return {format:'wildlands-storyboard',schemaVersion:1,title,layout:'sequence',sections:[{id:'project',title:'Project overview',cards:[{id:'project-source',title,source}]}]};
}
/** Snapshot input bytes once, preserve authored ordering, and embed evidence without executing content. */
export function buildStoryboard(inputFile:string,mode:'manifest'|'project'='manifest'):{html:string;receipt:StoryboardReceipt} {
 const files=new StoryboardFiles(inputFile),sourceFile=files.resolve(path.basename(path.resolve(inputFile))),source=files.json(sourceFile,mode==='project'?'project':'manifest',mode==='project'?limits.jsonBytes:limits.manifestBytes);
 const document=mode==='project'?autoProject(source,path.basename(sourceFile)):admit(source),layout=document.layout??'grid';
 const warnings:string[]=[],cards:CardReceipt[]=[];
 const warn=(value:string):void=>{if(!warnings.includes(value))warnings.push(value);};
 let cardIndex=0,renderedBytes=0;
 function renderCard(card:StoryboardCard):string {
  cardIndex++;let sourceValue:unknown,sourceKind:string|null=null,derived:Fact[]=[],sourcePath='';const images:ImageEvidence[]=[];
  if(card.source){const resolved=files.resolve(card.source);sourcePath=files.relative(resolved);sourceValue=files.json(resolved);const observed=facts(sourceValue);sourceKind=observed.kind;derived=observed.facts;
   if(sourceKind==='character-studio-review'||sourceKind==='review-result'){
    const review=record(sourceValue);if(review.schemaVersion!==1||!Array.isArray(review.frames)||review.frames.length>36)throw Error('Use a version 1 review receipt with at most 36 frames: '+sourcePath);
    const captures=[...(review.contactSheet?[review.contactSheet]:[]),...review.frames];
    for(const capture of captures){const entry=record(capture);if(typeof entry.file!=='string')throw Error('Review capture needs a relative file: '+sourcePath);const image=files.image(entry.file,path.dirname(resolved),entry.sha256),previous=images.find(row=>row.path===image.path);if(previous)previous.hashVerified||=image.hashVerified;else images.push(image);}
    if(images.some(image=>!image.hashVerified))warn('Some review images have no declared SHA-256. Their observed hashes are recorded, but the review did not bind them.');
   }
  }
  if(card.image)images.push(files.image(card.image));
  if(!images.length)warn('No capture supplied for '+card.id+'. Add image or a Character Studio/Scene Forge review manifest as source to show the actual appearance.');
  cards.push({id:card.id,sourceKind,facts:derived,images:images.map(({data:_,...image})=>image)});
  const captureHtml=images.length?'<div class="gallery">'+images.map(image=>'<figure><img src="'+image.data+'" width="'+image.width+'" height="'+image.height+'" alt="'+escape(card.caption??card.title)+'"><figcaption>'+escape(image.path)+(image.hashVerified?' · verified review image':'')+'</figcaption></figure>').join('')+'</div>':'<div class="empty">No capture supplied. Add a review or image to show the built result.</div>';
  const sourceHtml=sourceKind?'<p class="label">Source facts</p><dl>'+derived.map(fact=>'<dt>'+escape(fact.label)+'</dt><dd>'+escape(fact.value)+'</dd>').join('')+'</dl><p class="source">'+escape(sourcePath)+'<br>SHA-256 '+files.inputs.find(input=>input.path===sourcePath)!.sha256+'</p><details><summary>Inspect supplied JSON</summary><pre>'+escape(JSON.stringify(sourceValue))+'</pre></details>':'';
  const html='<article class="card" id="'+card.id+'"><div class="card-index">'+String(cardIndex).padStart(2,'0')+'</div><h3>'+escape(card.title)+'</h3>'+(card.intent?'<div class="intent"><p class="label">Intent</p>'+paragraph(card.intent)+'</div>':'')+captureHtml+paragraph(card.caption)+sourceHtml+'</article>';
  renderedBytes+=Buffer.byteLength(html);if(renderedBytes>limits.htmlBytes)throw Error('Storyboard HTML exceeds the 48 MiB output limit. Split it into smaller storyboards.');
  return html;
 }
 const sections=document.sections.map(section=>'<section id="'+section.id+'"><div class="section-head"><h2>'+escape(section.title)+'</h2>'+(section.intent?'<p class="label">Intent</p>'+paragraph(section.intent):'')+'</div><div class="cards">'+section.cards.map(renderCard).join('')+'</div></section>').join('');
 const html='<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src \'none\'; img-src data:; style-src \'unsafe-inline\'; base-uri \'none\'; form-action \'none\'"><title>'+escape(document.title)+'</title><style>'+styles+'</style></head><body class="'+layout+'"><main><header><h1>'+escape(document.title)+'</h1>'+(document.intent?'<p class="label">Intent</p>'+paragraph(document.intent,'intro'):'')+'<nav aria-label="Storyboard sections">'+document.sections.map(section=>'<a href="#'+section.id+'">'+escape(section.title)+'</a>').join('')+'</nav></header>'+sections+'<aside class="notes"><strong>Evidence and scope</strong><p>Source facts describe the supplied files. Intent is authored separately. Captures show supplied images; no simulation or native content validation ran. Review image hashes are checked when supplied; reported recipe and render hashes describe the source review.</p>'+warnings.map(warning=>paragraph(warning)).join('')+'</aside><footer>Wildlands storyboard · schema 1 · '+cards.length+' cards · '+files.inputs.length+' source files</footer></main></body></html>\n';
 const bytes=Buffer.byteLength(html);if(bytes>limits.htmlBytes)throw Error('Storyboard HTML exceeds the 48 MiB output limit. Split it into smaller storyboards.');
 return {html,receipt:{format:'wildlands-storyboard-receipt',schemaVersion:1,title:document.title,layout,sectionCount:document.sections.length,cardCount:cards.length,cards,inputs:files.inputs,html:{sha256:sha256(html),bytes},validation:'presentation-only',warnings}};
}
