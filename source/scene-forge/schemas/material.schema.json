{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "metalness": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "roughness": {
      "default": 0.65,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "surface": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fur",
            "cloth",
            "leather"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 16
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "seed",
        "scale",
        "strength"
      ],
      "additionalProperties": false
    },
    "sheen": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sheenColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "sheenRoughness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "clearcoat": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "clearcoatRoughness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "emissive": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "emissiveIntensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "opacity": {
      "default": 1,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "depthWrite": {
      "type": "boolean"
    },
    "doubleSided": {
      "default": false,
      "type": "boolean"
    },
    "flatShading": {
      "default": false,
      "type": "boolean"
    },
    "shading": {
      "type": "string",
      "enum": [
        "standard",
        "unlit"
      ]
    },
    "vertexColors": {
      "type": "boolean"
    }
  },
  "required": [
    "color"
  ],
  "additionalProperties": false
}
