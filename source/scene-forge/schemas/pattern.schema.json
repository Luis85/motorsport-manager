{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "path"
        },
        "points": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "$ref": "#/$defs/__schema0"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          }
        },
        "orient": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "yaw"
          ]
        }
      },
      "required": [
        "type",
        "points"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "linear"
        },
        "count": {
          "$ref": "#/$defs/__schema0"
        },
        "step": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "$ref": "#/$defs/__schema0"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "type",
        "count",
        "step"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "radial"
        },
        "count": {
          "$ref": "#/$defs/__schema0"
        },
        "radius": {
          "$ref": "#/$defs/__schema0"
        },
        "startAngle": {
          "default": 0,
          "$ref": "#/$defs/__schema0"
        },
        "sweep": {
          "default": 360,
          "$ref": "#/$defs/__schema0"
        },
        "orient": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "count",
        "radius"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "grid"
        },
        "counts": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "$ref": "#/$defs/__schema0"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "step": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "$ref": "#/$defs/__schema0"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "centered": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "counts",
        "step"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "object",
          "properties": {
            "$param": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
            }
          },
          "required": [
            "$param"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$expr": {
              "type": "string",
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "min",
                "max",
                "abs",
                "neg",
                "sin",
                "cos",
                "clamp"
              ]
            },
            "args": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "$expr",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
