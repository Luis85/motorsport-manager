{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "littlewild-export"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "assets": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,60}$"
          },
          "family": {
            "type": "string",
            "enum": [
              "items",
              "buildings",
              "creatures",
              "pets"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "models": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,60}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                },
                "parameters": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": -1000000,
                    "maximum": 1000000
                  }
                },
                "materials": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "metalness": {
                        "default": 0,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "roughness": {
                        "default": 0.65,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "surface": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "fur",
                              "cloth",
                              "leather"
                            ]
                          },
                          "version": {
                            "anyOf": [
                              {
                                "type": "number",
                                "const": 1
                              },
                              {
                                "type": "number",
                                "const": 2
                              }
                            ]
                          },
                          "seed": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                          },
                          "scale": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 16
                          },
                          "strength": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        },
                        "required": [
                          "kind",
                          "seed",
                          "scale",
                          "strength"
                        ],
                        "additionalProperties": false
                      },
                      "sheen": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sheenColor": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "sheenRoughness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "clearcoat": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "clearcoatRoughness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "emissive": {
                        "type": "string",
                        "pattern": "^#[0-9a-fA-F]{6}$"
                      },
                      "emissiveIntensity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20
                      },
                      "opacity": {
                        "default": 1,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "depthWrite": {
                        "type": "boolean"
                      },
                      "doubleSided": {
                        "default": false,
                        "type": "boolean"
                      },
                      "flatShading": {
                        "default": false,
                        "type": "boolean"
                      },
                      "shading": {
                        "type": "string",
                        "enum": [
                          "standard",
                          "unlit"
                        ]
                      }
                    },
                    "required": [
                      "color"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "model"
              ],
              "additionalProperties": false
            }
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 64
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "maxLength": 120
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "family",
          "name",
          "models"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "target",
    "assets"
  ],
  "additionalProperties": false
}
