{
  "name": "scene-forge-cli",
  "version": "0.6.0",
  "private": true,
  "description": "Declarative 3D authoring for agents: projects, parametric models, scenes, exports and visual verification.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "forge3d": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cli": "node scripts/standalone.mjs",
    "check:cli": "node scripts/standalone.mjs --check",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e/*.test.ts",
    "cli": "node --import tsx src/cli.ts",
    "format": "prettier --write src tests scripts *.json *.md docs/*.md",
    "format:check": "prettier --check src tests scripts *.json *.md docs/*.md",
    "verify": "node scripts/verify.mjs",
    "release:examples": "node scripts/release-examples.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "examples:generate": "node --import tsx scripts/create-showcase.mjs",
    "release:showcase": "node scripts/release-showcase.mjs"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "playwright": "^1.55.0",
    "three": "0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "0.9.7",
    "zod": "^4.0.0",
    "gltf-validator": "^2.0.0-dev.3.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
