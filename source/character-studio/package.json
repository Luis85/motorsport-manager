{
  "name": "littlewild-character-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:cli": "node scripts/build.mjs",
    "check:cli": "node scripts/build.mjs --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:handoff": "node scripts/integration-smoke.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.183.1",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "tsx": "4.20.0",
    "typescript": "5.9.3"
  }
}
