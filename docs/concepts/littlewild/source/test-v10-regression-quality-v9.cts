// Historical regression adapted explicitly for v10 research, beds, physical stalls and door routing.
const V10=require('./test-v10-fixtures.cjs');
'use strict';
const assert=require('node:assert/strict'),fs=require('node:fs');
const L=require('./simulation.cjs'), W=require('./world-content.js'), S=require('./story-codec.js');
const results=[];const test=(name,fn)=>{try{fn();results.push({name,passed:true});}catch(e){results.push({name,passed:false,error:e.stack});console.error('FAIL',name,e.message);}};
const clone=W.clone,snap=e=>JSON.stringify(e.export());
function clean(){const e=L.createWorldDemo();e.s.started=true;e.s.paused=false;e.selectCreature('c1');for(const c of e.creatures){c.task=null;c.orders=[];c.training=null;c.learning.queue=[];c.equipQueue=[];c.questPlan=null;c.activeQuest=null;c.stockTargets={};c.worldPickup=null;c.worldSupply=null;c.needsDeposit=false;c.feelings.anger=0;c.feelings.coolingUntil=0;c.feelings.social=90;for(const k in c.needs)c.needs[k]=95;}for(const b of e.s.buildings)if(b.storage){Object.assign(b.storage,{input:{},output:{},job:null,requests:{},targets:{},enabled:true});}return e;}
function arrive(e,t){assert(t);assert(e.startTask(t));const p=t.path.at(-1)||e.s.creature;Object.assign(e.s.creature,{x:p.x,y:p.y});t.path=[];t.phase='work';return t;}
function fixture(id='planks'){const e=clean(),b=e.s.buildings.find(b=>b.kind==='bench'),r=e.recipe(b,id);e.actor.skills[r.skill]=true;b.storage.input=clone(r.cost);return {e,b,r};}
const total=(e,id)=>e.creatures.reduce((n,c)=>n+(c.inventory[id]||0),0)+(e.s.colony.warehouse.inventory[id]||0)+e.s.buildings.reduce((n,b)=>n+(b.storage?.input[id]||0)+(b.storage?.output[id]||0)+(b.storage?.job?.cost[id]||0),0);

test('Stale harvest completion cannot generate a second yield or roll',()=>{const e=clean(),n=e.s.nodes.find(n=>n.kind==='stone');e.actor.skills.stonework=true;e.actor.inventory.stone=0;e.s.colony.warehouse.inventory.stone=0;let rolls=0;e.check=()=>{rolls++;return {success:true};};const t=arrive(e,{kind:'gather',nodeId:n.id,resource:'stone',worldGather:true,target:{x:n.x,y:n.y},duration:2,label:'Stone'});e.finishTask(t);const state=snap(e);e.finishTask(t);assert.equal(snap(e),state);assert.equal(rolls,1);});
test('A stale transfer cannot cancel the replacement task or consume later output',()=>{const {e,b}=fixture();b.storage.output.planks=2;const t=arrive(e,e.collectTask(b,'planks',1));e.finishTask(t);const newer={kind:'idle',label:'Taking a moment',duration:4,elapsed:0,path:[],phase:'work',target:{x:e.s.creature.x,y:e.s.creature.y}};e.actor.task=newer;const before=snap(e);e.finishTask(t);assert.equal(snap(e),before);assert.equal(e.actor.task,newer);});
test('An old paid-work task cannot reserve a new batch',()=>{const {e,b,r}=fixture();const t=arrive(e,e.productionTask(b,'planks'));e.check=()=>({success:true});e.finishTask(t);b.storage.input=clone(r.cost);const before=snap(e);assert.equal(e.startTask(t),false);assert.equal(snap(e),before);});
test('Interrupted work credits the original personal order when another creature finishes',()=>{const {e,b}=fixture(),origin=e.actor;const id='o'+e.s.nextId++;origin.orders.push({id,type:'craft',resource:'planks',amount:1,done:0,created:e.s.simTime,priority:0,paused:false});arrive(e,e.productionTask(b,'planks',id));e.configureBuilding(b.id,'enabled',false);e.configureBuilding(b.id,'enabled',true);e.withActor(e.creatures[1],()=>{e.actor.skills.woodwork=true;e.check=()=>({success:true});e.finishTask(arrive(e,e.productionTask(b,'planks')));});assert(!origin.orders.some(o=>o.id===id));assert.equal(b.storage.output.planks,1);});
test('Canceling an originating order preserves the paid batch but detaches its credit',()=>{const {e,b}=fixture(),c=e.actor,id='o'+e.s.nextId++;c.orders.push({id,type:'craft',resource:'planks',amount:1,done:0,created:0,priority:0,paused:false});arrive(e,e.productionTask(b,'planks',id));assert(e.cancel(id).ok);assert(b.storage.job);assert.equal(b.storage.job.orderId,null);assert.doesNotThrow(()=>S.inspect(S.encode(e)));});
test('Another creature cannot settle a reserved batch belonging to its active worker',()=>{const {e,b}=fixture();const t=arrive(e,e.productionTask(b,'planks'));const worker=e.actor;const before=snap(e);e.withActor(e.creatures[1],()=>e.finishTask(t));assert.equal(snap(e),before);assert.equal(b.storage.job.workerId,worker.id);});
test('Underfilled finite substrate is blocked consistently before dispatch',()=>{const d=clone(W.content);d.nodes.find(n=>n.id==='groundwater').mode='finite';W.withLibrary(d,()=>{const e=clean(),b=e.s.buildings.find(b=>b.kind==='well'),n=e.nodeAt(b.x,b.y);e.actor.skills.masonry=true;n.stock=1;b.storage.requests.water=1;assert.equal(e.productionTask(b,'water'),null);assert.match(e.buildingStatus(b).label,/insufficient|exhausted|not enough/i);});});
test('Construction cannot seal the spring’s only approach',()=>{const d=clone(W.content);d.buildings.find(b=>b.id==='kiln').requiresNode='clay';W.withLibrary(d,()=>{const e=V10.knowledge(new L.Engine());assert.equal(e.nodeAt(12,5).kind,'clay');assert.equal(e.canBuild(12,5,'kiln'),false);assert.match(e.placementIssue('kiln',12,5),/access|approach|spring/i);});});
test('A replanned node topology invalidates cached routes',()=>{const e=clean();let p;for(let y=2;y<17&&!p;y++)for(let x=2;x<17&&!p;x++)if(e.walkable(x,y)&&!e.nodeAt(x,y))p={x,y};assert(p);e.walkable(p.x,p.y);e.s.nodes.push({id:'probe',kind:'wood',x:p.x,y:p.y,stock:1,max:1,regen:0});assert(!e.walkable(p.x,p.y));e.s.nodes.pop();assert(e.walkable(p.x,p.y));});
test('Path consumers never share mutable route arrays or points',()=>{const e=clean(),b=e.warehouse(),a=e.findPath(b,true),expected=e.findPath(b,true);assert(a.length);a[0].x=999;a.shift();assert.deepEqual(e.findPath(b,true),expected);});
test('Reordered ingredient object keys are a valid exact story',()=>{const {e,b}=fixture('beams');arrive(e,e.productionTask(b,'beams'));const save=S.encode(e),j=save.state.buildings.find(x=>x.id===b.id).storage.job;j.cost=Object.fromEntries(Object.entries(j.cost).reverse());assert.doesNotThrow(()=>S.inspect(save));});
test('Duplicate paid-batch identifiers are rejected before loading',()=>{const e=clean(),a=e.s.buildings.find(b=>b.kind==='bench'),b=e.s.buildings.find(b=>b.kind==='kiln');a.storage.input=clone(e.recipe(a,'planks').cost);b.storage.input=clone(e.recipe(b,'bricks').cost);arrive(e,e.productionTask(a,'planks'));e.configureBuilding(a.id,'enabled',false);arrive(e,e.productionTask(b,'bricks'));e.configureBuilding(b.id,'enabled',false);const save=S.encode(e),j=save.state.buildings.find(x=>x.id===a.id).storage.job;save.state.buildings.find(x=>x.id===b.id).storage.job.id=j.id;assert.throws(()=>S.inspect(save));});
test('Used work identifiers cannot be reissued by a stale sequence',()=>{const {e,b}=fixture();arrive(e,e.productionTask(b,'planks'));const save=S.encode(e);save.state.world.sequence=1;assert.throws(()=>S.inspect(save));});
test('The next entity counter cannot collide with existing IDs',()=>{const save=S.encode(clean());save.state.nextId=1;assert.throws(()=>S.inspect(save));});
test('Overlapping building plans in different satchels are rejected',()=>{const e=clean(),save=S.encode(e),order={id:'o'+save.state.nextId++,type:'build',kind:'shelter',x:8,y:12,progress:0,paid:false,paused:false,priority:0,created:0};save.state.colony.creatures[0].orders=[order];save.state.colony.creatures[1].orders=[{...order,id:'o'+save.state.nextId++}];assert.throws(()=>S.inspect(save));});
test('Duplicate order IDs across creatures are rejected',()=>{const save=S.encode(clean()),o={id:'o'+save.state.nextId++,type:'gather',resource:'wood',amount:3,done:0,paused:false,priority:0,created:0};save.state.colony.creatures[0].orders=[o];save.state.colony.creatures[1].orders=[clone(o)];assert.throws(()=>S.inspect(save));});
for(const value of [NaN,Infinity,-Infinity,'0.1',null])test('Invalid time input '+String(value)+' has no effects',()=>{const e=clean(),before=snap(e);e.step(value);assert.equal(snap(e),before);});

test('Pausing the original craft order also pauses its shared paid work',()=>{const {e,b}=fixture(),origin=e.actor,id='o'+e.s.nextId++;origin.orders.push({id,type:'craft',resource:'planks',amount:1,done:0,created:0,priority:0,paused:false});arrive(e,e.productionTask(b,'planks',id));assert(e.pauseOrder(id,true).ok);e.withActor(e.creatures[1],()=>assert.equal(e.productionTask(b,'planks'),null));assert.equal(e.buildingStatus(b).label,'Plan paused');assert(e.pauseOrder(id,false).ok);e.withActor(e.creatures[1],()=>assert(e.productionTask(b,'planks')));});
test('Resource blocker details retain the presentation contract',()=>{const e=clean();for(const c of e.creatures)c.inventory.stone=0;e.s.colony.warehouse.inventory.stone=0;for(const n of e.s.nodes)if(n.kind==='stone')n.stock=0;const issue=e.assessResource('stone',1);assert.equal(typeof issue.text,'string');assert.match(issue.text,/remains/);});
test('Paid-batch origin survives exact save/restore before a worker handoff',()=>{const {e,b}=fixture(),id='o'+e.s.nextId++;e.actor.orders.push({id,type:'craft',resource:'planks',amount:1,done:0,created:0,priority:0,paused:false});arrive(e,e.productionTask(b,'planks',id));e.configureBuilding(b.id,'enabled',false);const restored=S.commit(S.inspect(S.encode(e))),other=restored.creatures[1],building=restored.s.buildings.find(x=>x.id===b.id);restored.configureBuilding(b.id,'enabled',true);restored.check=()=>({success:true});restored.withActor(other,()=>restored.finishTask(arrive(restored,restored.productionTask(building,'planks'))));assert(!restored.creatures[0].orders.some(o=>o.id===id));});
test('Fresh worlds retain access to all harvestable sources after every legal candidate',()=>{const e=new L.Engine();for(let y=2;y<=16;y++)for(let x=2;x<=16;x++){if(!e.canBuild(x,y,'shelter'))continue;assert.equal(LWWorldIntegrity.resourceAccessIssue(e,{x,y,kind:'shelter'}),null);}});
test('An unavailable closest output does not shadow a reachable source',()=>{const e=clean(),b=e.s.buildings.find(b=>b.kind==='bench'),other=e.s.buildings.find(b=>b.kind==='kiln');b.storage.output.wood=1;other.storage.output.wood=1;const find=e.findPath.bind(e);e.findPath=(target,adj)=>target===b?null:find(target,adj);assert.equal(e.sourceBuilding('wood').id,other.id);});
test('An unreachable deposit does not shadow another reachable deposit',()=>{const e=clean();e.s.colony.warehouse.inventory.stone=0;e.actor.inventory.stone=0;const nodes=e.s.nodes.filter(n=>n.kind==='stone');const nearest=e.nearest(nodes),find=e.findPath.bind(e);e.findPath=(target,adj)=>target===nearest?null:find(target,adj);const t=e.resourceTask('stone',null,true);assert(t);assert.notEqual(t.nodeId,nearest.id);});
test('Quantity-map comparison ignores ordering but rejects extra zero fields',()=>{assert(LWWorldIntegrity.sameQuantities({wood:2,stone:1},{stone:1,wood:2}));assert(!LWWorldIntegrity.sameQuantities({wood:2,stone:0},{wood:2}));assert(!LWWorldIntegrity.sameQuantities({wood:2},{wood:3}));});
test('Invalid import leaves every active content library untouched',()=>{const e=clean(),save=S.encode(e),hashes=[LWContent.registry.hash,LWAdventure.hash,W.hash],before=snap(e);save.state.colony.creatures[0].inventory.wood=-1;assert.throws(()=>S.inspect(save));assert.deepEqual([LWContent.registry.hash,LWAdventure.hash,W.hash],hashes);assert.equal(snap(e),before);});
test('Authentic v8 paid work recovers recorded originating order identity',()=>{const doc=JSON.parse(fs.readFileSync(__dirname+'/fixtures/v8-paid-work.json','utf8'));const b=doc.state.buildings.find(b=>b.storage?.job);assert(!Object.hasOwn(b.storage.job,'orderId'));const e=S.commit(S.inspect(doc)),out=e.s.buildings.find(x=>x.id===b.id);assert.equal(out.storage.job.orderId,e.actor.orders[0].id);assert.equal(out.storage.job.progress,1);const second=S.commit(S.inspect(S.encode(e)));assert.equal(snap(e),snap(second));});
test('An old interrupted batch does not fabricate missing order evidence',()=>{const doc=JSON.parse(fs.readFileSync(__dirname+'/fixtures/v8-paid-work.json','utf8'));const b=doc.state.buildings.find(b=>b.storage?.job);b.storage.job.workerId=null;doc.state.colony.creatures[0].task=null;const e=S.commit(S.inspect(doc));assert.equal(e.s.buildings.find(x=>x.id===b.id).storage.job.orderId,null);});
const report={suite:'Littlewild v9 quality regressions',passed:results.filter(r=>r.passed).length,failed:results.filter(r=>!r.passed).length,results};fs.writeFileSync(__dirname+'/v10-regression-v9-quality-results.json',JSON.stringify(report,null,2));console.log(`${report.passed}/${results.length} quality checks passed`);process.exitCode=report.failed?1:0;
