{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "version",
    "definitions",
    "triggers"
  ],
  "properties": {
    "format": {
      "const": "littlewild-interactions"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "executor",
          "sources",
          "targets",
          "targetKinds",
          "range",
          "cooldown",
          "minimumEnergy",
          "maximumAnger",
          "requireIdle",
          "cost",
          "effects",
          "action",
          "autonomous",
          "duel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "executor": {
            "enum": [
              "effects",
              "duel",
              "care",
              "social",
              "world-task"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "player",
                "creature"
              ]
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "creature",
                "building",
                "node"
              ]
            }
          },
          "targetKinds": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "range": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "cooldown": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          },
          "minimumEnergy": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "maximumAnger": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "requireIdle": {
            "type": "boolean"
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "energy",
              "items"
            ],
            "properties": {
              "energy": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "items": {
                "type": "object",
                "maxProperties": 16,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                }
              }
            }
          },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "joy",
                  "energy",
                  "social",
                  "anger",
                  "bond"
                ],
                "properties": {
                  "joy": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "energy": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "social": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "anger": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "bond": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  }
                }
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "joy",
                  "energy",
                  "social",
                  "anger",
                  "bond"
                ],
                "properties": {
                  "joy": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "energy": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "social": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "anger": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "bond": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  }
                }
              }
            }
          },
          "action": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "autonomous": {
            "type": "boolean"
          },
          "duel": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "skill",
                  "maxRounds",
                  "pointsToWin",
                  "roundSeconds",
                  "responseSeconds",
                  "sourceModifier",
                  "targetModifier",
                  "scoring",
                  "sourceEnergyPerRound",
                  "targetEnergyPerRound"
                ],
                "properties": {
                  "skill": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "maxRounds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "pointsToWin": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "roundSeconds": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 30
                  },
                  "responseSeconds": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 30
                  },
                  "sourceModifier": {
                    "type": "integer",
                    "minimum": -10,
                    "maximum": 10
                  },
                  "targetModifier": {
                    "type": "integer",
                    "minimum": -10,
                    "maximum": 10
                  },
                  "scoring": {
                    "enum": [
                      "success-margin",
                      "margin"
                    ]
                  },
                  "sourceEnergyPerRound": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10
                  },
                  "targetEnergyPerRound": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10
                  }
                }
              }
            ]
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "definitionId",
          "priority",
          "intervalSeconds",
          "chancePercent",
          "source",
          "target",
          "maximumDistance",
          "minimumAffinity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "definitionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "intervalSeconds": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 3600
          },
          "chancePercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "source": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "operator",
                "value"
              ],
              "properties": {
                "metric": {
                  "enum": [
                    "energy",
                    "food",
                    "water",
                    "joy",
                    "anger",
                    "social",
                    "bond",
                    "personality",
                    "trait",
                    "idle"
                  ]
                },
                "operator": {
                  "enum": [
                    "gte",
                    "lte",
                    "eq",
                    "contains"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            }
          },
          "target": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "operator",
                "value"
              ],
              "properties": {
                "metric": {
                  "enum": [
                    "energy",
                    "food",
                    "water",
                    "joy",
                    "anger",
                    "social",
                    "bond",
                    "personality",
                    "trait",
                    "idle"
                  ]
                },
                "operator": {
                  "enum": [
                    "gte",
                    "lte",
                    "eq",
                    "contains"
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            }
          },
          "maximumDistance": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minimumAffinity": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
