{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Littlewild Creature Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "name",
    "description",
    "defaultPersonality",
    "personalities",
    "names",
    "movement",
    "rng",
    "state",
    "ecs"
  ],
  "properties": {
    "format": {
      "const": "littlewild-creature"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,60}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "defaultPersonality": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,60}$"
    },
    "personalities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,60}$"
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseSpeed",
        "bondThreshold",
        "bondedSpeedBonus"
      ],
      "properties": {
        "baseSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        },
        "bondThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "bondedSpeedBonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "stride"
      ],
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stride": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personalFields",
        "defaults",
        "modes"
      ],
      "properties": {
        "personalFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,60}$"
          }
        },
        "defaults": {
          "type": "object"
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "founder",
            "arrival"
          ],
          "properties": {
            "founder": {
              "type": "object"
            },
            "arrival": {
              "type": "object"
            }
          }
        }
      }
    },
    "ecs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "field"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]{0,60}$"
              },
              "field": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,60}$"
              }
            }
          }
        }
      }
    }
  }
}
