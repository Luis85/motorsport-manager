// Historical regression adapted explicitly for v10 research, beds, physical stalls and door routing.
const V10=require('./test-v10-fixtures.cjs');
'use strict';
const assert=require('node:assert/strict'),fs=require('node:fs');
const L=require('./simulation.cjs'),W=require('./world-content.js'),S=require('./story-codec.js');
const Store=require('./story-storage.js'),Clock=require('./simulation-clock.js'),R=require('./rpg.js');
const results=[];function test(name,fn){try{fn();results.push({name,passed:true});}catch(e){results.push({name,passed:false,error:e.stack});console.error('FAIL',name,e.message.slice(0,300));}}
const snap=e=>JSON.stringify(e.export()),clone=W.clone;
function fixture(){const e=L.createWorldDemo();e.s.paused=false;e.s.started=true;e.selectCreature('c1');return e;}
function storage(){const memory=new Map(),writes=[];let denied=false,quota=false;const adapter={getItem(k){if(denied)throw Error('denied');return memory.get(k)??null;},setItem(k,v){if(denied||quota)throw Error('quota');writes.push(k);memory.set(k,v);}};const store=new Store(()=>adapter,S.inspect,{primary:'story',backup:'backup',legacy:['old'],oldBackups:['old-backup']});return {store,memory,writes,deny:v=>denied=v,quota:v=>quota=v};}

test('Empty storage produces no fabricated progress',()=>{const x=storage();assert.equal(x.store.load().value,null);assert.equal(x.writes.length,0);});
test('Primary story is validated without modifying its bytes',()=>{const x=storage(),save=JSON.stringify(S.encode(fixture()));x.memory.set('story',save);assert(x.store.load().value);assert.equal(x.memory.get('story'),save);assert.equal(x.writes.length,0);});
test('Legacy fallback occurs only when no primary story exists',()=>{const x=storage();x.memory.set('old',JSON.stringify(S.encode(fixture())));assert.equal(x.store.load().key,'old');x.memory.set('story','bad');assert.equal(x.store.load().error,'corrupt');});
test('Unreadable primary is quarantined until explicit replacement',()=>{const x=storage();x.memory.set('story','broken');assert.equal(x.store.load().error,'corrupt');assert.throws(()=>x.store.write(S.encode(fixture())));assert.equal(x.memory.get('story'),'broken');x.store.allowReplacement();x.store.write(S.encode(fixture()));assert(x.store.load().value);});
test('Recovery inspection does not auto-restore or overwrite primary',()=>{const x=storage();x.memory.set('story','broken');x.memory.set('backup',JSON.stringify(S.encode(fixture())));const before=[...x.memory];assert(x.store.recovery());assert.deepEqual([...x.memory],before);});
test('Denied storage leaves the game’s portable state usable',()=>{const x=storage();x.deny(true);assert.equal(x.store.load().error,'unavailable');const save=S.encode(fixture());assert.throws(()=>x.store.write(save));assert.doesNotThrow(()=>S.inspect(save));});
test('Quota failure retains a prior valid primary and can be retried',()=>{const x=storage(),e=fixture();x.store.write(S.encode(e));const before=x.memory.get('story');e.s.player.coins++;x.quota(true);assert.throws(()=>x.store.write(S.encode(e)));assert.equal(x.memory.get('story'),before);x.quota(false);assert(x.store.write(S.encode(e)));assert.notEqual(x.memory.get('story'),before);});
test('Unchanged snapshots do not write repeatedly just for timestamps',()=>{const x=storage(),save=S.encode(fixture());assert(x.store.write(save));save.savedAt='2030-01-01T00:00:00Z';assert.equal(x.store.write(save),false);assert.equal(x.writes.length,1);});
test('Invalid live snapshot never replaces last-known-good state',()=>{const x=storage(),save=S.encode(fixture());x.store.write(save);const before=x.memory.get('story');save.state.colony.creatures[0].inventory.wood=-1;assert.throws(()=>x.store.write(save));assert.equal(x.memory.get('story'),before);});
test('Unavailable backup is reported as unsuccessful',()=>{const x=storage();x.quota(true);assert.equal(x.store.backup(S.encode(fixture())),false);assert.equal(x.memory.size,0);});
test('Invalid backup cannot destroy the recovery copy',()=>{const x=storage(),save=S.encode(fixture());assert(x.store.backup(save));const before=x.memory.get('backup');save.state.nextId=1;assert.equal(x.store.backup(save),false);assert.equal(x.memory.get('backup'),before);});
test('Fresh unstarted story is persistable without resurrecting a legacy story',()=>{const x=storage();x.memory.set('old',JSON.stringify(S.encode(fixture())));x.store.allowReplacement();x.store.write(S.encode(new L.Engine()),true);assert.equal(x.store.load().key,'story');assert.equal(S.commit(x.store.load().value).s.started,false);});

test('Fixed clock frames with equivalent elapsed time produce equal exact state',()=>{const a=fixture(),b=S.commit(S.inspect(S.encode(a))),ca=new Clock(),cb=new Clock();for(let i=0;i<600;i++)ca.advance(.05,2,x=>a.step(x));for(let i=0;i<300;i++)cb.advance(.1,2,x=>b.step(x));assert.equal(snap(a),snap(b));});
test('Headless advance uses the same 100ms stepping as the player clock',()=>{const a=fixture(),b=S.commit(S.inspect(S.encode(a)));a.advance(60);for(let i=0;i<600;i++)b.step(.1);assert.equal(snap(a),snap(b));});
test('Changing speed changes pacing, not the same tick-count outcome',()=>{const expected=fixture();for(let i=0;i<400;i++)expected.step(.1);for(const speed of [1,2,4]){const e=fixture(),clock=new Clock();for(let i=0;i<400/speed;i++)clock.advance(.1,speed,x=>e.step(x));assert.equal(snap(e),snap(expected));}});
test('Paused simulation cannot spend needs, currency, or randomness',()=>{const e=fixture();e.s.paused=true;const before=snap(e);e.advance(200);assert.equal(snap(e),before);});
test('Clock callback failure discards display debt rather than replaying settled ticks',()=>{const c=new Clock();let calls=0;assert.throws(()=>c.advance(.1,4,()=>{calls++;if(calls===2)throw Error('fault');}));assert.equal(c.pending,0);c.advance(0,1,()=>calls++);assert.equal(calls,2);});
test('Tiny custom clock steps cannot accumulate unbounded catch-up debt',()=>{const c=new Clock(.0001);for(let i=0;i<1000;i++)c.advance(.1,16,()=>{});assert(c.pending<c.step);});
test('Suspension does not fast-forward an offline world',()=>{const c=new Clock();let count=0;c.advance(3600,1,()=>count++);assert.equal(count,1);});
for(const value of [Infinity,NaN,-1,'5',3601])test('Invalid headless advance '+String(value)+' is inert',()=>{const e=fixture(),before=snap(e);e.advance(value);assert.equal(snap(e),before);});

const original=new Function('return ({'+fs.readFileSync(__dirname+'/fixtures/original-find-path.txt','utf8').replace('if (this.walkable(target.x + dx, target.y + dy))','if ((adjacent || !this.walkable(target.x, target.y)) && this.walkable(target.x + dx, target.y + dy))')+'}).findPath')();
let routeCases=0;
for(const scenario of ['fresh','community'])test('Cached BFS matches independent BFS with exact-goal/doorway rules in '+scenario,()=>{const e=scenario==='fresh'?new L.Engine():fixture();const targets=[...e.s.nodes,...e.s.buildings,{x:0,y:0},{x:9,y:9}];for(let y=1;y<18;y+=3)for(let x=1;x<18;x+=3){if(!e.walkable(x,y))continue;e.actor.creature.x=x;e.actor.creature.y=y;for(const t of targets)for(const adjacent of [false,true]){const b=e.s.buildings.find(b=>b.x===t.x&&b.y===t.y);const door=e.isIndoor(b)&&b.door;assert.deepEqual(e.findPath(t,adjacent),original.call(e,door?e.doorway(b):t,door?false:adjacent));routeCases++;}}});
test('Route cache size is bounded for one topology',()=>{const e=fixture();for(let y=1;y<18;y++)for(let x=1;x<18;x++)e.findPath({x,y});assert(LWNavigation.grid(e.s).routes.size<=192);});

test('All 216 dice outcomes agree with cached probabilities for each target 0–24',()=>{for(let target=0;target<=24;target++){let successes=0,critical=0;for(let a=1;a<=6;a++)for(let b=1;b<=6;b++)for(let c=1;c<=6;c++){const r=R.resolve(target,[a,b,c]);successes+=r.success?1:0;critical+=r.success&&r.critical?1:0;}assert.equal(R.odds(target).success,successes/216);assert.equal(R.odds(target).critical,critical/216);}});
test('Increasing a permitted roll target never lowers the exact success probability',()=>{let previous=0;for(let target=0;target<=30;target++){const value=R.odds(target).success;assert(value>=previous);previous=value;}assert.equal(previous,212/216);});
test('Encumbrance only changes at the defined boundaries and includes carried weight once',()=>{for(const st of [5,10,15,20]){const lift=st*st/5*.45359237*1000;for(const [threshold,level] of [[1,0],[2,1],[3,2],[6,3],[10,4]]){assert.equal(R.encumbrance(st,lift*threshold-.0001).level,level);assert(!R.encumbrance(st,lift*10).overloaded);}assert(R.encumbrance(st,lift*10+.1).overloaded);}});
test('Queries and content validation never consume gameplay randomness',()=>{const e=fixture(),before=snap(e);for(let i=0;i<30;i++){for(const b of e.s.buildings)e.buildingStatus(b);for(const id of Object.keys(L.RES))e.assessResource(id,12);W.validate(W.content);e.load();e.questForecast(LWAdventure.content.quests[0],e.actor);}assert.equal(snap(e),before);});
const report={suite:'Littlewild v9 foundations and persistence',passed:results.filter(x=>x.passed).length,failed:results.filter(x=>!x.passed).length,results,routeCases};fs.writeFileSync(__dirname+'/v10-regression-v9-foundation-results.json',JSON.stringify(report,null,2));console.log(`${report.passed}/${results.length} foundation checks passed; ${routeCases} exact path comparisons`);process.exitCode=report.failed?1:0;
