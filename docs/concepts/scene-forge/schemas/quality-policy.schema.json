{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "quality-policy"
    },
    "maxTriangles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxMeshes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxMaterials": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxGeometries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxExtent": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "allowTransparency": {
      "default": true,
      "type": "boolean"
    },
    "allowDoubleSided": {
      "default": true,
      "type": "boolean"
    },
    "requireUVs": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "kind"
  ],
  "additionalProperties": false
}
