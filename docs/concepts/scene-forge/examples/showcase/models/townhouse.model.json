{
  "schemaVersion": 1,
  "kind": "model",
  "id": "townhouse",
  "category": "Architecture",
  "name": "Modular townhouse",
  "parameters": {
    "width": {
      "default": 4.8,
      "min": 3.2,
      "max": 8,
      "description": "Facade width in meters"
    },
    "depth": {
      "default": 3.5,
      "min": 2,
      "max": 6,
      "description": "Building depth"
    },
    "floors": {
      "default": 3,
      "min": 2,
      "max": 5,
      "description": "Number of floors",
      "integer": true
    },
    "bays": {
      "default": 3,
      "min": 2,
      "max": 5,
      "description": "Window columns",
      "integer": true
    }
  },
  "geometries": {
    "body": {
      "type": "box",
      "size": [
        {
          "$param": "width"
        },
        {
          "$expr": "mul",
          "args": [
            {
              "$param": "floors"
            },
            2.6
          ]
        },
        {
          "$param": "depth"
        }
      ]
    },
    "cornice": {
      "type": "box",
      "size": [
        {
          "$expr": "add",
          "args": [
            {
              "$param": "width"
            },
            0.2
          ]
        },
        0.13,
        {
          "$expr": "add",
          "args": [
            {
              "$param": "depth"
            },
            0.14
          ]
        }
      ]
    },
    "roof": {
      "type": "extrude",
      "points": [
        [
          {
            "$expr": "mul",
            "args": [
              {
                "$param": "width"
              },
              -0.5
            ]
          },
          0
        ],
        [
          {
            "$expr": "mul",
            "args": [
              {
                "$param": "width"
              },
              0.5
            ]
          },
          0
        ],
        [
          0,
          {
            "$expr": "mul",
            "args": [
              {
                "$param": "width"
              },
              0.32
            ]
          }
        ]
      ],
      "depth": {
        "$expr": "add",
        "args": [
          {
            "$param": "depth"
          },
          0.5
        ]
      }
    },
    "door": {
      "type": "box",
      "size": [
        0.95,
        2.05,
        0.13
      ]
    },
    "doorFrame": {
      "type": "box",
      "size": [
        1.2,
        2.25,
        0.1
      ]
    },
    "step": {
      "type": "box",
      "size": [
        1.65,
        0.14,
        0.65
      ]
    },
    "canopy": {
      "type": "box",
      "size": [
        {
          "$expr": "mul",
          "args": [
            {
              "$param": "width"
            },
            0.76
          ]
        },
        0.12,
        1
      ]
    },
    "shopSign": {
      "type": "box",
      "size": [
        {
          "$expr": "mul",
          "args": [
            {
              "$param": "width"
            },
            0.76
          ]
        },
        0.35,
        0.1
      ]
    },
    "chimney": {
      "type": "box",
      "size": [
        0.42,
        1.3,
        0.45
      ]
    }
  },
  "materials": {
    "wall": {
      "color": "#c88569",
      "metalness": 0,
      "roughness": 0.55,
      "opacity": 1,
      "doubleSided": false,
      "flatShading": false
