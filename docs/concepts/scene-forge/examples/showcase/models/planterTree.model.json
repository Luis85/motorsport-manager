      "metalness": 0,
      "roughness": 0.55,
      "opacity": 1,
      "doubleSided": false,
      "flatShading": false
    },
    "wood": {
      "color": "#735444",
      "metalness": 0,
      "roughness": 0.55,
      "opacity": 1,
      "doubleSided": false,
      "flatShading": false
    },
    "leaf": {
      "color": "#628260",
      "metalness": 0,
      "roughness": 0.55,
      "opacity": 1,
      "doubleSided": false,
      "flatShading": true
