              0.72
            ]
          },
          0
        ],
        "scale": [
          1,
          1.05,
          1
        ]
      },
      "visible": true,
      "tags": [],
      "type": "mesh",
      "geometry": "crown",
      "material": "leaf"
    },
    {
      "id": "crownTop",
