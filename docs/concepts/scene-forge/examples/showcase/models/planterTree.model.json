      "transform": {
        "position": [
          0,
          0.51,
          0
        ]
      },
      "visible": true,
      "tags": [],
      "type": "mesh",
      "geometry": "soil",
      "material": "earth"
    },
    {
      "id": "trunk",
      "transform": {
        "position": [
          0,
          {
            "$expr": "add",
            "args": [
              0.5,
              {
                "$expr": "mul",
                "args": [
                  {
