{
  "schemaVersion": 1,
  "kind": "model",
  "id": "planterTree",
  "category": "Architecture",
  "name": "Planter tree",
  "parameters": {
    "height": {
      "default": 3.4,
      "min": 2,
      "max": 5,
      "description": "Overall height"
    },
    "crown": {
      "default": 1.1,
      "min": 0.6,
      "max": 1.8,
      "description": "Crown radius"
    }
  },
  "geometries": {
