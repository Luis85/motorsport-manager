    {
      "id": "regression-suite",
      "name": "Automated regression suite",
      "kind": "system",
      "phase": "Accept",
      "scene": {
        "id": "scene-regression-suite",
        "position": [
          56,
          60
        ],
        "color": "#77b5a0"
      },
