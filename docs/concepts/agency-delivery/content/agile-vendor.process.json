      "from": "plan-split",
      "to": "architecture"
    },
    {
      "id": "product-design-backlog-ready",
      "from": "product-design",
      "to": "backlog-ready"
    },
    {
      "id": "architecture-backlog-ready",
      "from": "architecture",
      "to": "backlog-ready"
    },
    {
      "id": "backlog-ready-roadmap",
      "from": "backlog-ready",
      "to": "roadmap"
    },
    {
      "id": "roadmap-sprint-planning",
      "from": "roadmap",
      "to": "sprint-planning"
    },
    {
      "id": "sprint-planning-sprint",
      "from": "sprint-planning",
      "to": "sprint"
    },
    {
      "id": "sprint-ci-build",
      "from": "sprint",
      "to": "ci-build"
