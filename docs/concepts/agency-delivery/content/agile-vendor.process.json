      "duration": 4,
      "resources": {
        "customer-pm": 1,
        "customer-po": 1,
        "delivery-manager": 1
      },
      "set": {
        "roadmapAgreed": true,
        "release": 0,
        "iteration": 0,
        "increments": 0
