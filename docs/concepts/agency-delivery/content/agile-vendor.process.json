    },
    {
      "id": "plan-split",
      "name": "Plan together",
      "kind": "fork",
      "phase": "Plan",
      "scene": {
        "id": "scene-plan-split",
        "position": [
          56,
          0
        ],
        "color": "#91b9d5"
      },
      "description": "Product design and the architecture runway run in parallel. Both feed the product backlog.",
      "join": "backlog-ready"
    },
    {
      "id": "product-design",
      "name": "Product design",
      "kind": "task",
      "phase": "Plan",
      "scene": {
        "id": "scene-product-design",
        "position": [
          70,
          -8
        ],
        "color": "#ffbb73"
      },
      "description": "UX designers work with the customer product owner and an expert on journeys, prototypes and acceptance ideas.",
      "duration": 12,
      "resources": {
        "ux": 1,
        "customer-po": 1,
        "customer-sme": 1
      },
      "set": {
        "designReady": true
      },
      "needs": [
        {
          "field": "discoveryDone",
          "op": "eq",
          "value": true,
          "label": "Discovery outcome"
        }
