      "id": "uat-result",
      "name": "UAT result",
      "kind": "decision",
      "phase": "Accept",
      "scene": {
        "id": "scene-uat-result",
        "position": [
          28,
          60
        ],
        "color": "#91b9d5"
      },
      "description": "Findings send the release to one fix and retest; otherwise it can go live."
    },
    {
      "id": "fix",
      "name": "Fix acceptance findings",
      "kind": "task",
      "phase": "Accept",
