      "id": "release-uat",
      "name": "Release acceptance testing (UAT)",
      "kind": "task",
      "phase": "Accept",
      "scene": {
        "id": "scene-release-uat",
        "position": [
          42,
          60
        ],
        "color": "#ffbb73"
      },
      "description": "Customer experts and QA test the release scope.",
      "duration": 6,
      "resources": {
        "customer-sme": 1,
        "qa": 1
