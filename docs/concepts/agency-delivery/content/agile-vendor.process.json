{
  "format": "wildlands-process",
  "schemaVersion": 1,
  "revision": 0,
  "id": "agile-vendor-project",
  "name": "Agile vendor project",
  "description": "We are the vendor running an agile software project for a customer whose project manager, product owner and subject-matter experts join in milestones, releases and iterations. After a contractual kickoff date and a roadmap, each project loops through releases; every release repeats iterations that each deliver a product increment, then acceptance testing with a bounded fix loop, then go-live. UX designers work in product design and in every iteration. Counters (iteration, increments, release) drive the loops; timers model the kickoff date, the customer review window and hypercare. CI/CD runs as automated system steps after every iteration and on release deployment, and a regression suite runs before acceptance testing. All values are synthetic: one simulated minute stands in for a fraction of a working day, an iteration is 10 simulated minutes, and this is an illustrative model, not a forecast.",
  "start": "intake",
  "sipoc": {
    "suppliers": [
      {
        "name": "Customer product owner",
        "supplies": "Prioritised backlog and day-to-day decisions"
      },
      {
        "name": "Customer subject-matter experts",
        "supplies": "Domain knowledge and answers to open questions"
      },
      {
        "name": "Customer project manager",
        "supplies": "Milestone approvals and release sign-off"
      },
      {
        "name": "Platform vendors",
        "supplies": "CI/CD tooling, environments and hosting"
      }
    ],
    "customers": [
      {
        "name": "Customer business",
        "receives": "Working software increments and release notes"
      },
      {
        "name": "End users",
        "receives": "New features in production"
      }
    ]
  },
