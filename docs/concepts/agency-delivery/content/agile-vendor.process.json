        ],
        "color": "#77b5a0"
      },
      "description": "The tech lead and a developer prepare the architecture and the delivery pipeline.",
      "duration": 10,
      "resources": {
        "architect": 1,
        "developer": 1
      },
      "set": {
        "runwayReady": true
      },
      "needs": [
        {
          "field": "discoveryDone",
          "op": "eq",
          "value": true,
          "label": "Discovery outcome"
        }
      ]
    },
    {
      "id": "backlog-ready",
      "name": "Product backlog ready",
