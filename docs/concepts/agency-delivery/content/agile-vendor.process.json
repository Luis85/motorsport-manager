        "color": "#77b5a0"
      },
      "description": "Developers and QA correct the findings, then clear the findings flag before retest.",
      "duration": 4,
      "resources": {
        "developer": 2,
        "qa": 1
      },
      "set": {
        "findings": false
      }
    },
    {
      "id": "release-go-live",
      "name": "Milestone \u00b7 Release go-live",
