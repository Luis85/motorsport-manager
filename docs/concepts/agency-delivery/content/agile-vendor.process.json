      },
      "set": {
        "releaseDeployed": true
      },
      "outputs": [
        {
          "field": "releaseDeployed",
          "label": "Release deployed"
        }
      ]
    },
    {
      "id": "hypercare",
      "name": "Hypercare window",
      "kind": "timer",
      "phase": "Release",
      "scene": {
        "id": "scene-hypercare",
        "position": [
          -14,
          60
        ],
        "color": "#91b9d5"
      },
      "description": "Three minutes of observation after go-live; no team is occupied.",
      "duration": 3
