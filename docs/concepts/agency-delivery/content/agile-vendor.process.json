    {
      "id": "regression-suite-release-uat",
      "from": "regression-suite",
      "to": "release-uat"
    },
    {
      "id": "release-uat-uat-result",
      "from": "release-uat",
      "to": "uat-result"
    },
    {
      "id": "uat-result-fix",
      "from": "uat-result",
      "to": "fix",
