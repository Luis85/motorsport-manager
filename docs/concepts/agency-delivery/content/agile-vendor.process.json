    },
    {
      "id": "ux",
      "name": "UX designers",
      "capacity": 1,
      "costPerMinute": 2
    },
    {
      "id": "architect",
      "name": "Tech lead / architect",
      "capacity": 1,
      "costPerMinute": 3
    },
    {
      "id": "developer",
      "name": "Developers",
      "capacity": 3,
      "costPerMinute": 3
    },
    {
      "id": "qa",
      "name": "QA engineers",
      "capacity": 1,
      "costPerMinute": 2
    },
    {
      "id": "ci-pipeline",
      "name": "CI/CD pipeline runners",
      "kind": "system",
      "capacity": 2,
      "costPerMinute": 1
    },
    {
      "id": "test-automation",
      "name": "Automated test grid",
      "kind": "system",
      "capacity": 2,
      "costPerMinute": 1
    }
  ],
  "steps": [
    {
      "id": "intake",
      "name": "Engagement won",
      "kind": "start",
      "phase": "Initiate",
      "scene": {
        "id": "scene-intake",
        "position": [
          0,
          0
        ],
        "color": "#77b5a0"
      },
      "description": "The customer signs and a new agile software project enters the vendor delivery process."
    },
    {
      "id": "kickoff-date",
      "name": "Contractual kickoff date (not before)",
      "kind": "timer",
      "phase": "Initiate",
      "scene": {
        "id": "scene-kickoff-date",
        "position": [
          14,
          0
        ],
        "color": "#91b9d5"
      },
      "description": "The contract fixes the earliest kickoff at business minute 12. A case that arrives earlier waits here without using any team; a later case passes at once.",
      "until": 12
    },
    {
      "id": "kickoff",
      "name": "Milestone 1 \u00b7 Kickoff",
      "kind": "task",
      "phase": "Initiate",
      "scene": {
        "id": "scene-kickoff",
        "position": [
          28,
          0
        ],
        "color": "#e8c547"
      },
      "description": "Customer project manager and our delivery manager agree governance, cadence and working agreements.",
      "duration": 3,
      "resources": {
        "customer-pm": 1,
        "delivery-manager": 1
      },
      "set": {
        "kickoffDone": true
      }
    },
    {
      "id": "discovery",
      "name": "Discovery with the customer",
      "kind": "task",
      "phase": "Initiate",
      "scene": {
        "id": "scene-discovery",
        "position": [
          42,
          0
        ],
        "color": "#ffbb73"
      },
      "description": "The customer product owner and two subject-matter experts explain the domain, users and goals.",
      "duration": 8,
      "resources": {
        "customer-po": 1,
        "customer-sme": 2,
        "delivery-manager": 1
      },
      "set": {
        "discoveryDone": true
      },
      "needs": [
        {
          "field": "kickoffDone",
          "op": "eq",
          "value": true,
          "label": "Kickoff milestone"
