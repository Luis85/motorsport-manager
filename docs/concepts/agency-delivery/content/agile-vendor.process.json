      "phase": "Plan",
      "scene": {
        "id": "scene-backlog-ready",
        "position": [
          84,
          0
        ],
        "color": "#91b9d5"
      },
      "description": "Design and runway merge into a ready product backlog.",
      "needs": [
        {
          "field": "designReady",
          "op": "eq",
          "value": true,
          "label": "Product design deliverable"
        },
        {
          "field": "runwayReady",
          "op": "eq",
          "value": true,
          "label": "Architecture runway"
        }
      ],
      "backlog": {
        "capacity": 3,
        "order": "fifo"
      }
    },
    {
      "id": "roadmap",
      "name": "Milestone 2 \u00b7 Roadmap agreed",
      "kind": "task",
      "phase": "Plan",
      "scene": {
        "id": "scene-roadmap",
        "position": [
          98,
          0
        ],
        "color": "#e8c547"
      },
