  "arrivals": [
    {
      "at": 0,
      "count": 1,
      "interval": 0,
      "data": {
        "iterations": 3,
        "releases": 2,
        "findings": true,
        "iteration": 0,
        "release": 0
      }
    },
    {
      "at": 15,
      "count": 1,
      "interval": 0,
      "data": {
        "iterations": 2,
        "releases": 1,
        "findings": false,
        "iteration": 0,
        "release": 0
      }
    },
    {
      "at": 30,
      "count": 1,
      "interval": 0,
      "data": {
        "iterations": 1,
        "releases": 3,
        "findings": true,
        "iteration": 0,
        "release": 0
      }
    }
  ]
}
