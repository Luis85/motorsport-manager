      "phase": "Iterate",
      "scene": {
        "id": "scene-retrospective",
        "position": [
          56,
          28
        ],
        "color": "#77b5a0"
      },
      "description": "The delivery manager and a developer agree improvements before the next iteration decision.",
      "duration": 2,
      "resources": {
        "delivery-manager": 1,
        "developer": 1
      }
    },
    {
      "id": "more-iterations",
