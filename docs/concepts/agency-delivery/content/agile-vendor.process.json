    },
    {
      "id": "sprint-planning",
      "name": "Iteration planning",
      "kind": "task",
      "phase": "Iterate",
      "scene": {
        "id": "scene-sprint-planning",
        "position": [
          112,
          28
        ],
        "color": "#ffbb73"
      },
      "description": "The delivery manager and the customer product owner choose the iteration goal from the backlog.",
      "duration": 2,
      "resources": {
        "delivery-manager": 1,
        "customer-po": 1
      },
      "needs": [
        {
          "field": "roadmapAgreed",
          "label": "Agreed roadmap"
        }
      ]
    },
    {
      "id": "sprint",
      "name": "Iteration",
      "kind": "task",
      "phase": "Iterate",
      "scene": {
        "id": "scene-sprint",
        "position": [
          98,
          28
        ],
        "color": "#ffbb73"
      },
      "description": "One iteration (10 simulated minutes). Counters: iteration (within the current release) and increments (accumulated across the whole project) each go up by one.",
      "duration": 10,
      "resources": {
        "delivery-manager": 1,
        "customer-po": 1,
        "ux": 1,
        "developer": 2,
        "qa": 1
      },
      "set": {
        "increment": "delivered"
