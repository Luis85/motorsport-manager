{
  "version": 1,
  "classifications": {
    "contract": "Version/type/compatibility rules; changing these changes accepted data or reader semantics.",
    "identity": "Stable IDs used for reference, provenance and continuation.",
    "presentation": "Human-facing inert labels/copy/colors with no sporting authority.",
    "reference": "References resolved and type-checked before activation.",
    "authoring": "Authoring inputs that become ordinary validated domain data before runtime.",
    "sporting": "Rules, allocations or session/competition policy that can change legal race behavior.",
    "simulation": "Numeric/model inputs consumed by the authoritative simulation or geometry.",
    "safety": "Bounds/clamps whose primary role is keeping runtime state inside validated operating limits."
  },
