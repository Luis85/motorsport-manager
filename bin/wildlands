          if (!Array.isArray(input2) || Object.getPrototypeOf(input2) !== Array.prototype || input2.length < 1 || input2.length > 2 || Object.getOwnPropertySymbols(input2).length)
            throw Error("Renderer dimensions must be a plain bounded array.");
