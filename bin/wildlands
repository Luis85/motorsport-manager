          if (!base.ok)
            throw Error(base.errors.map((e) => e.path + ": " + e.message).join("\n"));
          stage("resources", () => {
            if (pack.resources)
              resources.validate(pack.resources);
            resources.checkBindings(pack.resources, pack.libraries);
          });
