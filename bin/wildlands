        const state = engine.s.terraform || S.empty();
        return S.copy({ revision: state.revision, tiles: state.tiles, plants: state.plants, choices: S.choices() });
      }
      root.LWTerraformRuntime = Object.freeze({ preview, apply, snapshot, routeIssue });
      if (typeof module2 !== "undefined" && module2.exports)
        module2.exports = root.LWTerraformRuntime;
    })(globalThis);
  }
