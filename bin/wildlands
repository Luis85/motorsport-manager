              return fail(issue);
            const order = this.s.orders.find((o) => o.id === id);
            if (!order)
              return fail("That plan is no longer available.");
            if (value !== void 0 && typeof value !== "boolean")
              return fail("Choose paused or running.");
            order.paused = value === void 0 ? !order.paused : value;
