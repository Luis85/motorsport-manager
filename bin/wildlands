          const playerNext = player.skillTrees && typeof spec.playerXp === "number" && Number.isSafeInteger(spec.playerXp) && spec.playerXp > 0 && spec.playerXp <= 1e9 ? rules.award(player.skillTrees, spec.playerXp) : void 0;
