            return Array.isArray(value) && value.includes(String(rule.value));
          if (rule.operator === "eq")
            return value === rule.value;
          return typeof value === "number" && typeof rule.value === "number" && (rule.operator === "gte" ? value >= rule.value : value <= rule.value);
        });
      }
      function candidates(e, definition, rule, actorId) {
        const out = [];
