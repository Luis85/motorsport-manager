            throw Error(path + "/player/coins: expected a non-negative integer");
        } else
          throw Error(path + "/player: expected an object");
      }
      const ACCEPTED_ENTRIES = 8, ACCEPTED_TEXT = 32 * 1024 * 1024, accepted = /* @__PURE__ */ new Map();
      let acceptedText = 0;
      function extensionCatalogs() {
        const renderers = node ? require_renderer_catalog() : root.LWRendererCatalog;
        return C.stable({ renderers: renderers?.list() ?? null, animations: root.LWAnimationCatalog?.list() ?? null });
      }
      function remember(entry) {
        if (entry.key.length > ACCEPTED_TEXT)
          return;
        accepted.set(entry.key, entry);
        acceptedText += entry.key.length;
        for (const [key, old] of accepted) {
          if (accepted.size <= ACCEPTED_ENTRIES && acceptedText <= ACCEPTED_TEXT)
            break;
          accepted.delete(key);
          acceptedText -= old.key.length;
        }
      }
      function validate(input) {
        try {
          const parsed = stage("pack parse", () => C.parse(input, 8 * 1024 * 1024));
          const key = extensionCatalogs() + "\n" + JSON.stringify(parsed), hit = accepted.get(key);
          if (hit) {
            accepted.delete(key);
            accepted.set(key, hit);
            return { ok: true, errors: [], pack: copy(hit.pack), fingerprint: hit.fingerprint, sceneCount: hit.sceneCount };
          }
          const checked = validateParsed(parsed);
          if (checked.ok)
            remember({ key, pack: copy(checked.pack), fingerprint: checked.fingerprint, sceneCount: checked.sceneCount });
          return checked;
        } catch (error) {
          const issues = issueMessages(error);
          return { ok: false, errors: issues?.length ? issues : [message(error)] };
        }
      }
      function validateParsed(parsed) {
        try {
          if (!isRecord(parsed) || parsed.schemaVersion !== 2)
            return { ok: false, errors: ["/schemaVersion: only current scenario schema version 2 is supported"] };
          const errors = [];
          if (!packShape(parsed, errors))
            return { ok: false, errors };
