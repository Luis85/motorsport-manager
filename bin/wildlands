          world: land.content,
          growth: growth.content,
          fingerprint: content.fingerprint,
          changesLibrary: C.registry.hash !== content.fingerprint || A.hash !== A.hashOf(expansion.content) || W.hash !== W.hashOf(land.content) || G.hash !== G.hashOf(growth.content)
