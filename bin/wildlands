        return false;
      }
      function step(e, dt) {
        const s = state(e), actor = e.actor, t = actor.task, location = s.locations[actor.id];
        for (const id of Object.keys(s.jobs))
          if (!e.s.buildings.some((b2) => b2.storage?.job?.id === id))
