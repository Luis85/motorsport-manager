        const origin = { x: surface.x + surface.width / 2 - (box.x - box.y + (box.width - box.height) / 2) * unit / 2, y: surface.y + surface.height / 2 - (box.x + box.y + (box.width + box.height - 2) / 2) * unit / 4 + (embedded ? 8 : 25) };
