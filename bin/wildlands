          };
          if (duel.pointsToWin > duel.maxRounds)
            throw Error("Winning score exceeds round limit.");
          if (sources.length !== 1 || sources[0] !== "creature" || targets.length !== 1 || targets[0] !== "creature" || !d.requireIdle)
