            if (!q)
              return false;
            const success = !q.aborted && q.successes >= q.required, result = super.returnQuest();
            if (result && success) {
              const amount = this.actor.questHistory[0]?.prestigeReward || 0;
              this.emit("celebrate", "+" + amount + " prestige \xB7 A successful adventure.");
              this.grantInteractionEvent("quest-success", this.actor.id);
            }
            return result;
          }
          slotQuote() {
            const r = C.content.rules, n = this.s.progression.slots;
            return { number: n + 1, prestige: Math.ceil(r.slotPrestigeBase * Math.pow(r.slotGrowth, n - r.initialSlots)), level: r.slotLevelBase + Math.max(0, n - r.initialSlots) * r.slotLevelStep, max: r.maxSlots };
          }
          unlockSlot() {
            const q = this.slotQuote(), p = this.s.progression;
            const issue = this.gateIssue("features", "recruitment");
            if (issue)
              return fail(issue);
            if (p.slots >= q.max)
              return fail("All configured companion slots are unlocked.");
            if (this.s.player.level < q.level)
              return fail("Guide level " + q.level + " required.");
            if (p.prestige < q.prestige)
              return fail("Need " + q.prestige + " prestige earned from successful quests.");
            const settlement = this.settleEconomy({ id: this.economySettlementId("slot-unlock", String(q.number)), prestige: -q.prestige });
            if (!settlement.ok)
              return fail("The prestige cost could not be settled.");
            p.slots++;
            this.emit("celebrate", "Companion slot " + p.slots + " unlocked.");
            return ok();
          }
          homeCapacity(b) {
            const d = C.content.homes[b.kind];
            return d ? d.places + (b.level - 1) * d.perLevel : 0;
          }
          residents(id) {
            return this.creatures.filter((c) => c.homeId === id);
          }
          home(c = this.actor) {
            return this.s.buildings.find((b) => b.id === c.homeId) || null;
          }
          freeHome(c = null) {
            return this.s.buildings.find((b) => this.homeCapacity(b) > this.residents(b.id).length && (!c || this.withActor(c, () => this.findPath(b, true) !== null)));
          }
          assignUnhoused(events = true) {
            for (const c of this.creatures)
              if (!this.home(c)) {
                const b = this.freeHome(c);
                if (b) {
                  c.homeId = b.id;
                  if (events)
                    this.grantInteractionEvent("home-assigned", c.id);
                }
              }
          }
          assignHome(actorId, buildingId) {
            const c = this.creatures.find((c2) => c2.id === actorId), b = this.s.buildings.find((b2) => b2.id === buildingId);
            if (!c || !b || !this.homeCapacity(b))
              return fail("Choose a creature and a completed home.");
            if (c.activeQuest)
              return fail("Wait until this creature returns.");
            if (c.homeId === b.id)
              return ok();
            if (this.residents(b.id).length >= this.homeCapacity(b))
              return fail("Every place in this home is assigned.");
            if (!this.withActor(c, () => this.findPath(b, true)))
              return fail("This home needs a reachable doorway.");
            c.homeId = b.id;
            if (c.task?.kind === "rest")
              this.interruptActor(c);
            this.grantInteractionEvent("home-assigned", c.id);
            this.emit("notice", c.name + " has a place in " + L.BUILDINGS[b.kind].name + ".", { actorId: c.id });
            return ok();
          }
          purchaseCreature(personality, archetype) {
            if (!this.s.progression)
              return super.purchaseCreature(personality, archetype);
            const issue = this.gateIssue("features", "recruitment");
            if (issue)
              return fail(issue);
            if (this.creatures.length >= this.s.progression.slots)
              return fail("Unlock the next companion slot with prestige first.");
            const home = this.freeHome();
            if (!home)
              return fail("Build or improve a home with an unassigned place first.");
            const r = super.purchaseCreature(personality, archetype);
            if (r.ok) {
              r.creature.homeId = home.id;
              this.grantInteractionEvent("arrival", r.creature.id);
              this.grantInteractionEvent("home-assigned", r.creature.id);
            }
            return r;
          }
          landQuote() {
            const r = C.content.rules, n = this.s.estate.purchases;
            return { coins: Math.ceil(r.landCoinsBase * Math.pow(r.landGrowth, n)), prestige: Math.ceil(r.landPrestigeBase * Math.pow(r.landGrowth, n)), level: r.landLevel };
          }
          buyIsland(ix, iy) {
            const issue = this.gateIssue("features", "land");
            if (issue)
              return fail(issue);
            const q = this.landQuote();
            if (this.s.player.level < q.level)
              return fail("Guide level " + q.level + " is required for buying land.");
            if (!int(ix, -48, 48) || !int(iy, -48, 48) || !G.frontier(this.s).some((i) => i.ix === ix && i.iy === iy))
              return fail("Choose an unowned island sharing an edge with your land.");
            if (this.s.estate.islands.length >= C.content.rules.maxIslands)
              return fail("The configured island limit is reached.");
            if (this.s.player.coins < q.coins || this.s.progression.prestige < q.prestige)
              return fail("Need " + q.coins + " coins and " + q.prestige + " prestige.");
            const nodes = G.generatedNodes(ix, iy, W), candidate = { ...this.s, estate: copy(this.s.estate), nodes: [...this.s.nodes, ...nodes] };
            candidate.estate.islands.push({ ix, iy, ...G.describe(ix, iy) });
            const grid = new G.Grid(candidate), seen = grid.flood({ x: 9, y: 9 });
            if (seen.size !== grid.cells.size)
              return fail("This island cannot yet be connected safely.");
            const settlement = this.settleEconomy({ id: this.economySettlementId("island", ix + ":" + iy), guide: -q.coins, prestige: -q.prestige }, "Purchased " + G.describe(ix, iy).name);
            if (!settlement.ok)
              return fail("The land purchase could not be settled.");
            this.s.estate = candidate.estate;
            this.s.estate.purchases++;
            this.s.nodes = candidate.nodes;
            this.log("A bridge connects " + G.describe(ix, iy).name + ". Creatures can walk there.", "route");
            this.emit("land", "A new island, a wider home.");
            for (const c of this.creatures)
              this.grantInteractionEvent("island-purchased", c.id);
            return ok({ island: { ix, iy }, quote: q });
          }
          isIndoor(b) {
            return !!b && typeof b.kind === "string" && indoor.has(b.kind);
          }
          ensureDoors() {
            for (const b of this.s.buildings)
              if (this.isIndoor(b) && !b.door) {
                const choices = [[0, 1], [1, 0], [0, -1], [-1, 0]];
                const d = choices.find(([dx, dy]) => this.walkable(b.x + dx, b.y + dy));
                b.door = { dx: d?.[0] ?? 0, dy: d?.[1] ?? 1 };
              }
          }
          doorway(b) {
            return { x: b.x + (b.door?.dx ?? 0), y: b.y + (b.door?.dy ?? 1) };
          }
          findPath(target, adjacent = false) {
            if (this.s.estate && target) {
              const b = this.s.buildings.find((b2) => b2.x === target.x && b2.y === target.y);
              if (this.isIndoor(b) && b.door)
                return root.LWNavigation.path(this.s, this.doorway(b), false);
            }
            return super.findPath(target, adjacent);
          }
          placementIssue(kind, x, y) {
            if (!this.s.estate)
              return super.placementIssue(kind, x, y);
            const issue = this.gateIssue("buildings", kind);
            if (issue)
              return issue;
            const cell = G.cell(x, y);
            if (!int(x, -1200, 1200) || !int(y, -1200, 1200) || !G.available(this.s, x, y) || cell.x < 2 || cell.y < 2 || cell.x > 16 || cell.y > 16)
              return "Choose owned, buildable ground, two tiles back from a shore or bridge.";
            if (this.s.buildings.some((b) => b.x === x && b.y === y) || this.allOrders().some((o) => o.type === "build" && o.x === x && o.y === y))
              return "This plot already has a building or plan.";
            if (this.creatures.some((c) => !c.activeQuest && Math.hypot(c.creature.x - x, c.creature.y - y) < 0.7))
              return "Wait until the creature has left this plot.";
            const required = W.building(kind)?.requiresNode, n = this.nodeAt(x, y);
            if (required && n?.kind !== required)
              return "Requires " + W.node(required).name.toLowerCase() + " on this exact tile.";
            if (required && !this.nodeAvailable(n))
              return "This site is exhausted.";
            if (n && !required)
              return "Keep this resource node accessible. Choose clear ground.";
            const plans = this.allOrders().filter((o) => o.type === "build"), grid = new G.Grid(this.s, [...plans, { x, y }]);
            for (const b of [...this.s.buildings, ...plans])
              if (this.isIndoor(b)) {
                const d = this.doorway(b);
                if (!grid.pass(d.x, d.y))
                  return "Keep the doorway of " + L.BUILDINGS[b.kind].name + " clear.";
              }
            if (indoor.has(kind) && !grid.pass(x, y + 1))
              return "This building needs an open front doorway on its south edge.";
            for (const n2 of this.s.nodes)
              if (W.node(n2.kind)?.direct && this.nodeAvailable(n2) && !this.s.buildings.some((b) => b.x === n2.x && b.y === n2.y) && !grid.approach(n2))
                return "Keep an approach to " + W.node(n2.kind).name + ".";
            const seed = this.creatures.find((c) => !c.activeQuest)?.creature || { x: 9, y: 9 }, seen = grid.flood({ x: Math.round(seed.x), y: Math.round(seed.y) });
            if (seen.size !== grid.cells.size)
              return "Keep paths connected around the settlement.";
            return null;
          }
          canBuild(x, y, kind = null) {
            if (!this.s.estate)
              return super.canBuild(x, y, kind);
            return !this.placementIssue(kind || this._placementKind || "shelter", x, y);
          }
          place(kind, x, y) {
            if (!this.s.estate)
              return super.place(kind, x, y);
            const issue = this.interactionIssue() || (!L.BUILDINGS[kind] ? "Unknown blueprint." : this.placementIssue(kind, x, y));
            if (issue)
              return fail(issue);
            if (this.actor.orders.length >= 12)
              return fail("This creature has twelve plans. Finish or cancel one first.");
            const b = L.BUILDINGS[kind];
            if (b.unique && !C.content.homes[kind] && (this.has(kind) || this.allOrders().some((o) => o.type === "build" && o.kind === kind)))
              return fail("This unique building is already built or planned.");
            const order = { id: "o" + this.s.nextId++, type: "build", kind, x, y, progress: 0, stage: 0, paid: false, paused: false, priority: 0, created: this.s.simTime, approach: this.s.buildPolicy.approach };
            this.actor.orders.push(order);
            this.log(this.actor.name + " will look after the " + b.name + " plan.", "plan");
            return ok({ order });
          }
          createNeedTask(which) {
            const t = super.createNeedTask(which);
            const home = this.home();
            if (which === "energy" && t && home) {
              t.target = home;
              t.label = "Resting at my " + L.BUILDINGS[home.kind].name.toLowerCase();
              t.reason = "My assigned home is a place to recover.";
            }
            return t;
          }
          interruptActor(c) {
            const t = c.task;
            if (!t)
              return;
            const b = this.s.buildings.find((b2) => b2.storage?.job?.id === t.jobId);
            if (t.buffered && b?.storage?.job) {
              b.storage.job.progress = Math.min(t.duration, t.elapsed);
              b.storage.job.workerId = null;
            }
            this.withActor(c, () => this.releaseSocial(t));
            c.task = null;
            c.worldSupply = null;
            this.releaseDetachedWork();
          }
          startTask(t) {
            if (t && marketKinds.includes(t.kind)) {
              if (this.actor.activeQuest)
                return false;
              const path = this.findPath(t.target, true);
              if (path === null)
                return false;
              t.path = path;
              t.phase = path.length ? "walk" : "work";
              t.elapsed = 0;
              t.duration = Math.max(1, t.duration || 2);
              this.actor.task = t;
              return true;
            }
            const result = super.startTask(t);
            if (result && t) {
              const b = this.s.buildings.find((b2) => b2.x === t.target?.x && b2.y === t.target?.y);
              if (this.isIndoor(b))
                t.insideBuildingId = b.id;
            }
            return result;
          }
          stepWorld() {
            super.stepWorld();
            if (!this.s.estate)
              return;
            this.ensureDoors();
            this.assignUnhoused();
            for (const c of this.creatures) {
              if (!Array.isArray(c.eventInteractions) || !c.interactionCooldowns || typeof c.interactionCooldowns !== "object")
                throw Error("Creature interaction state is invalid.");
              c.eventInteractions = c.eventInteractions.filter((e) => e.expires > this.s.simTime);
            }
            this.reconcileCargo();
            if (this.s.market.orders.length > 120)
              this.s.market.orders = this.s.market.orders.filter((q) => !["done", "cancelled"].includes(q.status));
          }
          finishTask(t) {
            if (!t || this.actor.task !== t)
              return;
            if (marketKinds.includes(t.kind)) {
              this.finishMarketTask(t);
              return;
            }
            super.finishTask(t);
            this.ensureDoors();
            this.assignUnhoused();
          }
          emit(type, text, extra = {}) {
            super.emit(type, text, extra);
            if (this.s.progression && type === "temper")
              this.grantInteractionEvent("temper", extra.actorId || this.actor.id);
          }
          grantInteractionEvent(trigger, actorId) {
            const c = this.creatures.find((c2) => c2.id === actorId);
            if (!c)
              return;
            if (!Array.isArray(c.eventInteractions) || !c.interactionCooldowns || typeof c.interactionCooldowns !== "object")
              throw Error("Creature interaction state is invalid.");
            for (const rule of C.content.events.filter((e) => e.trigger === trigger)) {
              if (c.eventInteractions.some((e) => e.definition === rule.interaction && e.expires > this.s.simTime))
                continue;
              c.eventInteractions.push({ id: "event-" + this.s.progression.interactionSequence++, definition: rule.interaction, trigger, created: this.s.simTime, expires: this.s.simTime + rule.seconds });
            }
            c.eventInteractions = c.eventInteractions.slice(-16);
          }
          interactions(c = this.selected) {
            if (!c || c.activeQuest)
              return [];
            return C.content.interactions.flatMap((d) => d.eventOnly ? c.eventInteractions.filter((e) => e.definition === d.id && e.expires > this.s.simTime).map((e) => ({ ...d, instance: e.id, expires: e.expires })) : [{ ...d, instance: d.id }]);
          }
          interactionReason(c, id) {
            if (!c)
              return "Select a creature.";
            if (c.activeQuest)
              return "This creature is away.";
            const d = this.interactions(c).find((d2) => d2.instance === id);
            if (!d)
              return "This interaction has expired or is unavailable.";
            if (d.handler === "care") {
              const issue = this.withActor(c, () => this.careIssue(d.action));
              return issue ? String(issue).replaceAll("Pip", c.name).replace("No stored water.", c.name + " carries no water.").replace("No snack in the pantry.", c.name + " has no food in their satchel.") : null;
            }
            if ((c.interactionCooldowns[d.id] || 0) > this.s.simTime)
              return "Let the last moment settle.";
            for (const [id2, n] of Object.entries(d.cost))
              if ((c.inventory[id2] || 0) < n)
                return "Needs " + n + " " + L.colony.item(id2).name + " in this creature\u2019s satchel.";
            return null;
          }
          interact(actorId, instance) {
            if (this._authorizedActorId !== actorId && this.selected?.id !== actorId)
              return fail("Select this creature before interacting.");
            const c = this.creatures.find((c2) => c2.id === actorId);
            if (!c)
              return fail("That creature is not in this glade.");
            const reason = this.interactionReason(c, instance);
            if (reason)
              return fail(reason);
            const d = this.interactions(c).find((d2) => d2.instance === instance);
            return this.commandActor(c.id, () => {
              if (d.handler === "care")
                return this.care(d.action);
              for (const [id, n] of Object.entries(d.cost))
                c.inventory[id] -= n;
              c.bond = L.clamp(c.bond + (d.effects.bond || 0), 0, 100);
              this.changeFeeling(d.label, d.effects.joy || 0, d.effects.anger || 0);
              c.feelings.social = L.clamp(c.feelings.social + (d.effects.social || 0), 0, 100);
              c.interactionCooldowns[d.id] = this.s.simTime + d.cooldown;
              if (d.eventOnly)
                c.eventInteractions = c.eventInteractions.filter((e) => e.id !== instance);
              this.visual("bond");
              this.log(c.name + " \xB7 " + d.label + ".", "heart");
              return ok();
            });
          }
          buyPrestigeItem(id) {
            const issue = this.gateIssue("features", "prestige-shop");
            if (issue)
              return fail(issue);
            const d = C.content.shop.find((d2) => d2.id === id);
            if (!d)
              return fail("Unknown prestige offer.");
            if (this.s.player.level < d.playerLevel)
              return fail("Guide level " + d.playerLevel + " required.");
            for (const id2 of Object.keys(d.items)) {
              const itemIssue = this.gateIssue("items", id2);
              if (itemIssue)
                return fail(itemIssue);
            }
            if (this.s.progression.prestige < d.prestige)
              return fail("Need " + d.prestige + " prestige.");
            if (!this.warehouse())
              return fail("A warehouse must be available for delivery.");
            for (const [id2, n] of Object.entries(d.items))
              if ((this.s.colony.warehouse.inventory[id2] || 0) + n > 1e6)
                return fail("Warehouse item limit reached.");
            const settlement = this.settleEconomy({ id: this.economySettlementId("prestige-shop", id), prestige: -d.prestige });
            if (!settlement.ok)
              return fail("The prestige cost could not be settled.");
            for (const [id2, n] of Object.entries(d.items))
              this.s.colony.warehouse.inventory[id2] = (this.s.colony.warehouse.inventory[id2] || 0) + n;
            this.log(d.name + " delivered to the warehouse. Creatures collect items in person.", "bag");
            return ok();
          }
          sellItem(id, qty = 1, assignedId = null) {
            const issue = this.gateIssue("features", "trade");
            if (issue)
              return fail(issue);
            if (!this.has("market"))
              return fail("Build a market stall before listing warehouse goods.");
            if (!L.colony.item(id) || !int(qty, 1, 99))
              return fail("Choose an item and quantity from 1 to 99.");
            if (assignedId && !this.creatures.some((c) => c.id === assignedId && !c.activeQuest))
              return fail("Choose an available carrier.");
            const pending = this.s.market.orders.filter((o) => !["done", "cancelled"].includes(o.status) && o.item === id).reduce((n, o) => n + o.remaining, 0);
            if ((this.s.colony.warehouse.inventory[id] || 0) - pending < qty)
              return fail("Only deposited stock not already listed may be queued for sale.");
            if (this.s.market.orders.filter((o) => !["done", "cancelled"].includes(o.status)).length >= 24)
              return fail("Finish existing market orders first.");
            const order = { id: "sale-" + this.s.market.sequence++, item: id, amount: qty, remaining: qty, sold: 0, transit: {}, staged: {}, assignedId, status: "queued", paused: false, priority: 1, unitPrice: Math.max(1, Math.floor(L.colony.item(id).price * B.forEngine(this).policy.sellFraction)), created: this.s.simTime };
            this.s.market.orders.push(order);
            this.log("Listed " + qty + " " + L.colony.item(id).name + ". A creature must carry and sell them at the market.", "market");
            return ok({ order, amount: qty * order.unitPrice });
          }
          depositKeep(c = this.actor) {
            const keep = super.depositKeep(c);
            for (const q of this.s.market?.orders || [])
              if ((q.transit[c.id] || 0) > 0)
                keep[q.item] = Math.max(keep[q.item] || 0, q.transit[c.id]);
            return keep;
          }
          reconcileCargo() {
            for (const c of this.creatures) {
              const available = { ...c.inventory };
              for (const q of this.s.market.orders) {
                const n = q.transit[c.id] || 0;
                if (n) {
                  const held = Math.min(n, available[q.item] || 0);
                  available[q.item] = (available[q.item] || 0) - held;
                  q.transit[c.id] = held;
                  if (!["cancelling", "cancelled"].includes(q.status))
                    q.remaining += n - held;
                }
              }
            }
          }
          marketTask() {
            const c = this.actor, orders = this.s.market?.orders || [];
            for (const q of orders.slice().sort((a, b) => b.priority - a.priority || a.created - b.created)) {
              if (q.status === "cancelled" || q.status === "done")
                continue;
              if (q.status === "cancelling") {
                const at = Object.entries(q.staged).find(([, n]) => n > 0);
                if (at) {
                  const b = this.s.buildings.find((b2) => b2.id === at[0]);
                  if (b && this.room(q.item) > 0)
                    return this.marketJob("market-reclaim", q, b, Math.min(at[1], this.room(q.item), C.content.rules.marketBatch));
                } else
                  q.status = "cancelled";
                continue;
              }
              if (q.paused || q.assignedId && q.assignedId !== c.id)
                continue;
              const staged = Object.entries(q.staged).find(([, n]) => n > 0);
              if (staged) {
                const b = this.s.buildings.find((b2) => b2.id === staged[0]);
                if (b)
                  return this.marketJob("market-sell", q, b, Math.min(staged[1], C.content.rules.marketBatch));
              }
              const held = q.transit[c.id] || 0;
              if (held) {
                const market = this.nearest(this.s.buildings.filter((b) => b.kind === "market" && this.reachable(b) && this.marketRoom(b) > 0));
                if (market)
                  return this.marketJob("market-deliver", q, market, Math.min(held, this.marketRoom(market)));
                continue;
              }
              if (q.remaining > 0 && (this.s.colony.warehouse.inventory[q.item] || 0) > 0) {
                const n = Math.min(q.remaining, this.s.colony.warehouse.inventory[q.item], C.content.rules.marketBatch, this.room(q.item));
                if (n > 0)
                  return this.marketJob("market-pickup", q, this.warehouse(), n);
              }
            }
            return null;
          }
          marketRoom(b) {
            return C.content.rules.marketCapacity - Object.values(b.marketInventory || {}).reduce((n, x) => n + x, 0);
          }
          marketJob(kind, q, b, amount) {
            return { kind, saleId: q.id, resource: q.item, buildingId: b.id, amount, target: { x: b.x, y: b.y }, duration: kind === "market-sell" ? C.content.rules.marketSeconds : 2, label: { "market-pickup": "Collecting for sale", "market-deliver": "Delivering to the market", "market-sell": "Selling at the stall", "market-reclaim": "Returning unsold stock" }[kind] + " \xB7 " + L.colony.item(q.item).name, reason: "Only a completed sale at the stall earns coins.", thought: "A little delivery, a useful exchange." };
          }
          finishMarketTask(t) {
            const q = this.s.market.orders.find((q2) => q2.id === t.saleId), c = this.actor, b = this.s.buildings.find((b2) => b2.id === t.buildingId);
            if (!q || !b || !this.at(b)) {
              c.task = null;
              return;
            }
            const inv = c.inventory;
            b.marketInventory ||= {};
            if (t.kind === "market-reclaim" && q.status === "cancelling") {
              const n = Math.min(t.amount, q.staged[b.id] || 0, b.marketInventory[q.item] || 0, this.room(q.item));
              if (n) {
                q.staged[b.id] -= n;
