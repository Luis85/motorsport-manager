              if (c2.task?.buildingId === b.id)
                e.interruptActor(c2);
            b.planAssignee = assignee;
            archive(e, row, command);
            return ok();
          }
          let r2;
          if (command === "cancel") {
            e.configureBuilding(b.id, "clear");
            r2 = e.configureBuilding(b.id, "enabled", false);
          } else
            r2 = e.configureBuilding(b.id, command === "priority" ? "priority" : "enabled", command === "priority" ? value : command === "resume");
          if (r2.ok)
            archive(e, row, command);
          return r2;
        }
        const c = e.creatures.find((c2) => c2.id === row.actorId);
        if (!c)
          return fail("That creature is no longer available.");
        if (command === "assign") {
          const target = e.creatures.find((c2) => c2.id === value && !c2.activeQuest);
          if (!row.canAssign || !target)
            return fail("This task cannot be reassigned now.");
          if (c === target)
            return ok();
          if (row.type === "order") {
