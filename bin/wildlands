        advance(seconds) {
          if (typeof seconds !== "number" || !Number.isFinite(seconds) || seconds < 0 || seconds > 3600)
            return;
          const count = Math.floor(seconds * 10 + 1e-9);
          for (let i = 0; i < count; i++)
