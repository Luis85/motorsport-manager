      const manifest = require_package();
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, name: manifest.name, version: manifest.version });
      return;
    }
    if (!command || !Object.hasOwn(allowed, command))
      throw Error("Unknown operation. " + usage);
    const values = options(args.slice(1), allowed[command]);
    const required = (flag) => {
      const value = values.get(flag);
      if (!value)
        throw Error("Missing required option: " + flag);
      return value;
    };
    const SDK = require_wildlands_project_sdk();
    if (command === "discover") {
      (0, cli_io_cjs_1.emit)({ ok: true, ...SDK.discover() });
      return;
    }
    if (command === "scenarios") {
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, scenarios: SDK.projects.scenarios() });
      return;
    }
    if (command === "create") {
      const config = {};
      for (const [flag, key] of [["--id", "id"], ["--name", "name"], ["--scenario", "scenarioId"], ["--scene", "sceneId"]]) {
        const value = values.get(flag);
        if (value !== void 0)
          config[key] = value;
      }
      const packFile = values.get("--pack");
      if (packFile) {
        const checkedPack = require_scenario_runtime().validate((0, cli_io_cjs_1.readJsonFile)(packFile, 8 * 1024 * 1024));
        if (!checkedPack.ok)
          throw Error(checkedPack.errors.join("\n"));
        config.pack = checkedPack.pack;
      }
      const project2 = SDK.projects.create(config), output = (0, cli_io_cjs_1.writeJsonFile)(required("--output"), project2, packFile ? [packFile] : []);
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, output, projectId: project2.id, scenarioId: project2.scenarioId, sceneId: project2.sceneId });
      return;
    }
    const input = required("--project"), checked = SDK.projects.validate((0, cli_io_cjs_1.readJsonFile)(input, SDK.projects.maxBytes));
    if (!checked.ok) {
      (0, cli_io_cjs_1.emit)({ ok: false, protocolVersion: 1, code: "invalid-project", errors: checked.errors });
      process.exitCode = 1;
      return;
    }
    const project = checked.project;
    if (command === "validate") {
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, fingerprint: checked.fingerprint, projectId: project.id, scenarioId: project.scenarioId, sceneId: project.sceneId });
      return;
    }
    if (command === "inspect") {
      const inspected = SDK.inspectProject(project);
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, projectId: project.id, scenarioId: project.scenarioId, sceneId: project.sceneId, fingerprint: inspected.fingerprint, snapshot: inspected.snapshot, connections: inspected.connections });
      return;
    }
    if (command === "scenario") {
      const next = SDK.projects.select(project, required("--scenario"), values.get("--scene")), output = (0, cli_io_cjs_1.writeJsonFile)(required("--output"), next, [input]);
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, output, scenarioId: next.scenarioId, sceneId: next.sceneId });
      return;
    }
    if (command === "run" || command === "edit") {
      const recipeFile = required("--recipe"), recipe = (0, cli_io_cjs_1.readJsonFile)(recipeFile, 1024 * 1024);
      const result2 = command === "run" ? SDK.runProject(project, recipe) : SDK.editProject(project, recipe);
      const output = (0, cli_io_cjs_1.writeJsonFile)(required("--output"), result2.project, [input, recipeFile]);
      const { project: _, ...details } = result2;
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, output, scenarioId: result2.project.scenarioId, sceneId: result2.project.sceneId, ...details });
      return;
    }
    const writer = require_wildlands_godot_writer();
    const result = await writer.writeGodotProject(project, required("--output"), { withEngineSources: values.has("--with-engine-sources") });
    (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, ...result });
  } catch (error) {
    (0, cli_io_cjs_1.emit)({ ok: false, protocolVersion: 1, code: "operation-failed", errors: [error instanceof Error ? error.message : String(error)] });
    process.exitCode = 2;
  }
}
if (require.main === module)
  void run(process.argv.slice(2));
