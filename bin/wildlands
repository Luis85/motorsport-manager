            target.researched[row.id] = true;
          } else if (row.type === "outfit") {
            if (target.equipQueue.length >= 4 || target.equipQueue.includes(row.id))
              return fail("The outfit queue is full or already has that item.");
            e.interruptActor(c);
            c.equipQueue = c.equipQueue.filter((id) => id !== row.id);
            target.equipQueue.push(row.id);
          } else if (row.type === "quest") {
            if (target.questPlan || target.activeQuest)
              return fail("The receiving creature already has a quest.");
            const issue = e.questPlanIssue?.(c.questPlan, target);
            if (issue)
              return fail(issue);
            e.interruptActor(c);
            target.questPlan = c.questPlan;
            c.questPlan = null;
          } else
            return fail("This task cannot be reassigned.");
          const newKey = key(row.type, target.id, row.id);
          if (e.s.planning.controls[k]) {
            e.s.planning.controls[newKey] = { ...e.s.planning.controls[k] };
            delete e.s.planning.controls[k];
          }
          archive(e, row, "assigned to " + target.name);
          return ok();
        }
        const meta = e.s.planning.controls[k] || {};
        let r = ok();
        if (command === "priority") {
          meta.priority = priority;
          if (row.type === "order") {
            c.orders.find((o) => o.id === row.id).priority = priority;
          }
          if (row.type === "lesson" && c.training?.id !== row.id) {
            const i = c.learning.queue.findIndex((t) => t.id === row.id);
            if (i >= 0 && value === 2)
              c.learning.queue.unshift(...c.learning.queue.splice(i, 1));
          }
        } else if (command === "cancel") {
          r = e.commandActor(c.id, () => {
            if (row.type === "order")
              return e.cancel(row.id);
            if (row.type === "lesson")
              return e.cancelLesson(row.id);
            if (row.type === "outfit")
              return e.cancelEquipment(row.id);
            if (row.type === "quest")
              return e.cancelQuestPlan();
            if (row.type === "social") {
              e.interruptActor(c);
              c.socialIntent = null;
            }
            if (row.type === "unpack") {
              e.interruptActor(c);
              c.unpackIntent = false;
            }
            if (row.type === "activity")
              e.interruptActor(c);
            return ok();
          });
          delete e.s.planning.controls[k];
        } else {
          const hold = command !== "resume";
          meta.paused = hold;
          meta.stopped = command === "stop";
          if (row.type === "order")
            r = e.commandActor(c.id, () => e.pauseOrder(row.id, hold));
          else if (row.type === "quest" && c.questPlan)
            c.questPlan.paused = hold;
          else if (row.type === "activity") {
            if (hold)
              e.interruptActor(c);
            meta.paused = false;
          }
          if (hold && row.type !== "order")
            e.interruptActor(c);
          if (row.type === "lesson" && !hold)
            c.learning.paused = false;
        }
        if (command !== "cancel")
          e.s.planning.controls[k] = meta;
        if (r?.ok !== false)
          archive(e, row, command);
        return r || ok();
      }
      function taskOptions(e, type, c) {
        if (type === "gather")
          return root.LWWorldContent.content.nodes.filter((n) => n.direct && n.resource && L.RES[n.resource] && e.unlocked("items", n.resource)).map((n) => ({ id: n.resource, name: L.RES[n.resource].name })).filter((d, i, a) => a.findIndex((x) => x.id === d.id) === i);
        if (type === "craft")
          return Object.keys(L.RECIPES).filter((id) => e.unlocked("recipes", id)).map((id) => ({ id, name: L.RES[id].name }));
        if (type === "build")
          return Object.entries(L.BUILDINGS).filter(([id]) => e.unlocked("buildings", id)).map(([id, b]) => ({ id, name: b.name }));
        if (type === "lesson" || type === "practice")
          return Object.entries(L.SKILLS).filter(([id, k]) => k.tier <= e.s.player.level && (type === "lesson" ? !c?.skills[id] : c?.skills[id])).map(([id, k]) => ({ id, name: k.short + (type === "lesson" ? " \xB7 " + k.coins + " coins" : "") }));
        if (type === "outfit")
          return root.LWAdventure.content.equipment.filter((d) => e.unlocked("items", d.id)).map((d) => ({ id: d.id, name: d.name }));
        if (type === "quest")
          return e.unlocked("features", "quests") ? e.s.colony.board.offers.filter((o) => !e.questOfferIssue?.(o.id, c)).map((o) => ({ id: o.id, name: root.LWAdventure.content.quests.find((q) => q.id === o.questId).name + " \xB7 " + (o.islandName || "Mossmeadow") })) : [];
        if (type === "social")
          return e.creatures.filter((x) => x.id !== c?.id && !x.activeQuest).map((x) => ({ id: x.id, name: x.name }));
        if (type === "workplace")
          return e.s.buildings.filter((b) => b.storage).map((b) => ({ id: b.id, name: L.BUILDINGS[b.kind].name + " \xB7 " + b.x + ", " + b.y }));
        return [{ id: "", name: type === "unpack" ? "Open carried or stored chest" : type === "unload" ? "Deposit excess carried goods" : "Neighbor delivery" }];
      }
      const types = [["gather", "Gather resources", "Production"], ["craft", "Craft items", "Production"], ["build", "Build a place", "Construction"], ["lesson", "Learn a skill", "Learning"], ["practice", "Practice a skill", "Learning"], ["outfit", "Prepare equipment", "Equipment"], ["quest", "Prepare a quest", "Adventure"], ["social", "Meet a companion", "Friendship"], ["delivery", "Neighbor delivery", "Market"], ["unpack", "Open a chest", "Inventory"], ["unload", "Bring findings home", "Logistics"], ["workplace", "Workplace production", "Workplace"]].map(([id, name, system]) => ({ id, name, system }));
      function availableTypes(e) {
        return types.filter((t) => t.id !== "quest" || e.unlocked("features", "quests")).filter((t) => t.id !== "delivery" || e.unlocked("features", "trade"));
      }
      function add(e, input) {
        const { actorId, type, id, quantity = 1, recipe } = input;
        const c = e.creatures.find((c2) => c2.id === actorId);
        if (!c || c.activeQuest)
          return fail("Assign an available creature.");
        if (!availableTypes(e).some((t) => t.id === type) || !Number.isInteger(quantity) || quantity < 1 || quantity > 24)
          return fail("Choose a supported task and whole-number quantity.");
        if (type === "build") {
          if (!e.unlocked("buildings", id))
            return fail(e.gateIssue("buildings", id));
          return ok({ placement: id, actorId });
        }
        return e.commandActor(actorId, () => {
          if (type === "gather" || type === "craft")
            return e.request(type, id, quantity);
          if (type === "lesson") {
            if (!c.researched[id])
              return fail("Research this lesson in Learn before purchasing the training.");
            return e.teach(id);
          }
          if (type === "practice")
            return e.practice(id, Math.min(3, quantity));
          if (type === "outfit")
            return e.requestEquipment(id);
          if (type === "quest")
            return e.acceptQuest(id);
          if (type === "social")
            return e.suggestSocial(id);
          if (type === "delivery")
            return e.request("deliver");
          if (type === "unpack")
            return e.requestUnpack();
          if (type === "unload") {
            c.needsDeposit = true;
            return ok();
          }
          if (type === "workplace") {
            const b = e.s.buildings.find((b2) => b2.id === id);
            if (!b?.storage)
              return fail("Choose a production building.");
            const r = e.configureBuilding(id, "batch", { recipe, amount: Math.min(12, quantity) });
            if (r.ok)
              b.planAssignee = actorId;
            return r;
          }
          return fail("Unsupported task.");
        });
      }
      function attach(engine) {
        const original = engine.handlers();
        engine._plannerHandlers = original;
        const start = (t) => t && engine.startTask(t) ? "running" : "failure";
        const h = { ...original };
        h.learning = () => {
          const c = engine.actor, t = c.training || c.learning.queue[0];
          return t && paused(engine, key("lesson", c.id, t.id)) ? "failure" : original.learning();
        };
        h.outfit = () => {
          const c = engine.actor;
          return c.equipQueue[0] && paused(engine, key("outfit", c.id, c.equipQueue[0])) ? "failure" : original.outfit();
        };
        h.companionship = () => {
          const c = engine.actor;
          return c.socialIntent && paused(engine, key("social", c.id, c.socialIntent)) ? "failure" : original.companionship();
        };
        h.prioritized = () => {
          const c = engine.actor;
          const candidates = [];
          for (const o of c.orders)
            if (!o.paused && o.priority === 2)
              candidates.push({ key: key("order", c.id, o.id), run: () => start(engine.orderTask(o)) });
          for (const t of [...c.training ? [c.training] : [], ...c.learning.queue]) {
            const k = key("lesson", c.id, t.id);
            if (control(engine, k).priority === 2 && !paused(engine, k))
              candidates.push({ key: k, run: h.learning });
          }
          for (const id of c.equipQueue) {
            const k = key("outfit", c.id, id);
            if (control(engine, k).priority === 2 && !paused(engine, k))
              candidates.push({ key: k, run: h.outfit });
          }
          if (c.questPlan) {
            const k = key("quest", c.id, c.questPlan.questId);
            if (control(engine, k).priority === 2 && !c.questPlan.paused)
              candidates.push({ key: k, run: h.quest });
          }
          for (const q of engine.s.market.orders)
            if (q.priority === 2 && !q.paused && (!q.assignedId || q.assignedId === c.id) && !terminal(q))
              candidates.push({ key: "sale:" + q.id, run: () => start(engine.marketTask()) });
          for (const r of candidates.sort((a, b) => a.key < b.key ? -1 : a.key > b.key ? 1 : 0)) {
            const result = r.run();
            if (result !== "failure")
              return result;
          }
          return "failure";
        };
        engine.behaviorTree = new root.LWBehaviorTree(h);
        engine._plannerTree = C.clone(root.LWAdventure.content.behaviorTree);
        const children = engine._plannerTree.children;
        if (children) {
          const at = children.findIndex((n) => n.type === "action" && ["outfit", "quest", "learning", "plans"].includes(n.action || ""));
          children.splice(at < 0 ? Math.min(5, children.length) : at, 0, { id: "planner-priority", name: "Prioritized player plans", type: "action", action: "prioritized" });
        }
        engine.behaviorTree.validate(engine._plannerTree);
      }
      function initializePlanner(self) {
        attach(self);
      }
      function defineLayer(Base) {
        return class PlannerLayer extends Base {
          decide() {
            if (this.actor.activeQuest)
              return;
            const result = this.behaviorTree.tick(this._plannerTree, { time: this.s.simTime, behaviorMemory: this.actor.behavior.memory });
            this.actor.behavior.trace = result.trace;
            this.actor.behavior.lastAction = this.actor.task?.label || "Considering the next step";
          }
        };
      }
      function installFactories() {
        const scenarioNames = ["createWorldDemo", "createColonyDemo", "createWorkshopDemo"], rawFactories = Object.fromEntries(scenarioNames.map((k) => [k, L[k]])), wrappedFactories = {};
        for (const name of scenarioNames)
          wrappedFactories[name] = () => {
            let demo;
            try {
              Object.assign(L, rawFactories);
              demo = rawFactories[name]();
            } finally {
              Object.assign(L, wrappedFactories);
            }
            return Composition.constructThrough("planner", demo.export().state);
          };
        Object.assign(L, wrappedFactories);
      }
      Composition.register({ id: "planner", order: 50, define: defineLayer, initialize: initializePlanner, installFactories });
      const api = { rows, act, add, types, taskOptions, availableTypes, control, paused, attach };
      root.LWPlanner = api;
      if (typeof module2 !== "undefined" && module2.exports)
        module2.exports = L;
    })(typeof globalThis !== "undefined" ? globalThis : exports2);
  }
});

