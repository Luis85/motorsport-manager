        }
        return out.sort((a, b) => Number(a.paused) - Number(b.paused) || b.priority - a.priority || (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
      }
      function archive(e, row, label) {
        e.s.planning.history.unshift({ time: e.s.simTime, key: row.key, name: row.name, actorId: row.actorId, action: label });
        e.s.planning.history = e.s.planning.history.slice(0, 60);
      }
      function act(e, k, command, value) {
        const row = rows(e).find((r2) => r2.key === k);
        if (!row)
          return fail("That task has finished or changed.");
        if (row.away) {
          if (row.type === "quest" && command === "cancel")
            return e.commandActor(row.actorId, () => e.abortQuest(), { away: true });
          return fail("This creature is away. Only quest recall is available.");
        }
        if (row.protected)
          return fail("Essential care and returning carried goods cannot be stopped.");
        if (!["pause", "resume", "stop", "cancel", "priority", "assign"].includes(command))
          return fail("Unknown planner operation.");
        if (row.type === "activity" && !["stop", "cancel"].includes(command))
          return fail("This is an autonomous activity. Stop it once; the creature may choose it again when needed.");
        if (command === "priority" && (typeof value !== "number" || ![0, 1, 2].includes(value)))
          return fail("Choose a valid priority.");
        if (command === "assign" && value !== null && value !== void 0 && typeof value !== "string")
          return fail("Choose an available creature.");
        const priority = typeof value === "number" ? value : 0, assignee = typeof value === "string" ? value : null;
        if (row.type === "sale") {
          const r2 = e.controlSale(row.id, command, value);
          if (r2.ok)
            archive(e, row, command);
          return r2;
        }
        if (row.type === "workplace") {
          const b = e.s.buildings.find((b2) => b2.id === row.id);
          if (!b)
            return fail("That workplace is no longer available.");
          if (command === "assign") {
            if (value && !e.creatures.some((c2) => c2.id === value && !c2.activeQuest))
              return fail("Choose an available creature.");
