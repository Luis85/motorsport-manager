      const L = facade;
      const schedule = Object.freeze([
        Object.freeze({ id: "clock", scope: "world", order: 10, owner: "simulation-pipeline" }),
        Object.freeze({ id: "world", scope: "world", order: 20, owner: "world-simulation" }),
