            const p = profile(this.actor.personality).preferences;
            const preference = t.kind === "train" || t.kind === "practice" ? p.train : t.kind === "build" ? p.build : 1;
            return base.workRate.call(this, t) * (this.actor?.feelings?.anger >= 60 ? 0.85 : 1) * (1 + (preference - 1) * 0.15) * (this.s.focus === "builder" && t.kind === "build" ? 1.1 : 1);
          },
