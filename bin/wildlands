            c.orders = c.orders.filter((v) => v !== o);
            target.orders.push(o);
            for (const b of e.s.buildings)
              if (b.storage?.job?.orderId === o.id)
                b.storage.job.originId = target.id;
          } else if (row.type === "lesson") {
            const lesson = c.training?.id === row.id ? c.training : c.learning.queue.find((t) => t.id === row.id);
            if (!lesson)
              return fail("That lesson is no longer available.");
            if (lesson.progress || target.skills[row.id] || target.learning.queue.length >= 4 || target.training?.id === row.id || target.learning.queue.some((t) => t.id === row.id))
              return fail("Only an unstarted lesson can move to a creature who has not queued or learned it.");
