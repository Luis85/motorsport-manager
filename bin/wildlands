          const p = project(tile, frame), width = view.unit - 0.4;
          if (Math.abs(point.x - p.x) / (width / 2) + Math.abs(point.y - p.y) / (width / 4) <= 1)
            return { x: tile.x, y: tile.y };
        }
        return inverse(point, { x: view.x, y: view.y }, view.unit, view.cx, view.cy);
      }
      function diamond(painter, p, width, color, opacity = 1) {
        painter.polygon([{ x: p.x, y: p.y - width / 4 }, { x: p.x + width / 2, y: p.y }, { x: p.x, y: p.y + width / 4 }, { x: p.x - width / 2, y: p.y }], color, opacity);
      }
      function rectangle(painter, x, y, width, height, color) {
        painter.polygon([{ x, y }, { x: x + width, y }, { x: x + width, y: y + height }, { x, y: y + height }], color);
      }
      function cutaway(painter, frame, tiles, colors, unit) {
        const present = new Set(tiles.map((tile) => tile.x + "," + tile.y));
        for (const tile of tiles)
          for (const side of [-1, 1]) {
            if (present.has(tile.x - (side === -1 ? 1 : 0) + "," + (tile.y - (side === 1 ? 1 : 0))))
              continue;
