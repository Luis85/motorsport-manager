        location.route = route(layout, location, floorId, dest);
        state(e).locations[e.actor.id] = location;
        return location;
      }
      function bindJob(e, t) {
        const b = e.s.buildings.find((b2) => b2.id === t.buildingId), job = b?.storage?.job;
        if (!job || state(e).jobs[job.id])
          return;
