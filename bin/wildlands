          }
          for (const [recipe, n] of Object.entries(quantities))
            if (n > (b.storage.requests[recipe] || 0))
              bad("station batches exceed physical request");
        }
        for (const [jobId, binding] of Object.entries(input.jobs)) {
          exact(binding, ["floorId", "stationId", "recipe"]);
