              if (operator !== (metric === "trait" ? "contains" : "eq"))
                throw Error("Invalid identity condition operator.");
              text(c.value, "condition identity", 64);
            } else if (metric === "idle") {
              if (operator !== "eq")
                throw Error("Invalid idle condition operator.");
              bool(c.value, "idle condition");
            } else
              throw Error("Unknown trigger metric.");
            return { metric, operator, value: c.value };
          });
        }
        const triggers = data.triggers.map((value) => {
          const r = object(value, ["id", "definitionId", "priority", "intervalSeconds", "chancePercent", "source", "target", "maximumDistance", "minimumAffinity"], "duel trigger");
