  ".generated/skill-tree-integration.js"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root = inputRoot;
      const rules = root.LWSkillTrees;
      function state(engine) {
        return root.LWActorStateView.rootOf(engine.s);
      }
      function owner(engine, targetId) {
        const s = state(engine);
        if (targetId === "player")
          return { holder: s.player, level: s.player.level };
        const actor = s.colony?.creatures.find((c) => c.id === targetId);
        if (!actor)
          throw Error("Choose an existing player or creature for this skill tree.");
