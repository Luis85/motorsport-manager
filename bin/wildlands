      }
      function cancelSeek(e, actorId) {
        const s = e.s.creatureInteractions;
        if (!s || !s.seeks.some((v) => v.actorId === actorId))
          return { ok: false, reason: "This creature is not looking for a duel." };
        s.seeks = s.seeks.filter((v) => v.actorId !== actorId);
        return { ok: true };
      }
      function step(e) {
        if (!e.s.started || e.s.paused)
          return;
        if (root.LWGameSettings && !root.LWGameSettings.allowed(e, "duels"))
          return;
        const s = R.state(e), now = e.s.simTime;
