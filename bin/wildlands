          }
          request(type, resource = null, quantity = null) {
            if (type === "gather" && RAW.includes(resource) && !["wood", "stone", "fiber", "berries", "water"].includes(resource)) {
              if (this.s.orders.length >= 12)
                return fail("The idea queue is full.");
              if (this.s.orders.some((o2) => o2.type === "gather" && o2.resource === resource))
                return fail("That gathering idea is already on the board.");
