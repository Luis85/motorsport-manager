          if (L.CROP_RES[building.kind]) {
            building.regen += dt * (1 + ((building.level || 1) - 1) * LEGACY_FALLBACK.cropLevelRate);
            if (building.regen >= LEGACY_FALLBACK.cropCycleSeconds) {
              building.regen -= LEGACY_FALLBACK.cropCycleSeconds;
              building.stock = Math.min(LEGACY_FALLBACK.cropOutputLimit, building.stock + (building.kind === "orchard" ? LEGACY_FALLBACK.orchardYield : LEGACY_FALLBACK.otherCropYield) + ((building.level || 1) - 1));
