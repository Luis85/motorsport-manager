// .generated/renderer-scene-2d.js
var require_renderer_scene_2d = __commonJS({
  ".generated/renderer-scene-2d.js"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root = inputRoot, zero = [0, 0, 0], one = [1, 1, 1];
      const ink = "#31463d", paper = "#e3eadd", gold = "#f3df9d";
      function record(value) {
        return value && typeof value === "object" && !Array.isArray(value) ? value : {};
      }
      function environment(frame) {
        const value = record(frame.environment);
        if (value.mode !== "indoor")
          return null;
        const color = (key, fallback) => typeof value[key] === "string" && /^#[0-9a-f]{6}$/i.test(value[key]) ? value[key] : fallback;
