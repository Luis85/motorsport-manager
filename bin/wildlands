// .generated/process-systems.js
var require_process_systems = __commonJS({
  ".generated/process-systems.js"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root = inputRoot;
      const limits = root.LWProcessLimits;
      const compare = (a, b) => a < b ? -1 : a > b ? 1 : 0;
      const tokens = (s) => s.world.query(["process-token"]).map((id) => s.world.get(id, "process-token"));
      const caseOf = (s, t) => s.world.get(t.caseId, "process-case");
      const station = (s, id) => s.world.get("station-" + id, "process-station");
      const pool = (s, id) => s.world.get("pool-" + id, "process-pool");
      const event = (s, kind, c, step, detail = "") => {
        s.events.push({ minute: s.clock.minute, kind, caseId: c, stepId: step, detail });
        if (s.events.length > limits.events)
          s.events.shift();
      };
      function release(s, t) {
        for (const [id, quantity] of Object.entries(s.steps.get(t.stepId).resources ?? {}))
          pool(s, id).busy -= quantity;
      }
      function fail(s, c, message) {
        c.status = "failed";
        c.error = message;
        c.finished = s.clock.minute;
        for (const t of tokens(s).filter((t2) => t2.caseId === c.id)) {
          if (t.status === "active")
            release(s, t);
          s.world.destroy(t.id);
        }
        event(s, "failed", c.id, "", message);
      }
      function enter(s, t, stepId) {
        t.stepId = stepId;
        t.entered = s.clock.minute;
        t.started = null;
        t.remaining = 0;
        t.input = null;
        t.status = "routing";
        station(s, stepId).visits++;
        event(s, "entered", t.caseId, stepId);
      }
      function spawn(s, caseId, stepId, fork, branch) {
        const id = "token-" + String(++s.clock.serial).padStart(8, "0");
        s.world.create(id);
        const token = { id, caseId, stepId, entered: s.clock.minute, started: null, input: null, remaining: 0, status: "routing", fork, branch };
        s.world.set(id, "process-token", token);
        enter(s, token, stepId);
      }
      function admit(s) {
        while (s.clock.arrival < s.arrivals.length && s.arrivals[s.clock.arrival].at <= s.clock.minute) {
          const arrival = s.arrivals[s.clock.arrival++], id = "case-" + String(s.clock.arrival).padStart(4, "0");
          s.world.create(id);
          s.world.set(id, "process-case", { id, input: { ...arrival.data }, data: { ...arrival.data }, entered: s.clock.minute, finished: null, status: "active", transitions: 0, error: null });
          event(s, "arrived", id, s.definition.start);
          spawn(s, id, s.definition.start, null, null);
        }
      }
      function route(s, t) {
        const c = caseOf(s, t), step = s.steps.get(t.stepId), out = s.outgoing.get(step.id);
        if (++c.transitions > limits.transitions) {
          fail(s, c, "Case exceeded " + limits.transitions + " step transitions.");
          return;
        }
        if (step.kind === "task") {
          t.status = "queued";
          return;
        }
        if (step.kind === "end") {
          station(s, step.id).completed++;
          s.world.destroy(t.id);
          if (tokens(s).some((other) => other.caseId === c.id)) {
            fail(s, c, "End reached with outstanding work.");
            return;
          }
          c.status = "completed";
          c.finished = s.clock.minute;
          event(s, "completed", c.id, step.id);
          return;
        }
        if (step.kind === "fork") {
          station(s, step.id).completed++;
          const occurrence = step.id + "-" + ++s.clock.forkSerial;
          s.world.destroy(t.id);
          for (const flow2 of out)
            spawn(s, c.id, flow2.to, occurrence, flow2.id);
          return;
        }
        if (step.kind === "join") {
          t.status = "joining";
          return;
        }
        station(s, step.id).completed++;
        const flow = step.kind === "decision" ? out.find((f) => f.when && root.LWProcessGraph.matches(c.data, f.when)) ?? out.find((f) => !f.when) : out[0];
        event(s, "routed", c.id, step.id, flow.id);
        enter(s, t, flow.to);
      }
      function join(s) {
        let changed = false;
        for (const step of s.definition.steps.filter((s2) => s2.kind === "join")) {
          const fork = s.definition.steps.find((f) => f.join === step.id);
          const waiting = tokens(s).filter((t) => t.stepId === step.id && t.status === "joining");
