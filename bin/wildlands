          }
          purchasePrice() {
            return Math.ceil(A.content.rules.purchaseBase * Math.pow(A.content.rules.purchaseGrowth, this.s.colony.purchased - 1));
          }
          purchaseCreature(personality, archetype = Creatures.defaultArchetype) {
