            const b = e.s.buildings.find((b2) => b2.id === id);
            if (!b?.storage)
              return fail("Choose a production building.");
            const r = e.configureBuilding(id, "batch", { recipe, amount: Math.min(12, quantity) });
            if (r.ok)
              b.planAssignee = actorId;
            return r;
          }
          return fail("Unsupported task.");
        });
      }
      function attach(engine) {
        const original = engine.handlers();
        engine._plannerHandlers = original;
        const start = (t) => t && engine.startTask(t) ? "running" : "failure";
        const h = { ...original };
        h.learning = () => {
          const c = engine.actor, t = c.training || c.learning.queue[0];
          return t && paused(engine, key("lesson", c.id, t.id)) ? "failure" : original.learning();
        };
        h.outfit = () => {
          const c = engine.actor;
          return c.equipQueue[0] && paused(engine, key("outfit", c.id, c.equipQueue[0])) ? "failure" : original.outfit();
        };
        h.companionship = () => {
          const c = engine.actor;
          return c.socialIntent && paused(engine, key("social", c.id, c.socialIntent)) ? "failure" : original.companionship();
        };
        h.prioritized = () => {
          const c = engine.actor;
          const candidates = [];
          for (const o of c.orders)
            if (!o.paused && o.priority === 2)
              candidates.push({ key: key("order", c.id, o.id), run: () => start(engine.orderTask(o)) });
          for (const t of [...c.training ? [c.training] : [], ...c.learning.queue]) {
            const k = key("lesson", c.id, t.id);
            if (control(engine, k).priority === 2 && !paused(engine, k))
              candidates.push({ key: k, run: h.learning });
          }
          for (const id of c.equipQueue) {
            const k = key("outfit", c.id, id);
            if (control(engine, k).priority === 2 && !paused(engine, k))
              candidates.push({ key: k, run: h.outfit });
          }
          if (c.questPlan) {
            const k = key("quest", c.id, c.questPlan.questId);
            if (control(engine, k).priority === 2 && !c.questPlan.paused)
              candidates.push({ key: k, run: h.quest });
          }
          for (const q of engine.s.market.orders)
            if (q.priority === 2 && !q.paused && (!q.assignedId || q.assignedId === c.id) && !terminal(q))
              candidates.push({ key: "sale:" + q.id, run: () => start(engine.marketTask()) });
          for (const r of candidates.sort((a, b) => a.key < b.key ? -1 : a.key > b.key ? 1 : 0)) {
            const result = r.run();
            if (result !== "failure")
              return result;
          }
          return "failure";
        };
        engine.behaviorTree = new root.LWBehaviorTree(h);
        engine._plannerTree = C.clone(root.LWAdventure.content.behaviorTree);
        const children = engine._plannerTree.children;
        if (children) {
          const at = children.findIndex((n) => n.type === "action" && ["outfit", "quest", "learning", "plans"].includes(n.action || ""));
          children.splice(at < 0 ? Math.min(5, children.length) : at, 0, { id: "planner-priority", name: "Prioritized player plans", type: "action", action: "prioritized" });
        }
        engine.behaviorTree.validate(engine._plannerTree);
      }
      function initializePlanner(self) {
        attach(self);
      }
      function defineLayer(Base) {
        return class PlannerLayer extends Base {
          decide() {
            if (this.actor.activeQuest)
              return;
            const result = this.behaviorTree.tick(this._plannerTree, { time: this.s.simTime, behaviorMemory: this.actor.behavior.memory });
            this.actor.behavior.trace = result.trace;
            this.actor.behavior.lastAction = this.actor.task?.label || "Considering the next step";
          }
        };
      }
      function installFactories() {
        const scenarioNames = ["createWorldDemo", "createColonyDemo", "createWorkshopDemo"], rawFactories = Object.fromEntries(scenarioNames.map((k) => [k, L[k]])), wrappedFactories = {};
        for (const name of scenarioNames)
          wrappedFactories[name] = () => {
            let demo;
            try {
              Object.assign(L, rawFactories);
              demo = rawFactories[name]();
            } finally {
              Object.assign(L, wrappedFactories);
            }
            return Composition.constructThrough("planner", demo.export().state);
          };
        Object.assign(L, wrappedFactories);
      }
      Composition.register({ id: "planner", order: 50, define: defineLayer, initialize: initializePlanner, installFactories });
      const api = { rows, act, add, types, taskOptions, availableTypes, control, paused, attach };
      root.LWPlanner = api;
      if (typeof module2 !== "undefined" && module2.exports)
        module2.exports = L;
    })(typeof globalThis !== "undefined" ? globalThis : exports2);
  }
