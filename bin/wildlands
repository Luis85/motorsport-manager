          if (!choices.length)
            continue;
          if (rule.chancePercent < 100 && decision(e, s) * 100 >= rule.chancePercent)
            continue;
          const selected = choices[Math.floor(decision(e, s) * choices.length)];
          R.request(e, definition.id, selected.sourceId, selected.target);
        }
      }
