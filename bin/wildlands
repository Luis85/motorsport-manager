        defaultPack: () => copy(catalog().defaultPack),
        defaultId: () => catalog().defaultPack.id,
        defaultTutorial: () => copy(catalog().defaultPack.tutorial),
        defaultPresentation: () => copy(catalog().defaultPack.presentation),
        defaultSimulation: () => copy(Profiles.defaults)
      };
      Content.whenInstalled(() => {
        catalog();
      }, "scenarios");
      root.LWScenarios = api;
      if (node)
        module2.exports = api;
    })(typeof globalThis !== "undefined" ? globalThis : exports2);
