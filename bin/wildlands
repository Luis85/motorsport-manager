              for (const [id, n] of Object.entries(engine.constructionCost(order)))
                reserve(id, n);
            });
          if (actor.equipQueue[0])
            reserve(actor.equipQueue[0], 1);
          if (actor.task?.resource && ["craft", "gearcraft"].includes(actor.task.kind))
