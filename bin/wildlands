              achievement = true;
            }
            if (achievement) {
              s.memory.lastAchievement = s.simTime;
              this.practiceSkill(usedSkill);
            } else if (t.kind === "shop")
              this.practiceSkill(usedSkill);
            this.checkWish();
            if (o && o.type !== "build" && (o.done || 0) >= o.amount) {
