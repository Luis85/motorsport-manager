                  throw Error("Conflicting physical entity binding.");
                bindings.set(id, record);
              }
            prepare(type, spec, preview);
          }
        }
        function writeTargets(type, spec) {
          if (type === "CarrierTask") {
            const s = spec;
            writable(s.source, [s.resource], "source inventory");
            writable(s.destination, [s.resource], "destination inventory");
          } else if (type === "HarvestTask") {
            const s = spec;
            writable(s.destination, [s.resource], "destination inventory");
