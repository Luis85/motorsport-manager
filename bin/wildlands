// .generated/interaction-duel-rules.js
var require_interaction_duel_rules = __commonJS({
  ".generated/interaction-duel-rules.js"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      function winner(profile, a, b, sourceId, targetId) {
        if (profile.scoring === "margin")
          return a.margin === b.margin ? null : a.margin > b.margin ? sourceId : targetId;
        return a.success && !b.success ? sourceId : b.success && !a.success ? targetId : a.success && b.success && a.margin !== b.margin ? a.margin > b.margin ? sourceId : targetId : null;
      }
      const api = Object.freeze({ winner });
      inputRoot.LWInteractionDuelRules = api;
      if (typeof module2 !== "undefined" && module2.exports)
        module2.exports = api;
    })(globalThis);
  }
});

