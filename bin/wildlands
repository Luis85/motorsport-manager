var require_engine_task_completion = __commonJS({
  ".generated/engine-task-completion.js"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root = inputRoot;
      const B = typeof module2 !== "undefined" && module2.exports ? require_balancing_rules() : globalThis.LWBalanceRules;
      function install(target) {
        const { RES, SKILLS, BUILDINGS, RECIPES, CONTRACTS } = root.LWContent.tables;
        const clamp = (n, a, b) => Math.max(a, Math.min(b, n));
        const methods = {
          finishTask(t) {
            const s = this.s, n = s.needs, o = s.orders.find((o2) => o2.id === t.orderId), usedSkill = this.taskSkill(t);
            let achievement = false;
            if (t.kind === "gather") {
              const node = t.nodeId === "garden" ? s.buildings.find((b) => b.kind === "garden") : s.nodes.find((n2) => n2.id === t.nodeId);
              let amount = t.resource === "water" ? 3 : Math.min(t.resource === "stone" ? 2 : 3, node?.stock ?? 0);
              if (o?.type === "gather" && o.resource === t.resource)
                amount = Math.min(amount, o.amount - o.done);
              if (amount <= 0) {
                s.task = null;
                return;
              }
