  const current = node_fs_1.default.existsSync(target) ? Buffer.from((0, cli_io_cjs_1.readBytesFile)(target, ARTIFACT_MAX_BYTES)) : null;
  if (current && current.equals(Buffer.from(artifact.html, "utf8"))) {
    (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, check: target, current: true, ...summary });
    return;
  }
  const actual = current ? { bytes: current.length, sha256: (0, node_crypto_1.createHash)("sha256").update(current).digest("hex") } : null;
  (0, cli_io_cjs_1.emit)({
    ok: false,
    protocolVersion: 1,
    code: "stale-artifact",
    check: target,
    current: false,
    actual,
    ...summary,
    errors: [`${target} is ${current ? "stale" : "missing"}; rebuild it with wildlands build-game --game ${directory} --output ${check}${kind === "studio" ? " --profile studio" : ""}.`]
  });
  process.exitCode = 1;
}
async function run(args) {
  if (args[0] === "process") {
    require_process_cli().run(args.slice(1));
    return;
  }
  const command = args[0];
  try {
    if (args.length === 0 || args.length === 1 && ["--help", "-h"].includes(command)) {
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, usage, handbook });
      return;
    }
    if (args.length === 1 && command === "--version") {
      const manifest = require_package();
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, name: manifest.name, version: manifest.version });
      return;
    }
    if (!command || !Object.hasOwn(allowed, command))
      throw Error("Unknown operation. " + usage);
    const values = options(args.slice(1), allowed[command]);
    const required = (flag) => {
      const value = values.get(flag);
      if (!value)
        throw Error("Missing required option: " + flag);
      return value;
    };
    if (command === "validate-game" || command === "inspect-game" || command === "build-game") {
      gameCommand(command, values);
      return;
    }
    const folder = values.get("--game");
    if (["scenarios", "create"].includes(command) && folder === void 0)
      throw gameRequired(command);
    if (command === "upgrade" && folder === void 0)
      throw gameRequired("upgrade");
    const opened = ["discover", "scenarios", "create"].includes(command) ? null : openProject(required("--project"), folder);
    const installed = opened ? null : folder !== void 0 ? installFolder(folder) : null;
    const SDK = require_wildlands_project_sdk();
    if (command === "discover") {
      const found = SDK.discover();
      (0, cli_io_cjs_1.emit)({ ok: true, ...found, game: installed ? found.game : null });
      return;
    }
    if (command === "scenarios") {
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, game: installed.id, digest: installed.digest, defaultScenario: SDK.projects.discover().game?.defaultScenario, scenarios: SDK.projects.scenarios() });
      return;
    }
    if (command === "create") {
      const config = {};
      for (const [flag, key] of [["--id", "id"], ["--name", "name"], ["--scenario", "scenarioId"], ["--scene", "sceneId"]]) {
        const value = values.get(flag);
        if (value !== void 0)
          config[key] = value;
      }
      const packFile = values.get("--pack");
      if (packFile) {
        const checkedPack = require_scenario_runtime().validate((0, cli_io_cjs_1.readJsonFile)(packFile, 8 * 1024 * 1024));
        if (!checkedPack.ok)
          throw Error(checkedPack.errors.join("\n"));
        config.pack = checkedPack.pack;
      }
      const created = SDK.projects.create(config), output = (0, cli_io_cjs_1.writeJsonFile)(required("--output"), created, packFile ? [packFile] : []);
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, output, projectId: created.id, schemaVersion: created.schemaVersion, gameId: created.game.id, gameDigest: installed.digest, scenarioId: created.scenarioId, sceneId: created.sceneId });
      return;
    }
    const input = required("--project"), checked = SDK.projects.validate(opened.text);
    if (!checked.ok) {
      (0, cli_io_cjs_1.emit)({ ok: false, protocolVersion: 1, code: "invalid-project", errors: checked.errors });
      process.exitCode = 1;
      return;
    }
    const loaded = checked.project, gameId = opened.gameId;
    if (command === "validate") {
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, fingerprint: checked.fingerprint, projectId: loaded.id, schemaVersion: loaded.schemaVersion, gameId, scenarioId: loaded.scenarioId, sceneId: loaded.sceneId });
      return;
    }
    if (command === "inspect") {
      const inspected = SDK.inspectProject(loaded);
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, projectId: loaded.id, schemaVersion: loaded.schemaVersion, gameId, scenarioId: loaded.scenarioId, sceneId: loaded.sceneId, fingerprint: inspected.fingerprint, snapshot: inspected.snapshot, connections: inspected.connections });
      return;
    }
    if (command === "upgrade") {
      const next = SDK.projects.upgrade(loaded), output = (0, cli_io_cjs_1.writeJsonFile)(required("--output"), next, [input]);
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, output, projectId: next.id, schemaVersion: next.schemaVersion, gameId: next.game.id, fingerprint: SDK.projects.validate(next).fingerprint, scenarioId: next.scenarioId, sceneId: next.sceneId });
      return;
    }
    if (command === "scenario") {
      const next = SDK.projects.select(loaded, required("--scenario"), values.get("--scene")), output = (0, cli_io_cjs_1.writeJsonFile)(required("--output"), next, [input]);
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, output, schemaVersion: next.schemaVersion, scenarioId: next.scenarioId, sceneId: next.sceneId });
      return;
    }
    if (command === "run" || command === "edit") {
      const recipeFile = required("--recipe"), recipe = (0, cli_io_cjs_1.readJsonFile)(recipeFile, 1024 * 1024);
      const result2 = command === "run" ? SDK.runProject(loaded, recipe) : SDK.editProject(loaded, recipe);
      const output = (0, cli_io_cjs_1.writeJsonFile)(required("--output"), result2.project, [input, recipeFile]);
      const { project: _, ...details } = result2;
      (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, output, schemaVersion: result2.project.schemaVersion, scenarioId: result2.project.scenarioId, sceneId: result2.project.sceneId, ...details });
      return;
    }
    const writer = require_wildlands_godot_writer();
    const compiled = SDK.projects.upgrade(loaded);
    const result = await writer.writeGodotProject(compiled, required("--output"), { withEngineSources: values.has("--with-engine-sources") });
    (0, cli_io_cjs_1.emit)({ ok: true, protocolVersion: 1, ...result });
  } catch (error) {
    const known = error instanceof CliError ? error : null;
    (0, cli_io_cjs_1.emit)({ ok: false, protocolVersion: 1, code: known?.code ?? "operation-failed", errors: [error instanceof Error ? error.message : String(error)], ...known?.details });
    process.exitCode = known?.exit ?? 2;
  }
}
if (require.main === module)
  void run(process.argv.slice(2));
