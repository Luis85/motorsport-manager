      function order(e, buildingId, floorId, stationId, recipe, batches) {
        if (typeof buildingId !== "string" || typeof floorId !== "string" || typeof stationId !== "string" || typeof recipe !== "string" || typeof batches !== "number" || !Number.isInteger(batches) || batches < 1 || batches > 12)
          return fail("Choose a workstation, recipe and 1\u201312 batches.");
        const b = e.s.buildings.find((b2) => b2.id === buildingId), f = b && C.floor(C.forBuilding(e.s, b), floorId);
