            } else if (t.kind === "hunt") {
              s.inventory.meat += 2;
              s.inventory.fiber++;
              n.energy = clamp(n.energy - B.forEngine(this).completion.huntEnergy, 0, 100);
              this.xp("creature", B.forEngine(this).completion.huntActorXp);
              this.xp("player", B.forEngine(this).completion.craftPlayerXp);
