          return Object.freeze({ id: v.id, presetId: v.presetId, start: numeric("start", 0, 86400), duration: numeric("duration", 1e-3, 86400), x: numeric("x", -1e4, 1e4), y: numeric("y", -1e4, 1e4), radius: numeric("radius", 1, 1e3), color: v.color, count, ...seed === void 0 ? {} : { seed } });
        });
        return Object.freeze(result);
      }
      const hash = (value) => {
        let result = 2166136261;
        for (const character of value)
          result = Math.imul(result ^ character.codePointAt(0), 16777619);
        return result >>> 0;
      };
      function create(canvas) {
        const P5 = root.p5;
        if (!P5)
          throw Error("Pinned p5.js 2.3.4 is unavailable.");
        const parent = canvas.parentElement;
        if (!parent)
          throw Error("Mount the animation canvas before creating its layer.");
        let disposed = false, initialized = false, busy = false, emptyPainted = false, removal = null, request = null;
        let setupStarted = false, resolveSetup = () => {
        };
        const setupReached = new Promise((resolve) => {
          resolveSetup = resolve;
        });
        let resolveReady = () => {
        };
        const ready = new Promise((resolve) => {
          resolveReady = resolve;
        });
        let hookArray = null, prefix = [], ownedHook = null, ownedMarker = null, hookRan = false, captureAttempted = false, configured = null;
        function captureHook(p) {
          if (captureAttempted || !hookArray)
            return;
          captureAttempted = true;
          if (P5?.lifecycleHooks?.remove !== hookArray || !prefix.every((hook2, index) => hookArray?.[index] === hook2))
            return;
          const hook = hookArray[prefix.length];
          if (typeof hook !== "function")
            return;
          ownedHook = hook;
          ownedMarker = function() {
            if (this === p && !hookRan) {
              hookRan = true;
              hook.call(p);
            }
          };
          hookArray[prefix.length] = ownedMarker;
        }
        function releaseHook(p) {
          try {
            if (ownedHook && !hookRan) {
              hookRan = true;
              ownedHook.call(p);
            }
          } finally {
            if (hookArray && ownedMarker) {
              const index = hookArray.indexOf(ownedMarker);
              if (index >= 0)
                hookArray.splice(index, 1);
            }
          }
        }
        async function releaseSketch(p) {
          const errors = [];
          try {
            await p.remove();
          } catch (error) {
            errors.push(error);
          }
          try {
            releaseHook(p);
          } catch (error) {
            errors.push(error);
          }
          if (errors.length)
            throw new AggregateError(errors, "p5 animation resource release failed.");
        }
        let sketch;
        try {
