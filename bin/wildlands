      }
      function construct(e, input, x, y) {
        return submit(e, input, x, y);
      }
      function improve(e, id, input) {
        const b = e.s.buildings.find((b2) => b2.id === id);
        return b ? submit(e, input, b.x, b.y, b) : fail("This building is no longer here.");
      }
