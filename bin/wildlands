            } else if (t.kind === "shop")
              this.practiceSkill(usedSkill);
            this.checkWish();
            if (o && o.type !== "build" && (o.done || 0) >= o.amount) {
              s.orders = s.orders.filter((a) => a.id !== o.id);
              this.emit("done", "An idea became a little achievement.");
