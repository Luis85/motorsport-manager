          if (t && !t.orderId && !["train", "equip", "unpack"].includes(t.kind) && !t.saleId && !t.buffered && !(c.equipQueue.length && ["withdraw", "gearcraft"].includes(t.kind)) && !["social", "socialwait"].includes(t.kind) && !(t.kind === "deposit" && c.needsDeposit))
            out.push({ ...common, key: key("activity", c.id, t.kind), type: "activity", id: t.kind, system: t.need ? "Self-care" : ["stockbuilding", "collectbuilding", "emptybuilding", "deposit", "withdraw"].includes(t.kind) ? "Logistics" : "Autonomous", name: t.label || t.kind, state: t.phase === "walk" ? "Walking" : "In progress", detail: t.reason || "Creature-led activity. Tasks may recur if still needed.", priority: 0, paused: false, progress: t.elapsed / t.duration, protected: !!t.need || ["rest", "eat", "drink", "eatbread", "calmdown"].includes(t.kind) });
        }
        for (const b of e.s.buildings) {
