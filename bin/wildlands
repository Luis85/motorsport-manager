              if (o)
                o.progress = Math.min(task.duration, task.elapsed);
            }
            if (task.kind === "train" && s.training)
              s.training.progress = Math.min(task.duration, task.elapsed);
            if (task.kind === "practice") {
              const o = s.orders.find((o2) => o2.id === task.orderId);
              if (o)
                o.progress = Math.min(task.duration, task.elapsed);
            }
