      }
      function roomProject(point, view) {
        return { x: view.origin.x + (point.x - point.y) * view.unit / 2, y: view.origin.y + (point.x + point.y - (point.height ?? 0)) * view.unit / 4 };
      }
      function project(tile, frame) {
        const room = roomLayout(frame);
        if (room)
          return roomProject(tile, room);
        const view = layout(frame), x = tile.x - view.cx, y = tile.y - view.cy;
        const height = tile.height ?? frame.tiles.find((value) => value.x === Math.round(tile.x) && value.y === Math.round(tile.y))?.height ?? 0;
        return { x: view.x + (x - y) * view.unit / 2, y: view.y + (x + y - height) * view.unit / 4 };
      }
      function inverse(point, origin, unit, cx = 0, cy = 0) {
        const a = (point.x - origin.x) / (unit / 2), b = (point.y - origin.y) / (unit / 4);
        return { x: Math.round(cx + (a + b) / 2), y: Math.round(cy + (b - a) / 2) };
      }
      function toTile(point, frame) {
        const room = roomLayout(frame);
        if (room)
          return inverse(point, room.origin, room.unit);
        const view = layout(frame), tiles = frame.tiles.filter((tile) => inside(tile, frame)).slice().sort((a, b) => b.x + b.y - a.x - a.y);
