        if (!land.ok)
          throw Error(land.errors.join("\n"));
        const growth = C.registry.withLibrary(content.candidate, () => withAdventure(expansion.content, () => G.validate(preview.growth || G.defaults)));
        if (!growth.ok)
          throw Error(growth.errors.join("\n"));
