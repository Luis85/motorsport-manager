var require_wildlands_embedded_resources = __commonJS({
  "wildlands-embedded-resources:wildlands-embedded-resources"(exports2) {
    "use strict";
    var { inflateRawSync } = require("node:zlib");
    var { createHash } = require("node:crypto");
    var RUNTIME = { "bytes": 1443077, "sha256": "f99e9242c47480dc9f0943813b5a87037914f1ebd8ecdd48437c750e02e7c96c", "data": "" };
    var ENGINE = { "bytes": 25973480, "sha256": "fb37eda2c7135fa4777e5952247aa234371b9975185e0f278a720547fde7ecb1", "data": "" };
    var KIT = { "bytes": 7185306, "sha256": "e54226c3d1e8c78d67975cd55982a69d30c5383ec891d5badcab253d10e87677", "data": "" };
    function inflate(item) {
      const raw = inflateRawSync(Buffer.from(item.data, "base64"), { maxOutputLength: item.bytes });
      if (raw.length !== item.bytes || createHash("sha256").update(raw).digest("hex") !== item.sha256)
        throw Error("Embedded Wildlands resource integrity failed. Rebuild bin/wildlands.");
      return new TextDecoder("utf-8", { fatal: true }).decode(raw);
    }
    exports2.engineSourceText = () => inflate(ENGINE);
    exports2.runtimeText = () => inflate(RUNTIME);
    exports2.kitText = () => inflate(KIT);
  }
});

