          return "Node exhausted";
        if (recipe && engine.remaining(node) < recipe.depletion)
          return "Insufficient deposit remaining";
        return null;
      }
      function validateIdentities(state) {
        const W = root.LWWorldContent;
        if (!W)
          throw Error("World content runtime missing.");
