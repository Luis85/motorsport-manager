        const order = { id: "o" + e.s.nextId++, type: replacing ? "upgrade" : "build", kind: design.kind, x, y, designId: id, stage: 0, progress: 0, paid: false, paused: false, priority: 0, created: e.s.simTime, approach: e.actor.buildPolicy.approach, ...replacing ? { buildingId: replacing.id, targetLevel: Math.min(3, replacing.level + 1) } : {} };
        e.actor.orders.push(order);
