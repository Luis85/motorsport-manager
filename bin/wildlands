          assessResource(resource, amount, seen = /* @__PURE__ */ new Set()) {
            if (this.s.inventory[resource] >= amount)
              return null;
            if (seen.has(resource))
              return { text: "A circular recipe needs attention." };
            const skill = this.missingSkill(resource);
            if (skill)
              return { text: "Teach " + SKILLS[skill].short, skill };
