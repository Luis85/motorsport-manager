        const personalities = Object.freeze([...new Set(first.definitions.flatMap((definition2) => [...definition2.personalities]))]);
        return installed = { defaults, declaredPersonalFields, personalFields, personalities };
      }
      const active = () => {
        load2();
        return prepared;
      };
      function replace(input) {
        const { declaredPersonalFields } = load2(), next = prepare(input);
        for (const def of next.definitions) if (def.state.personalFields.some((field) => !declaredPersonalFields.includes(field)) || declaredPersonalFields.some((field) => !def.state.personalFields.includes(field))) fail("scenario creatures must retain the supported personal fields");
        prepared = next;
      }
      function withDefinitions(input, work) {
        const previous = active();
        try {
          replace(input);
          const result2 = work();
          if (result2 && typeof result2.then === "function") throw Error("Creature scope must be synchronous.");
          return result2;
        } finally {
          prepared = previous;
        }
      }
      function all() {
        return active().definitions;
      }
      function get(id) {
        return active().byId.get(id) || null;
      }
      function definition(id) {
        return active().byId.get(id) ?? fail("unknown creature archetype " + id);
      }
      function supports(archetype, personality) {
        return !!active().byId.get(archetype)?.personalities.includes(personality);
      }
      function componentBindings(archetype) {
        return definition(archetype).ecs.components;
      }
      function seed(archetype, personality, mode, sequence) {
        if (mode !== "founder" && mode !== "arrival") fail("invalid creature mode");
        if (!Number.isSafeInteger(sequence) || sequence < 0) fail("invalid creature sequence");
        const def = definition(archetype);
        if (!def.personalities.includes(personality)) fail(archetype + " does not support personality " + personality);
        const state = merge(def.state.defaults, def.state.modes[mode]);
        state.archetype = def.id;
        state.personality = personality;
        state.name = def.names[sequence % def.names.length];
        const rpg = record(state.rpg, def.id + " RPG state");
        rpg.rng = def.rng.base + Math.imul(sequence, def.rng.stride) >>> 0;
        return state;
      }
      const api = Object.freeze({
        get configuration() {
          return active().configuration;
        },
        get revision() {
          return active().revision;
        },
        get defaults() {
          return load2().defaults;
        },
        get defaultArchetype() {
          return active().configuration.defaultArchetype;
        },
        get defaultPersonality() {
          return definition(active().configuration.defaultArchetype).defaultPersonality;
        },
        get personalFields() {
          return load2().personalFields;
        },
        optionalPersonalFields,
        get personalities() {
          return load2().personalities;
        },
        all,
        get,
        supports,
        componentBindings,
        seed,
        validate,
        replace,
        withDefinitions
      });
      Content.whenInstalled(() => {
        load2();
      }, "creatures");
      root2.LWCreatures = api;
      if (node) module2.exports = api;
    })(globalThis);
  }
});

