var soft = (id, position, scale, material) => ({ id, primitive: "mesh", mesh: "studio-soft", position, scale, material });
function refineCompanionOutfit(item, nodes) {
  if (item === "trail_cap") {
    nodes.splice(
      0,
      nodes.length,
      soft("crown", [0, 0.014, -0.016], [0.229, 0.02, 0.186], "primary"),
      soft("cap", [0, 0.059, -0.03], [0.213, 0.088, 0.169], "primary"),
      soft("brim", [0, 0.011, 0.153], [0.169, 0.018, 0.103], "primary"),
      soft("cap-button", [0, 0.145, -0.03], [0.013, 6e-3, 0.013], "dark"),
      { ...soft("leaf-left", [-0.017, 0.086, 0.137], [0.011, 0.024, 4e-3], "light"), rotation: [0, 0, -0.65] },
      { ...soft("leaf-right", [0.01, 0.094, 0.137], [0.011, 0.026, 4e-3], "light"), rotation: [0, 0, 0.5] }
    );
  }
  if (item === "walking_boots" || item === "swift_shoes") {
    const sole = nodes.find((node) => node.id === "sole");
    if (sole) Object.assign(sole, soft("sole", [0, -0.07, 0.044], [0.113, 0.014, 0.155], "dark"));
  }
  if (item === "field_satchel") {
    nodes.splice(
      0,
      nodes.length,
      soft("pack", [-0.205, -0.07, 0.38], [0.1, 0.115, 0.041], "primary"),
      soft("flap", [-0.205, -0.016, 0.426], [0.099, 0.052, 0.011], "primary"),
      soft("buckle", [-0.205, -0.024, 0.439], [0.016, 0.022, 6e-3], "metal"),
      { ...soft("strap", [-0.064, 0.065, 0.432], [0.014, 0.19, 8e-3], "dark"), rotation: [0, 0, -0.6] }
    );
  }
  if (item === "woodland_vest") {
    nodes.splice(
      0,
      nodes.length,
      soft("vest-back", [0, 9e-3, -0.127], [0.228, 0.163, 0.082], "primary"),
      { ...soft("vest-left", [-0.144, 0.015, 0.114], [0.077, 0.152, 0.071], "primary"), rotation: [0, -0.35, -0.1] },
      { ...soft("vest-right", [0.144, 0.015, 0.114], [0.077, 0.152, 0.071], "primary"), rotation: [0, 0.35, 0.1] },
      soft("button-a", [-0.081, 0.065, 0.175], [0.012, 0.012, 7e-3], "metal"),
      soft("button-b", [-0.083, -0.012, 0.174], [0.012, 0.012, 7e-3], "metal")
    );
  }
}
function companionOutfitMaterial(item, role, material) {
  if (!["primary", "light", "dark"].includes(role)) return material;
  const kind = ["walking_boots", "swift_shoes", "field_satchel"].includes(item) ? "leather" : ["trail_cap", "stargazer_hat", "woodland_vest", "rain_cape"].includes(item) ? "cloth" : null;
  if (!kind) return material;
  return {
    ...typeof material === "string" ? { color: material } : material,
    roughness: kind === "cloth" ? 0.94 : 0.78,
    flatShading: false,
    surface: { kind, seed: kind === "cloth" ? 19 : 23, scale: kind === "cloth" ? 5 : 4, strength: 0.2 }
  };
}

// src/application/plush-meshes.ts
var round = (value) => Math.round(value * 1e6) / 1e6;
function surface(profile, segments = 24, rings = 16, shape = (x, y, z) => [x, y, z]) {
  const positions = [0, 1, 0], indices = [];
  for (let row = 1; row < rings; row++) {
    const latitude = Math.PI * row / rings;
    const y = Math.cos(latitude), radius = Math.sin(latitude) * profile(y);
    for (let column = 0; column < segments; column++) {
      const angle = 2 * Math.PI * column / segments;
      positions.push(round(radius * Math.cos(angle)), round(y), round(radius * Math.sin(angle)));
    }
  }
  const bottom = positions.length / 3;
  positions.push(0, -1, 0);
  for (let column = 0; column < segments; column++) {
    const next = (column + 1) % segments;
    indices.push(0, 1 + next, 1 + column);
    for (let row = 0; row < rings - 2; row++) {
      const a = 1 + row * segments + column, b = 1 + row * segments + next;
      const c = a + segments, d = b + segments;
      indices.push(a, b, c, b, d, c);
    }
    indices.push(bottom, 1 + (rings - 2) * segments + column, 1 + (rings - 2) * segments + next);
  }
  for (let vertex = 0; vertex < positions.length; vertex += 3) {
    const transformed = shape(positions[vertex], positions[vertex + 1], positions[vertex + 2]);
    for (let axis = 0; axis < 3; axis++) positions[vertex + axis] = round(transformed[axis]);
  }
  const normals = new Array(positions.length).fill(0);
  for (let index2 = 0; index2 < indices.length; index2 += 3) {
    const [a, b, c] = indices.slice(index2, index2 + 3).map((n) => n * 3);
    const ab = [0, 1, 2].map((k) => positions[b + k] - positions[a + k]);
    const ac = [0, 1, 2].map((k) => positions[c + k] - positions[a + k]);
    const normal = [ab[1] * ac[2] - ab[2] * ac[1], ab[2] * ac[0] - ab[0] * ac[2], ab[0] * ac[1] - ab[1] * ac[0]];
    for (const vertex of [a, b, c])
      for (let axis = 0; axis < 3; axis++) normals[vertex + axis] += normal[axis];
  }
  for (let vertex = 0; vertex < normals.length; vertex += 3) {
    const length = Math.hypot(...normals.slice(vertex, vertex + 3));
    for (let axis = 0; axis < 3; axis++) normals[vertex + axis] = round(normals[vertex + axis] / length);
  }
  return { positions, normals, indices };
}
function plushMeshes() {
  return {
    "studio-soft": surface(() => 1),
    "studio-cheek": surface((y) => 1 - 0.12 * y, 32, 20),
    "studio-pear": surface((y) => 1 - 0.18 * y, 20, 14),
    "studio-ear": surface((y) => 0.75 - 0.34 * y, 16, 12),
    "studio-smile": surface(() => 1, 16, 8, (x, y, z) => [x, 0.3 * y + 0.65 * x * x - 0.3, z]),
    "studio-brow": surface(() => 1, 12, 6, (x, y, z) => [x, 0.25 * y + 0.35 * (1 - x * x), z])
  };
}

// src/application/companion-cheeks.ts
function cheekPatch(side) {
  return surface(() => 1, 16, 8, (x, y, z) => {
    const px = side * 0.184 + x * 0.036;
    const py = -0.071 + y * 0.024;
    const latitude = py / 0.236;
    const radius = Math.sqrt(1 - latitude * latitude) * (1 - 0.13 * latitude);
    const headZ = 0.22 * Math.sqrt(radius * radius - (px / 0.285) ** 2);
    return [px, py, headZ + 18e-4 + z * 7e-4];
  });
}

// src/application/companion-uvs.ts
var round2 = (value) => Math.round(value * 1e6) / 1e6;
function withSphericalUvs(mesh) {
  const result2 = { positions: [], normals: [], indices: [], uvs: [] };
  const vertices = /* @__PURE__ */ new Map();
  for (let i = 0; i < mesh.indices.length; i += 3) {
    const corners = mesh.indices.slice(i, i + 3).map((index2) => {
      const [x, y, z] = mesh.positions.slice(index2 * 3, index2 * 3 + 3);
      return {
        index: index2,
        pole: Math.hypot(x, z) < 1e-7,
        u: Math.atan2(z, x) / (2 * Math.PI) + 0.5,
        v: 0.5 - Math.asin(Math.max(-1, Math.min(1, y / Math.hypot(x, y, z)))) / Math.PI
      };
    });
    const ring = corners.filter((corner) => !corner.pole);
    if (Math.max(...ring.map((corner) => corner.u)) - Math.min(...ring.map((corner) => corner.u)) > 0.5) {
      for (const corner of ring) if (corner.u > 0.5) corner.u -= 1;
    }
    for (const corner of corners) {
      if (corner.pole) corner.u = ring.reduce((sum, value) => sum + value.u, 0) / ring.length;
      const u = round2(corner.u), v = round2(corner.v);
      const key = `${corner.index}:${u}:${v}`;
      let index2 = vertices.get(key);
      if (index2 === void 0) {
        index2 = result2.positions.length / 3;
        vertices.set(key, index2);
        result2.positions.push(...mesh.positions.slice(corner.index * 3, corner.index * 3 + 3));
        result2.normals.push(...mesh.normals.slice(corner.index * 3, corner.index * 3 + 3));
        result2.uvs.push(u, v);
      }
      result2.indices.push(index2);
    }
  }
  return result2;
}

// src/application/companion-model.ts
function piece(id, position, scale, material, mesh = "studio-soft") {
  return { primitive: "mesh", id, position, scale, material, mesh };
}
function rounded(node, mesh = "studio-soft") {
  node.primitive = "mesh";
  node.mesh = mesh;
}
function eyes(node) {
  const side = node.id === "eye-left" ? -1 : 1;
  node.position = [side * 0.105, 0.01, 0.207];
  node.rotation = [0, side * 0.3, side * -0.1];
  node.children = [
    piece(`${node.id}-rim`, [0, 3e-3, -1e-3], [0.054, 0.059, 0.014], "eyeRim", "studio-almond"),
    piece(`${node.id}-white`, [0, -2e-3, 3e-3], [0.052, 0.057, 0.014], "eyeWhite", "studio-almond"),
    piece(`${node.id}-pupil`, [-side * 6e-3, 1e-3, 0.016], [0.034, 0.045, 7e-3], "pupil"),
    piece(`${node.id}-depth`, [-side * 6e-3, 5e-3, 0.022], [0.018, 0.026, 4e-3], "eyeDepth"),
    piece(`${node.id}-glint`, [-0.014, 0.023, 0.026], [7e-3, 9e-3, 2e-3], "catchlight")
  ];
}
function face(node) {
  if (node.id === "head-shell") {
    rounded(node, "studio-cheek");
    node.scale = [0.285, 0.236, 0.22];
  }
  if (node.id === "muzzle-left" || node.id === "muzzle-right") {
    node.position = [0, -0.085, 0.168];
    node.scale = [0.16, 0.09, 0.049];
    if (node.id === "muzzle-right") node.visible = false;
  }
  if (node.id === "cheek-left" || node.id === "cheek-right") {
    const side = node.id === "cheek-left" ? -1 : 1;
    rounded(node, side === -1 ? "studio-blush-left" : "studio-blush-right");
    node.position = [0, 0, 0];
    node.scale = [1, 1, 1];
    node.rotation = [0, 0, 0];
    node.material = "blush";
  }
  if (node.id === "brow-left" || node.id === "brow-right") {
    const side = node.id === "brow-left" ? -1 : 1;
    rounded(node, "studio-brow");
    node.position = [side * 0.106, 0.084, 0.184];
    node.scale = [0.036, 0.022, 6e-3];
    node.rotation = [0, side * 0.22, side * -0.07];
    node.material = "brow";
  }
  if (node.id === "nose") {
    rounded(node, "studio-nose");
    node.position = [0, -0.061, 0.222];
    node.scale = [0.023, 0.016, 0.015];
  }
  if (node.id === "mouth") {
    node.position = [0, -0.088, 0.215];
    node.children = [
      piece("mouth-left", [-0.014, 0, 0], [0.018, 0.012, 3e-3], "mouthDark", "studio-smile"),
      piece("mouth-right", [0.014, 0, 0], [0.018, 0.012, 3e-3], "mouthDark", "studio-smile"),
      piece("mouth-philtrum", [0, 0.012, 3e-3], [25e-4, 0.011, 2e-3], "mouthDark")
    ];
  }
  if (node.id === "eye-left" || node.id === "eye-right") eyes(node);
}
function tufts(head) {
  for (let index2 = 0; index2 < 4; index2++) {
    const x = -0.041 + index2 * 0.025;
    const tuft = piece(`crown-wisp-${index2}`, [x, 0.182 - Math.abs(x) * 0.17, -2e-3], [0.019, 0.03 + index2 % 2 * 5e-3, 0.019], "fur");
    tuft.rotation = [0, 0, -0.65 + index2 * 0.1];
    head.children.push(tuft);
  }
  for (const side of [-1, 1])
    for (let index2 = 0; index2 < 4; index2++) {
      const tuft = piece(`cheek-wisp-${side < 0 ? "left" : "right"}-${index2}`, [side * (0.255 - index2 * 8e-3), -0.04 - index2 * 0.027, 8e-3], [0.019, 0.031, 0.024], "fur", "studio-tuft");
      tuft.rotation = [0, 0, side * -1.22];
      head.children.push(tuft);
    }
}
function body(node) {
  if (node.id === "torso") {
    rounded(node, "studio-pear");
    node.position = [0, 0.302, 0];
    node.scale = [0.231, 0.253, 0.202];
  }
  if (node.id === "bib") {
    rounded(node, "studio-pear");
    node.position = [0, 0.293, 0.148];
    node.scale = [0.166, 0.198, 0.07];
  }
  if (node.id === "head") {
    node.position = [0, 0.639, 0.04];
    tufts(node);
  }
  if (/^arm-(left|right)$/.test(node.id)) {
    const side = node.id === "arm-left" ? -1 : 1;
    node.position = [side * 0.212, 0.417, 0.02];
    node.rotation = [0.12, 0, side * -0.2];
  }
  if (/^arm-(left|right)-upper$/.test(node.id)) {
    node.position = [0, -0.052, 0.014];
    node.scale = [0.076, 0.105, 0.077];
  }
  if (/^arm-(left|right)-paw$/.test(node.id)) {
    node.position = [0, -0.114, 0.048];
    node.scale = [0.073, 0.065, 0.073];
    node.material = "fur";
  }
  if (/^foot-(left|right)$/.test(node.id)) node.scale = [0.096, 0.074, 0.129];
}
function ears(node, variant) {
  if (!node.id?.startsWith("ear-") || !/-(outer|inner)$/.test(node.id)) return;
  const inner = node.id.endsWith("-inner");
  if (variant === "world-pointed") {
    rounded(node, "studio-ear");
    node.scale = inner ? [0.069, 0.118, 0.012] : [0.104, 0.164, 0.063];
    node.position = [0, 0.06, inner ? 0.05 : 0];
  } else if (variant === "world-round") {
    if (!inner) rounded(node, "studio-ear-cup");
    node.scale = inner ? [0.058, 0.064, 9e-3] : [0.094, 0.097, 0.068];
    node.position = [0, 0.043, inner ? 0.035 : 0];
  } else {
    rounded(node, "studio-ear");
    node.scale = inner ? [0.041, 0.171, 0.013] : [0.062, 0.217, 0.057];
    node.position = [0, 0.121, inner ? 0.046 : 0];
  }
}
function sculpt(nodes, variant) {
  for (const node of nodes) {
    if (node.primitive === "soft" || node.primitive === "ball") rounded(node);
    body(node);
    ears(node, variant);
    face(node);
    if (node.children) sculpt(node.children, variant);
  }
}
function sculptCompanionModel(visual) {
  visual.meshes = {
    "studio-blush-left": cheekPatch(-1),
    "studio-blush-right": cheekPatch(1),
    "studio-soft": surface(() => 1, 24, 16),
    "studio-cheek": surface((y) => 1 - 0.13 * y, 32, 20, (x, y, z) => [x, y > 0 ? y * 0.81 : y, z]),
    "studio-pear": surface((y) => 1 - 0.24 * y, 24, 16),
    "studio-ear": surface((y) => 0.8 - 0.29 * y, 20, 14),
    "studio-ear-cup": surface(() => 1, 24, 16, (x, y, z) => [x, y, z > 0 ? z - 0.65 * Math.max(0, 1 - (x * x + y * y) / 0.6) ** 2 : z]),
    "studio-almond": surface(() => 1, 24, 16, (x, y, z) => [x * (1 - 0.12 * y), y, z]),
    "studio-nose": surface((y) => 0.72 + 0.35 * y, 16, 10),
    "studio-tuft": surface((y) => 0.66 - 0.38 * y, 12, 8),
    "studio-smile": surface(() => 1, 16, 8, (x, y, z) => [x, 0.2 * y + 0.6 * x * x - 0.25, z]),
    "studio-brow": surface(() => 1, 16, 8, (x, y, z) => [x, 0.2 * y + 0.42 * (1 - x * x), z])
  };
  for (const [name, mesh] of Object.entries(visual.meshes))
    visual.meshes[name] = withSphericalUvs(mesh);
  for (const role of ["fur", "light"]) visual.materials[role] = {
    color: visual.materials[role],
    roughness: 0.96,
    metalness: 0,
    flatShading: false,
    sheen: 0.75,
    sheenRoughness: 1,
    sheenColor: "#fff0d8",
    surface: { kind: "fur", seed: 17, scale: 3, strength: 0.35 }
  };
  visual.materials.inner = {
    color: visual.materials.inner,
    roughness: 1,
    flatShading: false,
    surface: { kind: "fur", seed: 17, scale: 3, strength: 0.22 }
  };
  visual.materials.pupil = { color: visual.materials.pupil, roughness: 0.42, flatShading: false, clearcoat: 0.3, clearcoatRoughness: 0.3 };
  visual.materials.eyeRim = { color: "#654438", roughness: 0.9, flatShading: false };
  visual.materials.eyeDepth = { color: "#35251c", roughness: 0.45, flatShading: false };
  visual.materials.eyeWhite = { color: "#fff4db", roughness: 0.6, flatShading: false };
  visual.materials.catchlight = { color: "#fffaf1", roughness: 1, flatShading: false, emissive: "#fffaf1", emissiveIntensity: 0.18 };
  visual.materials.nose = { color: "#624032", roughness: 0.45, flatShading: false, clearcoat: 0.15, clearcoatRoughness: 0.4 };
  visual.materials.brow = { color: "#98714f", roughness: 1, flatShading: false };
  visual.materials.blush = {
    color: "#cda184",
    roughness: 1,
    flatShading: false,
    surface: { kind: "fur", seed: 17, scale: 3, strength: 0.35 }
  };
  visual.materials.mouthDark = { color: "#684434", roughness: 1, flatShading: false };
  for (const [name, model] of Object.entries(visual.models)) sculpt(model.nodes, name);
}

// src/application/plush-model.ts
function rounded2(node, mesh = "studio-soft") {
  node.primitive = "mesh";
  node.mesh = mesh;
}
function piece2(id, position, scale, material, mesh = "studio-soft") {
  return { primitive: "mesh", id, position, scale, material, mesh };
}
function sculptEye(node) {
  const side = node.id === "eye-left" ? -1 : 1;
  node.position = [side * 0.106, 0.022, 0.204];
  node.rotation = [0, side * 0.18, side * -0.055];
  node.children = [
    piece2(`${node.id}-white`, [0, 0, 0], [0.064, 0.076, 0.035], "eyeRim"),
    piece2(`${node.id}-pupil`, [0, -7e-3, 0.023], [0.05, 0.06, 0.021], "pupil"),
    piece2(`${node.id}-depth`, [0, 3e-3, 0.039], [0.033, 0.048, 0.01], "eyeDepth"),
    piece2(`${node.id}-glint`, [-0.017, 0.027, 0.045], [0.015, 0.02, 6e-3], "eyeWhite"),
    piece2(`${node.id}-spark`, [0.019, -0.032, 0.044], [5e-3, 6e-3, 3e-3], "eyeWhite")
  ];
}
function sculptFace(node) {
  if (node.id === "head-shell") {
    rounded2(node, "studio-cheek");
    node.scale = [0.286, 0.249, 0.237];
  }
  if (node.id === "muzzle-left" || node.id === "muzzle-right") {
    const side = node.id === "muzzle-left" ? -1 : 1;
    node.position = [side * 0.066, -0.083, 0.192];
    node.scale = [0.112, 0.078, 0.07];
  }
  if (node.id === "cheek-left" || node.id === "cheek-right") {
    const side = node.id === "cheek-left" ? -1 : 1;
    node.position = [side * 0.198, -0.057, 0.166];
    node.scale = [0.041, 0.024, 0.014];
    node.rotation = [0, side * 0.5, side * 0.13];
    node.materialProps = { roughness: 1, sheen: 0.5, sheenRoughness: 1 };
  }
  if (node.id === "brow-left" || node.id === "brow-right") {
    const side = node.id === "brow-left" ? -1 : 1;
    rounded2(node, "studio-brow");
    node.position = [side * 0.109, 0.119, 0.194];
    node.scale = [0.046, 0.03, 0.012];
    node.rotation = [0, side * 0.15, 0];
    node.material = "fur";
  }
  if (node.id === "nose") {
    node.position = [0, -0.069, 0.268];
    node.scale = [0.031, 0.021, 0.019];
    node.materialProps = { roughness: 0.25, clearcoat: 0.6, clearcoatRoughness: 0.2 };
  }
  if (node.id === "mouth") {
    node.position = [0, -0.109, 0.274];
    node.children = [
      piece2("mouth-left", [0, 0, 0], [0.047, 0.055, 0.01], "mouthDark", "studio-smile"),
      piece2("mouth-right", [0, -0.024, 9e-3], [0.024, 8e-3, 3e-3], "inner"),
      piece2("muzzle-chin", [0, -0.036, -0.034], [0.05, 0.02, 0.016], "light")
    ];
  }
  if (node.id === "eye-left" || node.id === "eye-right") sculptEye(node);
}
function tufts2(head) {
  const crown = [-0.063, -0.018, 0.025, 0.066];
  for (let index2 = 0; index2 < crown.length; index2++) {
    const x = crown[index2];
    const tuft = piece2(`crown-wisp-${index2}`, [x, 0.222 - Math.abs(x) * 0.14, -0.012], [0.026, 0.034 + index2 % 3 * 4e-3, 0.024], "fur");
    tuft.rotation = [0, 0, -0.5 - index2 * 0.08];
    head.children.push(tuft);
  }
  for (const side of [-1, 1])
    for (let index2 = 0; index2 < 3; index2++) {
      const tuft = piece2(`cheek-wisp-${side < 0 ? "left" : "right"}-${index2}`, [side * (0.253 - index2 * 9e-3), -0.042 - index2 * 0.034, 0.022], [0.022, 0.046, 0.027], "fur");
      tuft.rotation = [0, 0, side * -1];
      head.children.push(tuft);
    }
}
function sculptNodes(nodes, variant) {
  for (const node of nodes) {
    if (node.primitive === "soft" || node.primitive === "ball") rounded2(node);
    if (node.id === "torso") rounded2(node, "studio-pear");
    if (/^arm-(left|right)-paw$/.test(node.id)) node.material = "fur";
    if (node.id === "bib") {
      rounded2(node, "studio-pear");
      node.position = [0, 0.307, 0.128];
      node.scale = [0.151, 0.201, 0.079];
    }
    if (node.id?.startsWith("ear-") && /-(outer|inner)$/.test(node.id)) {
      if (variant === "world-pointed") {
        rounded2(node, "studio-ear");
        node.scale[1] *= 0.74;
        node.scale[0] *= 1.35;
      } else if (variant === "world-round") {
        node.scale[0] *= 1.16;
        node.scale[1] *= 1.03;
      }
      if (node.id.endsWith("-inner")) {
        node.position[2] = variant === "world-round" ? 0.071 : variant === "world-pointed" ? 0.062 : 0.065;
        node.scale[0] *= 1.08;
        node.materialProps = { roughness: 0.95, sheen: 0.6, sheenRoughness: 0.9 };
      }
    }
    sculptFace(node);
    if (node.id === "head") tufts2(node);
    if (node.children) sculptNodes(node.children, variant);
  }
}
function sculptPlushModel(visual) {
  visual.meshes = plushMeshes();
  for (const role of ["fur", "light"]) visual.materials[role] = {
    color: visual.materials[role],
    roughness: 0.9,
    metalness: 0,
    flatShading: false,
    sheen: 0.75,
    sheenRoughness: 0.9,
    sheenColor: "#fff0d8"
  };
  visual.materials.inner = { color: visual.materials.inner, roughness: 0.9, flatShading: false };
  visual.materials.pupil = { color: visual.materials.pupil, roughness: 0.16, flatShading: false, clearcoat: 1, clearcoatRoughness: 0.08 };
  visual.materials.eyeRim = { color: "#32251e", roughness: 0.24, flatShading: false };
  visual.materials.eyeDepth = { color: "#100e0b", roughness: 0.1, flatShading: false, clearcoat: 1, clearcoatRoughness: 0.05 };
  visual.materials.eyeWhite = { color: "#fff9ed", roughness: 0.18, flatShading: false, emissive: "#fff9ed", emissiveIntensity: 0.18 };
  visual.materials.mouthDark = { color: "#60392f", roughness: 0.8, flatShading: false };
  for (const [name, model] of Object.entries(visual.models)) sculptNodes(model.nodes, name);
}

// src/domain/engine-validation.ts
var import_asset_catalog = __toESM(require_asset_catalog(), 1);
var import_creature_catalog = __toESM(require_creature_catalog(), 1);
var root = globalThis;
var validateAsset = (value) => root.LWAssets.validate(value);
var validateCreature = (value) => root.LWCreatures.validate(value);

// src/application/compiler.ts
function walk(nodes, visit) {
  for (const node of nodes) {
    visit(node);
    if (node.children) walk(node.children, visit);
  }
}
function multiply(node, factors) {
  node.scale = (node.scale || [1, 1, 1]).map(
    (v, i) => v * factors[i]
  );
}
function bakeOutfits(visual, character, revision) {
  for (const slot of slots) {
    const item = equipmentDefinitions.find(
      (item2) => item2.id === character.outfits[slot]
    );
    if (!item) continue;
    const prefix = `outfit-${slot}-`;
    for (const [id, material] of Object.entries(item.visual.materials))
      visual.materials[prefix + id] = revision >= 3 ? companionOutfitMaterial(item.id, id, clone(material)) : clone(material);
    const sockets = [visual.behaviors.sockets[slot]].flat();
    for (const model of Object.values(visual.models)) {
      walk(model.nodes, (node) => {
        if (!sockets.includes(node.id)) return;
        const children = clone(item.visual.models.equipped.nodes);
        if (revision >= 3) refineCompanionOutfit(item.id, children);
        walk(children, (child) => {
          if (child.id) child.id = `${prefix}${node.id}-${child.id}`;
          if (child.material) child.material = prefix + child.material;
          if (visual.meshes?.["studio-soft"] && child.primitive === "soft") {
            child.primitive = "mesh";
            child.mesh = "studio-soft";
          }
        });
        node.children = [...node.children || [], ...children];
      });
    }
  }
}
function compileVisual(input) {
  return compileVisualRevision(input, 3);
}
function compileVisualRevision(input, revision) {
  const character = assertCharacter(input), look = character.appearance;
  const visual = clone(baseDefinition.visual);
  visual.id = character.id;
  visual.name = character.identity.name.trim() || "Untitled companion";
  Object.assign(visual.materials, {
    fur: look.coat,
    light: look.belly,
    inner: look.inner,
    pupil: look.eyeColor
  });
  const modelName = `world-${look.ears}`;
  for (const model of Object.values(visual.models)) {
    walk(model.nodes, (node) => {
      if (node.id === "body")
        multiply(
          node,
          look.body === "round" ? [1.12, 0.95, 1.12] : look.body === "slender" ? [0.9, 1.06, 0.92] : [1, 1, 1]
        );
      if (node.id === "head")
        multiply(node, [look.headSize, look.headSize, look.headSize]);
      if (visual.rig.ears.includes(node.id))
        multiply(node, [look.earSize, look.earSize, look.earSize]);
      if (visual.rig.eyes.includes(node.id))
        multiply(node, [look.eyeSize, look.eyeSize, look.eyeSize]);
      if (node.id === visual.rig.tail)
        multiply(
          node,
          look.tail === "fluffy" ? [1.4, 1.25, 1.4] : look.tail === "long" ? [1, 1, 1.6] : [1, 1, 1]
        );
    });
  }
  for (const appearance of Object.values(
    visual.behaviors.appearances
  )) {
    appearance.model = modelName;
    appearance.scale = [1, 1, 1];
    appearance.materials = {
      fur: look.coat,
      light: look.belly,
      inner: look.inner,
      pupil: look.eyeColor
    };
  }
  if (revision === 2) sculptPlushModel(visual);
  if (revision === 3) sculptCompanionModel(visual);
  bakeOutfits(visual, character, revision);
  visual.metadata.characterStudio = {
    recipe: clone(character),
    outfits: "cosmetic-only",
    identity: "presentation-only",
    ...revision >= 2 ? { compilerRevision: revision } : {}
  };
  validateAsset(visual);
  return visual;
}
function compilePackage(input) {
  const character = assertCharacter(input);
  if (!character.identity.name.trim())
    throw new CharacterError([
      {
        path: "/identity/name",
        message: "Give this companion a name before exporting to the engine."
      }
    ]);
  const gameplay = clone(baseDefinition.creature);
  gameplay.id = character.id;
  gameplay.name = character.identity.name;
  gameplay.names = [character.identity.name];
  gameplay.visualAsset = character.id;
  gameplay.defaultPersonality = character.personality;
  gameplay.state.defaults.archetype = character.id;
  gameplay.state.defaults.name = character.identity.name;
  gameplay.state.defaults.personality = character.personality;
  gameplay.state.defaults.skills = {};
  gameplay.state.defaults.researched = {};
  gameplay.state.defaults.rpg.points = {};
  for (const [id, points] of Object.entries(character.skills))
    if (points > 0) {
      gameplay.state.defaults.skills[id] = true;
      gameplay.state.defaults.researched[id] = true;
      gameplay.state.defaults.rpg.points[id] = points;
    }
  validateCreature(gameplay);
  return {
    format: "littlewild-creature-package",
    schemaVersion: 1,
    gameplayDefinition: gameplay,
    appearanceManifest: compileVisual(character),
    assetReferences: []
  };
}
function compileDefinition(input) {
  const compiled = compilePackage(input);
  return {
    format: "littlewild-definition",
    schemaVersion: 1,
    family: "creatures",
    id: compiled.gameplayDefinition.id,
    creature: compiled.gameplayDefinition,
    visual: compiled.appearanceManifest
  };
}
function canonical(value) {
  if (Array.isArray(value)) return "[" + value.map(canonical).join(",") + "]";
  if (value && typeof value === "object")
    return "{" + Object.keys(value).sort().map((key) => JSON.stringify(key) + ":" + canonical(value[key])).join(",") + "}";
  return JSON.stringify(value);
}
function importCharacter(input) {
  if (!input || typeof input !== "object") return assertCharacter(input);
  const value = input;
  if (value.format === "littlewild-character") return assertCharacter(value);
  const visual = value.format === "littlewild-definition" ? value.visual : value.format === "littlewild-creature-package" ? value.appearanceManifest : value;
  if (visual?.metadata?.characterStudio?.recipe) {
    validateAsset(visual);
    const character = assertCharacter(visual.metadata.characterStudio.recipe);
    const revision = visual.metadata.characterStudio.compilerRevision ?? 1;
    if (revision !== 1 && revision !== 2 && revision !== 3)
      throw new Error("This export uses an unsupported Character Studio compiler revision.");
    const expectedVisual = compileVisualRevision(character, revision);
    if (canonical(expectedVisual) !== canonical(visual))
      throw new Error(
        "This visual was edited outside Character Studio. Import its original recipe or use Scene Forge to preserve advanced edits."
      );
    const expectedPackage = value.format === "littlewild-creature-package" ? { ...compilePackage(character), appearanceManifest: expectedVisual } : null;
    if (expectedPackage && canonical(expectedPackage) !== canonical(value))
      throw new Error(
        "This package has advanced gameplay edits. Import its original recipe to avoid discarding those changes."
      );
    const expectedDefinition = value.format === "littlewild-definition" ? { ...compileDefinition(character), visual: expectedVisual } : null;
    if (expectedDefinition && canonical(expectedDefinition) !== canonical(value))
      throw new Error(
        "This definition has advanced edits. Import its original recipe to avoid discarding those changes."
      );
    return character;
  }
  throw new Error(
    "Import a Character Studio recipe or unmodified studio export. General engine assets can be edited in Scene Forge."
  );
}

// src/application/section-actions.ts
var bodyFields = ["preset", "body", "headSize", "earSize", "ears", "eyeSize", "eyeColor", "tail"];
var coatFields = ["coat", "belly", "inner"];
function appearanceChanges(current, next, keys) {
  return keys.filter((key) => current.appearance[key] !== next.appearance[key]).map((key) => ({ op: "set", path: `/appearance/${key}`, value: next.appearance[key] }));
}
function randomizeSection(character, scope, seed) {
  if (scope === "all") return [{ op: "randomize", seed }];
  if (!["body", "coat"].includes(scope)) throw new Error("Choose all appearance, body and face, or coat colors.");
  return appearanceChanges(character, stageRandomize(character, seed), scope === "body" ? bodyFields : coatFields);
}
function resetSection(character, chapter) {
  const defaults = createCharacter("draft", "Draft", chapter === 1 || chapter === 2 ? character.appearance.preset : "pip");
  defaults.identity.name = character.identity.name;
  if (!Number.isInteger(chapter) || chapter < 0 || chapter > 4) throw new Error("Choose a chapter from 0 through 4.");
  if (chapter === 0) return [{ op: "set", path: "/identity", value: defaults.identity }];
  if (chapter === 1 || chapter === 2) return appearanceChanges(character, defaults, chapter === 1 ? bodyFields : coatFields);
  if (chapter === 3) return [{ op: "set", path: "/skills", value: defaults.skills }, { op: "set", path: "/personality", value: defaults.personality }];
  return [{ op: "set", path: "/outfits", value: defaults.outfits }];
}

// src/application/transactions.ts
function invalid(path, message) {
  throw new CharacterError([{ path, message }]);
}
function pointer(path) {
  if (typeof path !== "string" || !path.startsWith("/") || path.length > 256 || /~(?![01])/.test(path)) invalid("/path", "Use an RFC 6901 JSON pointer beginning with /.");
  const parts = path.slice(1).split("/").map((p) => p.replace(/~1/g, "/").replace(/~0/g, "~"));
  if (parts.some((p) => ["__proto__", "prototype", "constructor"].includes(p))) invalid("/path", "Unsafe property path.");
  if (["id", "format", "schemaVersion"].includes(parts[0])) invalid(path, "Character identity and format are immutable. Import a copy with a new ID instead.");
  return parts;
}
function index(value, key, append) {
  if (append && key === "-") return value.length;
  if (!/^(0|[1-9]\d*)$/.test(key)) invalid("/path", "Expected an array index.");
  const n = Number(key);
  if (!Number.isSafeInteger(n) || n >= value.length + (append ? 1 : 0)) invalid("/path", "Array index is out of range.");
  return n;
}
function patch(character, operation) {
  const keys = pointer(operation.path);
  let parent = character;
  for (const key2 of keys.slice(0, -1)) {
    if (!parent || typeof parent !== "object" || !Object.hasOwn(parent, key2)) invalid(operation.path, "Parent path does not exist.");
    parent = parent[key2];
  }
  if (!parent || typeof parent !== "object") invalid(operation.path, "Parent must be an object or array.");
  const key = keys.at(-1);
  if (Array.isArray(parent)) {
    const i = index(parent, key, operation.op === "add");
    if (operation.op === "add") parent.splice(i, 0, clone(operation.value));
    else if (operation.op === "remove") parent.splice(i, 1);
    else parent[i] = clone(operation.value);
  } else {
    if (operation.op !== "add" && !Object.hasOwn(parent, key)) invalid(operation.path, "Field does not exist; use add to create an optional field.");
    if (operation.op === "add" && Object.hasOwn(parent, key)) invalid(operation.path, "Field already exists; use set to replace it.");
    if (operation.op === "remove") delete parent[key];
    else parent[key] = clone(operation.value);
  }
}
function applyOperations(input, operations) {
  let next = assertCharacter(input);
  if (!isJsonData(operations)) invalid("/operations", "Expected plain, finite JSON data without accessors or executable values.");
  if (!Array.isArray(operations) || !operations.length || operations.length > 256) invalid("/operations", "Use 1\u2013256 operations.");
  for (const [i, raw] of operations.entries()) {
    try {
      if (!raw || typeof raw !== "object" || Array.isArray(raw)) invalid("/operation", "Expected an operation object.");
      const operation = raw;
      const required = operation.op === "reset" ? ["op", "section"] : operation.op === "look" ? ["op", "look"] : operation.op === "preset" ? ["op", "preset"] : operation.op === "randomize" ? ["op", "seed"] : operation.op === "remove" ? ["op", "path"] : ["op", "path", "value"];
      const allowed = operation.op === "randomize" ? [...required, "scope"] : required;
      if (Object.keys(raw).some((k) => !allowed.includes(k)) || required.some((k) => !Object.hasOwn(raw, k))) invalid("/operation", "Unexpected or missing operation fields.");
      if (operation.op === "preset") next = stagePreset(next, operation.preset);
      else if (operation.op === "look") {
        const look = operation.look;
        if (!look || look.format !== "littlewild-look" || look.schemaVersion !== 1 || Object.keys(look).some((k) => !["format", "schemaVersion", "appearance", "outfits"].includes(k))) invalid("/look", "Expected a littlewild-look schemaVersion 1 export.");
        const candidate = assertCharacter({ ...createCharacter(), appearance: look.appearance, outfits: look.outfits });
        next.appearance = candidate.appearance;
        next.outfits = candidate.outfits;
        next.status = "draft";
      } else if (operation.op === "randomize") {
        if (!Number.isInteger(operation.seed) || operation.seed < 0 || operation.seed > 4294967295) invalid("/seed", "Use an integer from 0 to 4294967295.");
        const scope = operation.scope === void 0 ? "all" : operation.scope;
        if (!["all", "body", "coat"].includes(scope)) invalid("/scope", "Choose all, body, or coat.");
        if (scope === "all") next = stageRandomize(next, operation.seed);
        else for (const edit of randomizeSection(next, scope, operation.seed)) patch(next, edit);
        next.status = "draft";
      } else if (operation.op === "reset") {
        const section = ["identity", "body", "coat", "skills", "outfits"].indexOf(operation.section);
        if (section < 0) invalid("/section", "Choose identity, body, coat, skills, or outfits.");
        for (const edit of resetSection(next, section)) patch(next, edit);
        next.status = "draft";
      } else if (["set", "add", "remove"].includes(operation.op)) {
        const edit = operation;
        pointer(edit.path);
        if (edit.path !== "/locks" && !edit.path.startsWith("/locks/") && edit.path !== "/status") next.status = "draft";
        patch(next, edit);
      } else invalid("/op", "Unknown operation. Use set, add, remove, preset, randomize, look, or reset.");
    } catch (error) {
      if (error instanceof CharacterError) {
        error.errors = error.errors.map((issue) => ({ ...issue, path: `/operations/${i}${issue.path}` }));
        error.message = error.errors.map((issue) => `${issue.path}: ${issue.message}`).join("; ");
      }
      throw error;
    }
  }
  return assertCharacter(next);
}
function batchOperations(input) {
  if (!isJsonData(input)) invalid("/", "Expected plain, finite JSON data.");
  if (!input || typeof input !== "object" || Array.isArray(input) || Object.keys(input).some((k) => k !== "operations")) invalid("/", "Expected an object containing only operations.");
  const operations = input.operations;
  if (!Array.isArray(operations) || !operations.length || operations.length > 256) invalid("/operations", "Use 1\u2013256 operations.");
  return operations;
}

// src/infra/store.ts
var store_exports = {};
__export(store_exports, {
  history: () => history,
  list: () => list,
  lockStatus: () => lockStatus,
  read: () => read,
  redo: () => redo,
  stateHash: () => stateHash,
  undo: () => undo,
  write: () => write
});
var import_promises2 = require("node:fs/promises");
var import_node_path2 = require("node:path");
var import_node_os = require("node:os");
var import_node_crypto2 = require("node:crypto");

// src/infra/files.ts
var import_promises = require("node:fs/promises");
var import_node_path = require("node:path");
var import_node_crypto = require("node:crypto");
var StudioError = class extends Error {
  constructor(code, message, details) {
    super(message);
    this.code = code;
    this.details = details;
  }
};
async function readJson(file) {
  const info = await (0, import_promises.stat)(file);
  if (info.size > 2 * 1024 * 1024) throw new StudioError("SIZE_LIMIT", "JSON files must be at most 2 MiB.");
  try {
    return JSON.parse(await (0, import_promises.readFile)(file, "utf8"));
  } catch (error) {
    if (error instanceof SyntaxError) throw new StudioError("INVALID_JSON", `Cannot parse JSON in ${file}.`);
    throw error;
  }
}
async function replaceJson(file, value) {
  await (0, import_promises.mkdir)((0, import_node_path.dirname)(file), { recursive: true });
  const temporary = `${file}.${(0, import_node_crypto.randomUUID)()}.tmp`;
  const handle = await (0, import_promises.open)(temporary, "wx", 384);
  try {
    await handle.writeFile(JSON.stringify(value, null, 2) + "\n");
    await handle.sync();
    await handle.close();
    await (0, import_promises.rename)(temporary, file);
  } finally {
    await handle.close().catch(() => {
    });
    await (0, import_promises.rm)(temporary, { force: true });
  }
}
async function writeNew(file, contents) {
  await (0, import_promises.mkdir)((0, import_node_path.dirname)(file), { recursive: true });
  const handle = await (0, import_promises.open)(file, "wx", 384);
  try {
    await handle.writeFile(contents);
    await handle.sync();
  } catch (error) {
    await handle.close();
    await (0, import_promises.rm)(file, { force: true });
    throw error;
  } finally {
    await handle.close().catch(() => {
    });
  }
}

// src/infra/store.ts
var copy = (value) => structuredClone(value);
function canonical2(value) {
  if (Array.isArray(value)) return "[" + value.map(canonical2).join(",") + "]";
  if (value && typeof value === "object") {
    return "{" + Object.keys(value).sort().map((key) => JSON.stringify(key) + ":" + canonical2(value[key])).join(",") + "}";
  }
  return JSON.stringify(value);
}
var stateHash = (value) => (0, import_node_crypto2.createHash)("sha256").update(canonical2(value)).digest("hex");
function paths(project, id) {
  if (id !== void 0 && !/^[a-z][a-z0-9_-]{0,60}$/.test(id)) {
    throw new StudioError("INVALID_ID", "Use a lowercase stable ID starting with a letter (maximum 61 characters).");
  }
  const root2 = (0, import_node_path2.resolve)(project, ".character-studio");
  return { root: root2, directory: (0, import_node_path2.join)(root2, "characters"), file: (0, import_node_path2.join)(root2, "characters", `${id}.json`), lock: (0, import_node_path2.join)(root2, "write.lock") };
}
function envelope(doc) {
  return { ok: true, id: doc.character.id, revision: doc.revision, stateHash: stateHash(doc.character), character: copy(doc.character) };
}
async function load(project, id) {
  const doc = await readJson(paths(project, id).file);
  if (doc.format !== "littlewild-character-document" || doc.version !== 1 || !Number.isSafeInteger(doc.revision) || doc.revision < 1 || doc.character?.id !== id || !Array.isArray(doc.past) || !Array.isArray(doc.future) || doc.past.length > 50 || doc.future.length > 50) {
    throw new StudioError("INVALID_DOCUMENT", `Stored character ${id} has an invalid document envelope.`);
  }
  assertCharacter(doc.character);
  for (const entry of [...doc.past, ...doc.future]) {
    assertCharacter(entry);
    if (entry.id !== id) throw new StudioError("INVALID_DOCUMENT", "History cannot change a character identity.");
  }
  return doc;
}
async function read(project, id) {
  return envelope(await load(project, id));
}
async function list(project) {
  const { directory } = paths(project);
  let files;
  try {
    files = await (0, import_promises2.readdir)(directory);
  } catch (error) {
    if (error.code === "ENOENT") return [];
    throw error;
  }
  return Promise.all(files.filter((file) => /^[a-z][a-z0-9_-]{0,60}\.json$/.test(file)).sort().map((file) => read(project, file.slice(0, -5))));
}
async function locked(project, action) {
  const { root: root2, lock } = paths(project);
  await (0, import_promises2.mkdir)(root2, { recursive: true });
  try {
    await (0, import_promises2.mkdir)(lock);
  } catch (error) {
    if (error.code === "EEXIST") throw new StudioError("BUSY", `Another writer holds ${lock}. Retry after it finishes; do not remove a live writer's lock.`);
    throw error;
  }
  try {
    await (0, import_promises2.writeFile)((0, import_node_path2.join)(lock, "owner.json"), JSON.stringify({ pid: process.pid, hostname: (0, import_node_os.hostname)(), createdAt: (/* @__PURE__ */ new Date()).toISOString() }), { flag: "wx", mode: 384 });
    return await action();
  } finally {
    await (0, import_promises2.rm)(lock, { recursive: true });
  }
}
function guard(current, guards4) {
  if (guards4.dryRun !== void 0 && typeof guards4.dryRun !== "boolean") throw new StudioError("INVALID_REQUEST", "dryRun must be a boolean.");
  const revision = current?.revision ?? 0;
  const hash2 = current ? stateHash(current.character) : null;
  if (!Number.isSafeInteger(guards4.expectedRevision) || guards4.expectedRevision < 0 || guards4.expectedState !== null && typeof guards4.expectedState !== "string") {
    throw new StudioError("GUARDS_REQUIRED", "Supply expectedRevision and expectedState from inspect; use 0 and null only for a new character.");
  }
  if (guards4.expectedRevision !== revision || guards4.expectedState !== hash2) {
    throw new StudioError("CONFLICT", "Character changed. Inspect it again before preparing a new edit.", { revision, stateHash: hash2 });
  }
}
function result(current, proposed, dryRun = false) {
  if (!dryRun) return envelope(proposed);
  return {
    ...envelope(proposed),
    revision: current?.revision ?? 0,
    stateHash: current ? stateHash(current.character) : null,
    dryRun: true,
    proposedRevision: proposed.revision,
    proposedStateHash: stateHash(proposed.character)
  };
}
async function write(project, input, guards4) {
  const character = copy(input);
  assertCharacter(character, { commit: character.status === "ready" });
  const { file } = paths(project, character.id);
  return locked(project, async () => {
    let current = null;
    try {
      current = await load(project, character.id);
    } catch (error) {
      if (error.code !== "ENOENT") throw error;
    }
    guard(current, guards4);
    const proposed = {
      format: "littlewild-character-document",
      version: 1,
      revision: (current?.revision ?? 0) + 1,
      character,
      past: current ? [...current.past, current.character].slice(-50) : [],
      future: []
    };
    if (!guards4.dryRun) await replaceJson(file, proposed);
    return result(current, proposed, guards4.dryRun);
  });
}
async function travel(project, id, guards4, direction) {
  return locked(project, async () => {
    const current = await load(project, id);
    guard(current, guards4);
    const proposed = copy(current);
    const from = direction === "undo" ? proposed.past : proposed.future;
    const to = direction === "undo" ? proposed.future : proposed.past;
    const next = from.pop();
    if (!next) throw new StudioError("NO_HISTORY", `There is no ${direction} entry.`);
    to.push(proposed.character);
    proposed.character = next;
    proposed.revision++;
    if (!guards4.dryRun) await replaceJson(paths(project, id).file, proposed);
    return result(current, proposed, guards4.dryRun);
  });
}
var undo = (project, id, guards4) => travel(project, id, guards4, "undo");
var redo = (project, id, guards4) => travel(project, id, guards4, "redo");
async function history(project, id) {
  const doc = await load(project, id);
  return { ...envelope(doc), undo: doc.past.length, redo: doc.future.length };
}
async function lockStatus(project) {
  const { lock } = paths(project);
  try {
    const owner = await readJson((0, import_node_path2.join)(lock, "owner.json"));
    let state = "unknown";
    if (owner.hostname === (0, import_node_os.hostname)() && Number.isSafeInteger(owner.pid) && owner.pid > 0) {
      try {
        process.kill(owner.pid, 0);
        state = "active";
      } catch (error) {
        state = error.code === "ESRCH" ? "stale" : "unknown";
      }
    }
    return { locked: true, state, path: lock, owner };
  } catch (error) {
    try {
      await (0, import_promises2.readdir)(lock);
    } catch (missing) {
      if (missing.code === "ENOENT") return { locked: false, state: "unlocked", path: lock };
    }
    return { locked: true, state: "unknown", path: lock, reason: error.message };
  }
}

