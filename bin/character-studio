// src/domain/catalog.ts
var clone = (value) => JSON.parse(JSON.stringify(value));
function freeze(value) {
  if (value && typeof value === "object") {
    Object.freeze(value);
    for (const child of Object.values(value)) freeze(child);
  }
  return value;
}
var baseDefinition = freeze(definition_default);
var equipmentDefinitions = freeze([
  definition_default2,
  definition_default3,
  definition_default4,
  definition_default5,
  definition_default6,
  definition_default7,
  definition_default8,
  definition_default9,
  definition_default10,
  definition_default11,
  definition_default12,
  definition_default13
]);
var slots = ["head", "body", "back", "feet", "tool", "charm"];
var presets = [
  {
    id: "pip",
    name: "Pip",
