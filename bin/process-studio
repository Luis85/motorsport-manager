      }
      function shares(flows) {
        const chances = flows.filter((f) => f.when), fallback = flows.find((f) => !f.when);
        if (!fallback || !chances.length || chances.some((f) => f.when.chance === void 0)) return void 0;
        const out = /* @__PURE__ */ new Map();
        let rest = 1;
        for (const f of chances) {
          const p = f.when.chance / 100;
          out.set(f.id, rest * p);
          rest *= 1 - p;
        }
        out.set(fallback.id, rest);
        return out;
      }
      function parameter(v) {
