var import_node_fs = __toESM(require("node:fs"));
var import_node_path = __toESM(require("node:path"));
var import_node_crypto = require("node:crypto");
function readBytesFile(file, maxBytes) {
  const descriptor = import_node_fs.default.openSync(file, import_node_fs.default.constants.O_RDONLY | (import_node_fs.default.constants.O_NONBLOCK ?? 0));
  try {
    const stat = import_node_fs.default.fstatSync(descriptor);
    if (!stat.isFile() || stat.size > maxBytes) throw new Error(`Choose a regular JSON file of at most ${maxBytes} bytes: ${file}`);
    const buffer = new Uint8Array(maxBytes + 1);
    let bytes = 0;
    while (bytes < buffer.length) {
      const count = import_node_fs.default.readSync(descriptor, buffer, bytes, buffer.length - bytes, null);
      if (!count) break;
      bytes += count;
    }
    if (bytes > maxBytes) throw new Error(`JSON file exceeds ${maxBytes} bytes: ${file}`);
    return buffer.subarray(0, bytes);
  } finally {
    import_node_fs.default.closeSync(descriptor);
  }
}
function readJsonFile(file, maxBytes) {
  return new TextDecoder("utf-8", { fatal: true }).decode(readBytesFile(file, maxBytes));
}
function writeJsonFile(file, value, inputs = []) {
  if (!file) throw new Error("Provide an output .json path.");
  return writeTextFile(file, JSON.stringify(value, null, 2) + "\n", inputs);
}
function guardOutput(file, inputs = []) {
  const destination = import_node_path.default.resolve(file);
  for (const input of inputs) {
    if (destination === import_node_path.default.resolve(input)) throw new Error("Output must not overwrite an input file.");
    if (import_node_fs.default.existsSync(destination) && import_node_fs.default.existsSync(input)) {
      const target = import_node_fs.default.statSync(destination), source = import_node_fs.default.statSync(input);
      if (target.dev === source.dev && target.ino === source.ino) throw new Error("Output must not overwrite an input file through an alias.");
    }
  }
  return destination;
}
function writeTextFile(file, text, inputs = []) {
  if (!file) throw new Error("Provide an output path.");
  const destination = guardOutput(file, inputs);
  const temporary = destination + "." + (0, import_node_crypto.randomUUID)() + ".tmp";
  let owned = false;
  try {
    const descriptor = import_node_fs.default.openSync(temporary, "wx");
    owned = true;
    try {
      import_node_fs.default.writeFileSync(descriptor, text, "utf8");
    } finally {
      import_node_fs.default.closeSync(descriptor);
    }
    import_node_fs.default.renameSync(temporary, destination);
    owned = false;
  } finally {
    if (owned) import_node_fs.default.rmSync(temporary, { force: true });
  }
  return destination;
}

