      }
      const LIMIT = 1e5;
      function phi(z) {
        const x = Math.abs(z) / Math.SQRT2, t = 1 / (1 + 0.3275911 * x);
        const erf = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
        return z >= 0 ? (1 + erf) / 2 : (1 - erf) / 2;
      }
      function triangularCdf(x, min, mode, max) {
        const span = max - min;
        if (x <= min) return 0;
        if (x >= max) return 1;
        if (x <= mode) return (x - min) ** 2 / (span * (mode - min));
        return 1 - (max - x) ** 2 / (span * (max - mode));
      }
      function erlangCdf(x, k, mean) {
        if (x <= 0) return 0;
        const rate = k / mean;
        let term = 1, sum = 0;
        for (let n = 0; n < k; n++) {
          sum += term;
          term *= rate * x / (n + 1);
        }
        return 1 - Math.exp(-rate * x) * sum;
      }
      function roundedMean(cdf, low, high) {
        let mean = low;
        for (let m = low; m < high; m++) {
          const tail = 1 - cdf(m + 0.5);
          if (tail < 1e-9) break;
          mean += tail;
        }
        return mean;
      }
      function meanOf(d) {
        if (!d) return null;
        const ok = (...values) => values.every((v) => v !== void 0 && Number.isFinite(v));
        if (d.dist === "uniform") {
          if (!ok(d.min, d.max) || d.max < d.min) return null;
          const low = Math.max(1, d.min), high = Math.min(LIMIT, d.max), span = d.max - d.min + 1;
          let sum = 0;
          for (let v = d.min; v <= d.max && v - d.min < 2e5; v++) sum += Math.min(high, Math.max(low, v));
          return sum / span;
        }
        if (d.dist === "triangular") {
          const min = d.min ?? 1, max = d.max ?? LIMIT, mode = d.mode ?? min, span = max - min;
          if (!ok(min, max, mode) || span < 0) return null;
