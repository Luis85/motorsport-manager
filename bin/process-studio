      const MAX_VALUES = 4e6, MAX_DEPTH = 24, MAX_SEED = 2147483647, MAX_RETAINED = 1e4, MAX_TOKENS = 2e5, SAFE = Number.MAX_SAFE_INTEGER;
      const FIELD = /^[a-z][a-zA-Z0-9_]{0,63}$/, CASE = /^case-\d{4,12}$/, TOKEN = /^token-\d{8}$/, KIND = /^[a-z][a-z-]{0,39}$/;
      const FORBIDDEN = /* @__PURE__ */ new Set(["__proto__", "constructor", "prototype"]);
      const CLOCK = ["minute", "serial", "forkSerial", "arrival", "cost", "arrived", "completed", "failed", "dropped", "cycle", "pruned", "goals", "lost"];
      const STATUSES = ["queued", "active", "joining", "backlog", "held", "timer"];
      const TOKEN_FIELDS = ["id", "caseId", "stepId", "entered", "started", "input", "remaining", "status", "fork", "branch"];
      const TOKEN_OPTIONAL = ["target", "due", "visit", "expected", "item", "items", "group", "deadlineAt", "escalated"];
      const bad = (path4, reason) => {
        throw Error(`${path4} ${reason}.`);
      };
      function plain(input, label = "snapshot") {
        let values = 0;
        const stack = [[input, label, 0]];
        while (stack.length) {
          const [value, path4, depth] = stack.pop();
          if (++values > MAX_VALUES) bad(label, `holds more than ${MAX_VALUES.toLocaleString("en-US")} values`);
          if (value === null || typeof value === "string" || typeof value === "boolean") continue;
          if (typeof value === "number") {
            if (!Number.isFinite(value)) bad(path4, "is not a finite number");
            continue;
          }
          if (typeof value !== "object") bad(path4, "is not JSON data");
          const proto = Object.getPrototypeOf(value), array = Array.isArray(value);
          if (proto !== (array ? Array.prototype : Object.prototype) && proto !== null) bad(path4, "is not plain data");
          if (depth >= MAX_DEPTH) bad(path4, `is nested deeper than ${MAX_DEPTH} levels`);
          for (const key of Reflect.ownKeys(value)) {
            if (array && key === "length") continue;
            if (typeof key !== "string" || FORBIDDEN.has(key)) bad(path4, `has the forbidden key ${String(key)}`);
            const d = Object.getOwnPropertyDescriptor(value, key);
            if (!("value" in d)) bad(`${path4}.${key}`, "is an accessor, not data");
            stack.push([d.value, array ? `${path4}[${key}]` : `${path4}.${key}`, depth + 1]);
          }
        }
        return JSON.parse(JSON.stringify(input));
      }
      function shape(v, path4, required, optional = []) {
        if (v === null || typeof v !== "object" || Array.isArray(v)) return bad(path4, "must be an object");
        for (const key of Object.keys(v)) if (!required.includes(key) && !optional.includes(key)) bad(`${path4}.${key}`, "is not a known field");
        for (const key of required) if (!Object.hasOwn(v, key)) bad(`${path4}.${key}`, "is missing");
        return v;
      }
      function whole(v, path4, min = 0, max = SAFE) {
        if (!Number.isSafeInteger(v) || v < min || v > max) bad(path4, `must be a whole number from ${min} to ${max}`);
        return v;
      }
      const finite = (v, path4) => typeof v === "number" && Number.isFinite(v) ? v : bad(path4, "must be a finite number");
      function text(v, path4, max = 2e3, pattern) {
        if (typeof v !== "string" || v.length > max || pattern && !pattern.test(v)) {
          bad(path4, pattern ? "is not a valid id" : `must be text of at most ${max} characters`);
        }
        return v;
      }
      function list(v, path4, max, length) {
        if (!Array.isArray(v)) return bad(path4, "must be a list");
        if (length !== void 0 && v.length !== length) bad(path4, `must have ${length} entries`);
        if (v.length > max) bad(path4, `has more than ${max} entries`);
        return v;
      }
      const counts = (v, path4, length) => list(v, path4, length, length).map((n, i) => whole(n, `${path4}[${i}]`));
      const nullable = (v, check2) => v === null ? null : check2(v);
      function fieldsOf(v, path4) {
        if (v === null || typeof v !== "object" || Array.isArray(v)) bad(path4, "must be an object of case fields");
        const box = v, keys = Object.keys(box);
        if (keys.length > 256) bad(path4, "has more than 256 fields");
        for (const key of keys) {
          if (!FIELD.test(key)) bad(`${path4}.${key}`, "is not a valid field name");
          const value = box[key];
          if (typeof value === "string") text(value, `${path4}.${key}`, 256);
          else if (typeof value === "number") finite(value, `${path4}.${key}`);
          else if (value !== null && typeof value !== "boolean") bad(`${path4}.${key}`, "must be text, a number, true, false or null");
        }
      }
      function unique(ids, path4) {
        const set = new Set(ids);
        if (set.size !== ids.length) bad(path4, "repeats an id");
        return set;
      }
      function state(definition, input) {
        const v = plain(input);
        shape(v, "snapshot", [
          "seed",
          "active",
          "retained",
          "clock",
          "pools",
          "stations",
          "cases",
          "tokens",
          "events",
          "receipts",
          "receiptsDropped",
          "streams",
          "finished",
          "visits",
          "groups",
          "outcomes",
          "seen",
          "finishAgg",
          "entryAgg",
          "ledger",
          "series"
        ]);
        whole(v.seed, "snapshot.seed", 0, MAX_SEED);
        const active = whole(v.active, "snapshot.active", 1, limits.active), retained = whole(v.retained, "snapshot.retained", 1, MAX_RETAINED);
        const clock = shape(v.clock, "snapshot.clock", CLOCK);
        for (const key of CLOCK) whole(clock[key], `snapshot.clock.${key}`);
        const minute = clock.minute, at = (n, path4) => whole(n, path4, 0, minute);
        const steps = new Map(definition.steps.map((s) => [s.id, s])), step = (id, path4) => {
          if (typeof id !== "string" || !steps.has(id)) bad(path4, "names no step of this process");
          return steps.get(id);
        };
        const world = { v, minute, steps, step, at, active, retained, cases: /* @__PURE__ */ new Map(), live: /* @__PURE__ */ new Set() };
        engine(definition, world);
        ledger(definition, v.ledger, world);
        series(definition, v.series, minute);
        return v;
      }
      function engine(d, w) {
        const { v, minute, step, at } = w, clock = v.clock;
        list(v.pools, "snapshot.pools", d.resources.length, d.resources.length);
        list(v.stations, "snapshot.stations", d.steps.length, d.steps.length);
        d.steps.forEach((s, i) => {
          const path4 = `snapshot.stations[${i}]`, extra = [...s.deadline ? ["deadlines"] : [], ...s.instances ? ["items"] : []];
          const station = shape(v.stations[i], path4, ["id", "visits", "completed", "waitMinutes", "reached", ...extra]);
          if (station.id !== s.id) bad(`${path4}.id`, `must be ${s.id} (stations follow the step order)`);
          for (const key of ["visits", "completed", "waitMinutes", "reached"]) whole(station[key], `${path4}.${key}`);
          const counters = (key, names) => {
            const box = shape(station[key], `${path4}.${key}`, names);
            for (const name of names) whole(box[name], `${path4}.${key}.${name}`);
          };
          if (s.deadline) counters("deadlines", ["interrupted", "escalated"]);
          if (s.instances) counters("items", ["started", "finished"]);
        });
        const caps = w.active + w.retained;
        list(v.cases, "snapshot.cases", caps).forEach((c, i) => {
          const path4 = `snapshot.cases[${i}]`, box = shape(c, path4, ["id", "input", "data", "entered", "finished", "status", "transitions", "error"]);
          const id = text(box.id, `${path4}.id`, 24, CASE);
          if (Number(id.slice(5)) > clock.arrival) bad(`${path4}.id`, "was never admitted (beyond the arrival counter)");
          fieldsOf(box.input, `${path4}.input`);
          fieldsOf(box.data, `${path4}.data`);
          const entered = at(box.entered, `${path4}.entered`);
          whole(box.transitions, `${path4}.transitions`, 0, limits.transitions + 1);
          if (!["active", "completed", "failed"].includes(box.status)) bad(`${path4}.status`, "must be active, completed or failed");
          const open = box.status === "active";
          if (!open) whole(box.finished, `${path4}.finished`, entered, minute);
          else if (box.finished !== null) bad(`${path4}.finished`, "must be null while the case is active");
          nullable(box.error, (e) => text(e, `${path4}.error`, 4e3));
          w.cases.set(id, box);
          if (open) w.live.add(id);
        });
        unique([...v.cases.map((c) => c.id)], "snapshot.cases");
        const done = list(v.finished, "snapshot.finished", w.retained).map((id, i) => text(id, `snapshot.finished[${i}]`, 24, CASE));
        const doneSet = unique(done, "snapshot.finished"), closed = [...w.cases.keys()].filter((id) => !w.live.has(id));
        if (closed.length !== done.length || closed.some((id) => !doneSet.has(id))) bad("snapshot.finished", "must list exactly the retained finished cases");
        if (w.live.size !== clock.arrived - clock.completed - clock.failed) bad("snapshot.cases", "do not match the clock (arrived \u2212 completed \u2212 failed)");
        if (clock.arrival !== clock.arrived + clock.dropped || clock.pruned !== clock.completed + clock.failed - done.length) {
          bad("snapshot.clock", "counts do not agree (arrival, arrived, dropped, completed, failed, pruned)");
        }
        if (clock.goals + clock.lost > clock.completed) bad("snapshot.clock", "counts more goals and losses than completed cases");
        const groups2 = list(v.groups, "snapshot.groups", MAX_TOKENS).map((g, i) => {
          const path4 = `snapshot.groups[${i}]`, box = shape(g, path4, ["id", "count", "done", "started", "input", "visit"]);
          const count = whole(box.count, `${path4}.count`, 1, 50);
          whole(box.done, `${path4}.done`, 0, count - 1);
          nullable(box.started, (n) => at(n, `${path4}.started`));
          nullable(box.input, (f) => fieldsOf(f, `${path4}.input`));
          whole(box.visit, `${path4}.visit`, 1);
          return text(box.id, `${path4}.id`, 24, TOKEN);
        });
        const groupSet = unique(groups2, "snapshot.groups"), used = /* @__PURE__ */ new Set();
        const busy = new Map(d.resources.map((r) => [r.id, 0]));
        const tokens = list(v.tokens, "snapshot.tokens", MAX_TOKENS).map((t, i) => {
          const path4 = `snapshot.tokens[${i}]`, box = shape(t, path4, TOKEN_FIELDS, TOKEN_OPTIONAL);
          const id = text(box.id, `${path4}.id`, 24, TOKEN);
          if (Number(id.slice(6)) > clock.serial) bad(`${path4}.id`, "is beyond the token serial counter");
          if (!w.live.has(box.caseId)) bad(`${path4}.caseId`, "names no active case");
          const s = step(box.stepId, `${path4}.stepId`);
          at(box.entered, `${path4}.entered`);
          nullable(box.started, (n) => at(n, `${path4}.started`));
          nullable(box.input, (f) => fieldsOf(f, `${path4}.input`));
          const status = box.status, remaining = whole(box.remaining, `${path4}.remaining`);
          if (!STATUSES.includes(status)) bad(`${path4}.status`, "is not a status a paused run can hold");
          nullable(box.fork, (f) => text(f, `${path4}.fork`, 200));
          nullable(box.branch, (f) => text(f, `${path4}.branch`, 200));
          if (status === "active") {
            if (remaining < 1 || box.started === null || box.input === null) bad(path4, "is running work without time left, a start or an input");
            const h = d.workingHours;
            if (h && !root2.LWProcessHours.open(h, box.started)) bad(`${path4}.started`, "is outside working hours, when no work starts");
            for (const [pool, quantity] of Object.entries(s.resources ?? {})) busy.set(pool, busy.get(pool) + quantity);
          }
          if (status === "timer" && whole(box.due, `${path4}.due`, minute + 1) <= minute) bad(`${path4}.due`, "must be after the clock minute");
          if (status === "held" || box.target !== void 0) step(box.target, `${path4}.target`);
          for (const key of ["visit", "expected", "item", "items"]) if (box[key] !== void 0) whole(box[key], `${path4}.${key}`, 1);
          if (box.deadlineAt !== void 0) whole(box.deadlineAt, `${path4}.deadlineAt`);
          if (box.due !== void 0) whole(box.due, `${path4}.due`);
          if (box.escalated !== void 0 && box.escalated !== true) bad(`${path4}.escalated`, "must be true when present");
          if (box.group !== void 0) {
            if (!groupSet.has(box.group)) bad(`${path4}.group`, "names no multi-instance group");
            used.add(box.group);
          }
          return id;
        });
        unique(tokens, "snapshot.tokens");
        if (groups2.some((g) => !used.has(g))) bad("snapshot.groups", "hold a group no token belongs to");
        d.resources.forEach((r, i) => {
          const path4 = `snapshot.pools[${i}]`, pool = shape(v.pools[i], path4, ["id", "busy", "busyMinutes"]);
          if (pool.id !== r.id) bad(`${path4}.id`, `must be ${r.id} (pools follow the resource order)`);
          if (whole(pool.busy, `${path4}.busy`, 0, r.capacity) !== busy.get(r.id)) bad(`${path4}.busy`, "does not match the running work");
          whole(pool.busyMinutes, `${path4}.busyMinutes`);
        });
        history(d, w);
        maps(d, w);
      }
      function history(d, w) {
        const { v, at } = w, stepOrEmpty = (id, path4) => id === "" ? null : w.step(id, path4);
        list(v.events, "snapshot.events", limits.events).forEach((e, i) => {
          const path4 = `snapshot.events[${i}]`, box = shape(e, path4, ["minute", "kind", "caseId", "stepId", "detail"]);
          at(box.minute, `${path4}.minute`);
          text(box.kind, `${path4}.kind`, 40, KIND);
          text(box.caseId, `${path4}.caseId`, 24, CASE);
          stepOrEmpty(box.stepId, `${path4}.stepId`);
          text(box.detail, `${path4}.detail`, 2e4);
        });
        list(v.receipts, "snapshot.receipts", limits.receipts).forEach((r, i) => {
          const path4 = `snapshot.receipts[${i}]`;
          const box = shape(r, path4, ["id", "caseId", "stepId", "started", "finished", "input", "output", "changes"], ["duration", "instances"]);
          text(box.id, `${path4}.id`, 200);
          text(box.caseId, `${path4}.caseId`, 24, CASE);
          w.step(box.stepId, `${path4}.stepId`);
          at(box.started, `${path4}.started`);
          at(box.finished, `${path4}.finished`);
          for (const key of ["input", "output", "changes"]) fieldsOf(box[key], `${path4}.${key}`);
          if (box.duration !== void 0) whole(box.duration, `${path4}.duration`);
          if (box.instances !== void 0) whole(box.instances, `${path4}.instances`, 1, 50);
        });
        whole(v.receiptsDropped, "snapshot.receiptsDropped");
        list(v.streams, "snapshot.streams", d.arrivals.length, d.arrivals.length).forEach((st, i) => {
          const path4 = `snapshot.streams[${i}]`, box = shape(st, path4, ["k", "at"]), arrival = d.arrivals[i];
          whole(box.k, `${path4}.k`, 0, arrival.count ?? SAFE);
          const h = d.workingHours, after = (n) => root2.LWProcessHours.at(h, n) > w.minute ? n : bad(`${path4}.at`, "must begin after the clock minute");
          nullable(box.at, (n) => h ? after(whole(n, `${path4}.at`)) : whole(n, `${path4}.at`, w.minute + 1));
        });
      }
      function maps(d, w) {
        const { v, live } = w, tracked = new Set((d.track ?? []).map((t) => t.field));
        const pairs = (value, path4) => list(value, path4, MAX_TOKENS).map((p, i) => {
          const pair = list(p, `${path4}[${i}]`, 2, 2);
          return [text(pair[0], `${path4}[${i}][0]`, 200), pair[1], `${path4}[${i}]`];
        });
        const caseKey = (id, path4) => {
          if (!live.has(id)) bad(path4, "names no active case");
        };
        const keys = (entries, path4) => unique(entries.map((e) => e[0]), path4);
        const visits = pairs(v.visits, "snapshot.visits");
        keys(visits, "snapshot.visits");
        for (const [id, inner, path4] of visits) {
          caseKey(id, path4);
          const steps = pairs(inner, `${path4}[1]`);
          keys(steps, `${path4}[1]`);
          for (const [stepId, n, at] of steps) {
            if (stepId !== "#escalations") w.step(stepId, at);
            whole(n, at, 1);
          }
        }
        const outcomes = pairs(v.outcomes, "snapshot.outcomes");
        keys(outcomes, "snapshot.outcomes");
        for (const [id, o, path4] of outcomes) {
          caseKey(id, path4);
          if (o !== "goal" && o !== "lost") bad(path4, "must be goal or lost");
        }
        const seen = pairs(v.seen, "snapshot.seen");
        keys(seen, "snapshot.seen");
        for (const [id, ids, path4] of seen) {
          caseKey(id, path4);
          unique(list(ids, path4, d.steps.length).map((s, i) => w.step(s, `${path4}[1][${i}]`).id), path4);
        }
        const aggregate = (a, path4) => {
          const box = shape(a, path4, ["n", "sum", "min", "max"]);
          whole(box.n, `${path4}.n`, 1);
          for (const key of ["sum", "min", "max"]) finite(box[key], `${path4}.${key}`);
        };
        const finish = pairs(v.finishAgg, "snapshot.finishAgg"), entry = pairs(v.entryAgg, "snapshot.entryAgg");
        keys(finish, "snapshot.finishAgg");
        keys(entry, "snapshot.entryAgg");
        for (const [field, a, path4] of finish) {
          if (!tracked.has(field)) bad(path4, "names no tracked field");
          aggregate(a, `${path4}[1]`);
        }
        for (const [key, a, path4] of entry) {
          const [stepId, field] = key.split("|");
          w.step(stepId, path4);
          if (!tracked.has(field ?? "")) bad(path4, "names no tracked field");
          aggregate(a, `${path4}[1]`);
        }
      }
      function ledger(d, input, w) {
        const p = "snapshot.ledger", n = d.steps.length, FINE = 54;
        const l = shape(input, p, [
          "steps",
          "cycles",
          "minutesBy",
          "failedAt",
          "wipArea",
          "fine",
          "books",
          "leadTime",
          "flow",
          "completedCost",
          "failedCost",
          "failedMinutes",
          "firstPass",
          "repeats",
          "ring",
          "head",
          "exact"
        ], ["closedBy"]);
        const hours = !!d.workingHours, lead = hours ? 7 : 6;
        if (hours !== Object.hasOwn(l, "closedBy")) bad(`${p}.closedBy`, hours ? "is missing for a process with working hours" : "is not a known field");
        if (hours) counts(l.closedBy, `${p}.closedBy`, n);
        list(l.steps, `${p}.steps`, n, n).forEach((s, i) => {
          const box = shape(s, `${p}.steps[${i}]`, ["starts", "fixedCost", "workCost"]);
          for (const key of ["starts", "fixedCost", "workCost"]) whole(box[key], `${p}.steps[${i}].${key}`);
        });
        counts(l.cycles, `${p}.cycles`, 17);
        counts(l.minutesBy, `${p}.minutesBy`, n * 6);
        counts(l.failedAt, `${p}.failedAt`, n);
        for (const key of ["wipArea", "completedCost", "failedCost", "failedMinutes", "firstPass"]) whole(l[key], `${p}.${key}`);
        counts(l.leadTime, `${p}.leadTime`, lead);
        counts(l.flow, `${p}.flow`, 10);
        counts(l.repeats, `${p}.repeats`, 6);
        const fine = shape(l.fine, `${p}.fine`, ["cycle", "failed", "outcomes", "steps"]), outcomes = d.steps.some((s) => s.kind === "end" && s.outcome);
        counts(fine.cycle, `${p}.fine.cycle`, FINE);
        counts(fine.failed, `${p}.fine.failed`, FINE);
        if (outcomes === (fine.outcomes === null)) bad(`${p}.fine.outcomes`, outcomes ? "is missing for a process with outcomes" : "must be null");
        if (fine.outcomes !== null) {
          const byOutcome = shape(fine.outcomes, `${p}.fine.outcomes`, ["goal", "lost", "none"]);
          for (const key of ["goal", "lost", "none"]) counts(byOutcome[key], `${p}.fine.outcomes.${key}`, FINE);
        }
        list(fine.steps, `${p}.fine.steps`, n, n).forEach((s, i) => {
          list(s, `${p}.fine.steps[${i}]`, 3, 3).forEach((c, j) => counts(c, `${p}.fine.steps[${i}][${j}]`, FINE));
        });
        const running = new Set(w.v.tokens.filter((t) => t.status === "active").map((t) => t.caseId)), books = /* @__PURE__ */ new Set();
        list(l.books, `${p}.books`, w.active).forEach((b, i) => {
          const path4 = `${p}.books[${i}]`, pair = list(b, path4, 2, 2), id = text(pair[0], `${path4}[0]`, 24, CASE);
          if (!w.live.has(id) || books.has(id)) bad(`${path4}[0]`, "names no active case or repeats one");
          books.add(id);
          const box = shape(pair[1], `${path4}[1]`, ["lead", "cost", "repeats"]);
          counts(box.lead, `${path4}[1].lead`, lead);
          whole(box.cost, `${path4}[1].cost`);
          whole(box.repeats, `${path4}[1].repeats`);
        });
        for (const id of running) if (!books.has(id)) bad(`${p}.books`, `has no book for ${id}, which has running work`);
        const ring = list(l.ring, `${p}.ring`, w.retained);
        ring.forEach((r, i) => {
          const path4 = `${p}.ring[${i}]`, box = shape(r, path4, ["caseId", "entered", "finished", "status", "end", "outcome", "repeats", "working"]);
          text(box.caseId, `${path4}.caseId`, 24, CASE);
          w.at(box.entered, `${path4}.entered`);
          w.at(box.finished, `${path4}.finished`);
          if (box.status !== "completed" && box.status !== "failed") bad(`${path4}.status`, "must be completed or failed");
          nullable(box.end, (e) => w.step(e, `${path4}.end`));
          if (![null, "goal", "lost"].includes(box.outcome)) bad(`${path4}.outcome`, "must be goal, lost or null");
          whole(box.repeats, `${path4}.repeats`);
          nullable(box.working, (x) => whole(x, `${path4}.working`));
        });
        whole(l.head, `${p}.head`, 0, ring.length < w.retained ? 0 : w.retained - 1);
        exact(l.exact, fine, w);
      }
      function exact(input, fine, w) {
        const p = "snapshot.ledger.exact", clock = w.v.clock, edges = root2.LWProcessLedger.FINE;
        const e = shape(input, p, ["limit", "completed", "over", "cycle", "outcomes"]);
        const limit = whole(e.limit, `${p}.limit`, 1, root2.LWProcessLedgerExact.LIMIT);
        if (whole(e.completed, `${p}.completed`) !== clock.completed) bad(`${p}.completed`, "must equal the completed cases of the clock");
        if (e.over !== clock.completed > limit) bad(`${p}.over`, `must be ${clock.completed > limit}: it says whether more than ${limit} cases completed`);
        if (fine.outcomes === null !== (e.outcomes === null)) bad(`${p}.outcomes`, fine.outcomes === null ? "must be null" : "is missing");
        const kept = (v, path4, bins) => {
          const box = shape(v, path4, ["values", "ordered"]);
          const values = list(box.values, `${path4}.values`, e.over ? 0 : limit).map((x, i) => whole(x, `${path4}.values[${i}]`, 0, w.minute));
          const ordered = whole(box.ordered, `${path4}.ordered`, 0, values.length);
          for (let i = 1; i < ordered; i++) if (values[i - 1] > values[i]) bad(`${path4}.values`, `are not ascending in their first ${ordered}`);
          if (e.over) return values.length;
          const counts2 = edges.map(() => 0);
          for (const x of values) counts2[root2.LWProcessLedger.fineBin(x)]++;
          if (counts2.some((n2, i) => n2 !== bins[i])) bad(`${path4}.values`, "do not match the fine bins of the ledger");
          return values.length;
        };
        const n = kept(e.cycle, `${p}.cycle`, fine.cycle);
        if (!e.over && n !== clock.completed) bad(`${p}.cycle.values`, "must hold one lead time per completed case");
        if (e.outcomes !== null) {
          const o = shape(e.outcomes, `${p}.outcomes`, ["goal", "lost", "none"]), f = fine.outcomes;
          for (const key of ["goal", "lost", "none"]) kept(o[key], `${p}.outcomes.${key}`, f[key]);
        }
      }
      function series(d, input, minute) {
        if (input === null) return;
        const p = "snapshot.series", s = shape(input, p, ["every", "points", "level", "count", "data", "previous", "peaks"]);
        const base = whole(s.every, `${p}.every`, 1, 1e4), requested = whole(s.points, `${p}.points`, 64, 960);
        const width = 12 + 11 * d.steps.length + 2 * d.resources.length, points = Math.min(requested, Math.floor(4e5 / width));
        let level = 0;
        while (Math.floor(minute / (base * 2 ** level)) + 1 > points) level++;
        const every = base * 2 ** level, count = Math.floor(minute / every) + 1;
        if (s.level !== level || s.count !== count) bad(p, `must hold ${count} samples at level ${level} for minute ${minute}`);
        const data = list(s.data, `${p}.data`, count * width, count * width).map((x, i) => finite(x, `${p}.data[${i}]`));
        for (let i = 0; i < count; i++) if (data[i * width] !== i * every) bad(`${p}.data`, `sample ${i} is not on the grid of every ${every} minutes`);
        const h = d.workingHours, frame = width + (h ? 2 : 1);
        const previous = list(s.previous, `${p}.previous`, frame, frame).map((x, i) => finite(x, `${p}.previous[${i}]`));
        if (previous[0] !== minute) bad(`${p}.previous`, "must be the frame of the clock minute");
        if (h && previous[frame - 1] !== (root2.LWProcessHours.open(h, minute) ? 1 : 0)) bad(`${p}.previous`, "does not say whether the clock minute is open");
        list(s.peaks, `${p}.peaks`, width, width).forEach((x, i) => finite(x, `${p}.peaks[${i}]`));
      }
      root2.LWProcessCheckpointCheck = { MAX_VALUES, plain, state };
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessCheckpointCheck;
    })(globalThis);
  }
});

// ../wildlands/source/process-checkpoint.ts
var require_process_checkpoint = __commonJS({
  "../wildlands/source/process-checkpoint.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const KIND = "wildlands-process-checkpoint", VERSION = 1, MAX_BYTES = 16 * 1024 * 1024, MAX_SEED = 2147483647;
      const FIELDS = ["kind", "version", "process", "fingerprint", "seed", "minute", "runLength", "snapshot"];
      const ID = /^[a-z][a-z0-9-]{0,63}$/, FINGERPRINT = /^[0-9a-f]{16}$/;
      const whole = (v, min, max = Number.MAX_SAFE_INTEGER) => Number.isSafeInteger(v) && v >= min && v <= max;
      function create2(definition, runLength, snapshot) {
        const copy = JSON.parse(JSON.stringify(snapshot));
        return {
          kind: KIND,
          version: VERSION,
          process: definition.id,
          fingerprint: root2.LWProcessCatalog.fingerprint(definition),
          seed: copy.seed,
          minute: copy.clock.minute,
          runLength,
          snapshot: copy
        };
      }
      function header(value) {
        if (value === null || typeof value !== "object" || Array.isArray(value)) throw Error("This file is not a run checkpoint: it is not a JSON object.");
        const c = value;
        if (c.kind !== KIND) throw Error(`This file is not a Wildlands run checkpoint: its kind must be "${KIND}".`);
        if (c.version !== VERSION) throw Error(`This run checkpoint has version ${JSON.stringify(c.version)}; only version ${VERSION} can be read.`);
        const unknown = Object.keys(c).filter((key) => !FIELDS.includes(key)), missing = FIELDS.filter((key) => !Object.hasOwn(c, key));
        if (unknown.length) throw Error(`This run checkpoint has an unknown field: ${unknown[0].slice(0, 64)}.`);
        if (missing.length) throw Error(`This run checkpoint is missing its ${missing[0]} field.`);
        if (typeof c.process !== "string" || !ID.test(c.process)) throw Error("The checkpoint's process must be a process id.");
        if (typeof c.fingerprint !== "string" || !FINGERPRINT.test(c.fingerprint)) throw Error("The checkpoint's fingerprint must be 16 hex digits.");
        if (!whole(c.seed, 0, MAX_SEED)) throw Error(`The checkpoint's seed must be a whole number from 0 to ${MAX_SEED}.`);
        if (!whole(c.minute, 0)) throw Error("The checkpoint's minute must be a whole number of minutes (0 or more).");
        if (c.runLength !== null && !whole(c.runLength, Math.max(1, c.minute))) {
          throw Error("The checkpoint's run length must be null or a whole number of minutes, at least 1 and not before its minute.");
        }
        if (c.snapshot === null || typeof c.snapshot !== "object" || Array.isArray(c.snapshot)) throw Error("The checkpoint's snapshot must be an object.");
        return c;
      }
      function parse(text) {
        if (typeof text !== "string") throw Error("A run checkpoint is read from text.");
        if (text.length > MAX_BYTES) throw Error("This file is larger than 16 MiB, the largest run checkpoint that is read.");
        let value;
        try {
          value = JSON.parse(text.replace(/^﻿/, ""));
        } catch {
          throw Error("This file is not a run checkpoint: it is not valid JSON.");
        }
        return header(root2.LWProcessCheckpointCheck.plain(value, "checkpoint"));
      }
      function verify(checkpoint, definition) {
        const c = header(root2.LWProcessCheckpointCheck.plain(checkpoint, "checkpoint"));
        if (c.process !== definition.id) throw Error(`This checkpoint belongs to the process ${c.process}, not to ${definition.id}.`);
        const fingerprint = root2.LWProcessCatalog.fingerprint(definition);
        if (c.fingerprint !== fingerprint) {
          throw Error(`This checkpoint was saved from definition fingerprint ${c.fingerprint}, but the applied definition of ${definition.name} has fingerprint ${fingerprint}. Import or apply the definition the checkpoint was saved from, then load the checkpoint again.`);
        }
        let snapshot;
        try {
          snapshot = root2.LWProcessCheckpointCheck.state(definition, c.snapshot);
        } catch (e) {
          throw Error("The checkpoint's run state is not valid for this process: " + (e instanceof Error ? e.message : String(e)));
        }
        if (snapshot.seed !== c.seed || snapshot.clock.minute !== c.minute) throw Error("The checkpoint's seed and minute do not match its run state.");
        return { ...c, snapshot };
      }
      root2.LWProcessCheckpoint = { KIND, VERSION, MAX_BYTES, create: create2, parse, verify };
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessCheckpoint;
    })(globalThis);
  }
});

