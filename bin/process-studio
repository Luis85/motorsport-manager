        s.receipts.push({
          id,
          caseId: c.id,
          stepId: step.id,
          started: began,
          finished: s.clock.minute,
          input: { ...group ? group.input : t.input },
          output: { ...c.data },
          changes,
          ...step.timing ? { duration: s.clock.minute - began } : {},
          ...group ? { instances: group.count } : {}
        });
        if (s.receipts.length > limits.receipts) {
          s.receipts.shift();
          s.receiptsDropped++;
        }
        if (event_) event(s, event_, c.id, step.id);
        return true;
      }
