          scenarios: root2.LWProcessBpmnBpsim.scenarios(doc),
          participants: participants.map((p) => ({ id: p.attrs.id ?? "", name: label(p), process: p.attrs.processRef ?? null }))
        };
      }
      function fidelity(input, options2 = {}) {
