// ../wildlands/source/process-bpmn-graph.ts
var require_process_bpmn_graph = __commonJS({
  "../wildlands/source/process-bpmn-graph.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const { MODEL } = root2.LWProcessBpmnExport.vocabulary;
      const ext = () => root2.LWProcessBpmnExt, nodes = () => root2.LWProcessBpmnNodes;
      const kids = (n, local, ns) => ext().kids(n, local, ns), first = (n, local) => ext().first(n, local);
      const MAX_DEPTH = 3;
      const FOLD = 4;
      function bound() {
        const p = root2.LWProcessCatalog.schema.properties, steps = p.steps.maxItems, flows = p.flows.maxItems;
        return { steps, flows, nodes: steps * FOLD, edges: flows * FOLD };
      }
      const isFlowNode = (local) => {
        const n = nodes();
        return local.endsWith("Event") || Object.hasOwn(n.GATEWAYS, local) || [...n.PLAIN, ...n.SERVICE, ...n.CONTAINERS].includes(local);
      };
      function written(proc) {
        let found = 0, flows = 0;
        const walk = (n) => {
          for (const c of n.children) {
            if (c.ns !== MODEL) continue;
            if (c.local === "sequenceFlow") flows++;
            else if (isFlowNode(c.local)) {
              found++;
              walk(c);
            }
          }
        };
        walk(proc);
        return { nodes: found, flows };
      }
      const count = (n) => n.toLocaleString("en-US");
      function tooLarge(b, found) {
        return Error("This process is too large to import: " + found + ", but a Wildlands process holds at most " + b.steps + " steps and " + b.flows + " flows. Import reads at most " + count(b.nodes) + " flow nodes and " + count(b.edges) + " sequence flows, which leaves room for events and gateways that fold away; split the model into smaller processes.");
      }
      function build2(ctx, proc) {
        const net = { items: [], edges: [], byKey: /* @__PURE__ */ new Map(), lanes: /* @__PURE__ */ new Map(), callees: /* @__PURE__ */ new Set(), ignored: /* @__PURE__ */ new Map() }, boundaries = [];
