var require_process_series = __commonJS({
  "../wildlands/source/process-series.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const BUDGET = 4e5, RUN = 12, STEP = 11, POOL = 2;
      const MINUTE = 0, GAUGE = 1, EVENT = 2, CHARGED = 3, PEAK = 4;
      const WIP_AREA = 10;
      const RUN_NAMES = ["wip", "wipPeak", "arrived", "completed", "failed", "dropped", "goals", "lost", "cycleSum", "wipArea", "cost"];
      const STEP_NAMES = [
        "waiting",
        "working",
        "blocked",
        "timers",
        "waitingPeak",
        "starts",
        "completed",
        "entered",
        "waitMinutes",
        "waitingArea",
        "blockedArea"
      ];
      const whole = (value, min, max) => Number.isSafeInteger(value) && value >= min && value <= max;
      function create2(definition, options2 = {}) {
        if (options2 === null || typeof options2 !== "object") throw Error("Series options must be false or an object with every and points.");
        const every = options2.every ?? 60, requested = options2.points ?? 480;
        if (!whole(every, 1, 1e4)) throw Error("Series spacing (every) must be a whole number of minutes from 1 to 10000.");
        if (!whole(requested, 64, 960)) throw Error("Series points must be a whole number from 64 to 960.");
        const steps = definition.steps.map((s) => s.id), pools = definition.resources.map((r) => r.id), width = RUN + STEP * steps.length + POOL * pools.length;
        const kinds = new Int8Array(width), sources = new Int32Array(width);
        const set = (column, kind, source = 0) => {
          kinds[column] = kind;
          sources[column] = source;
        };
        set(0, MINUTE);
        set(1, GAUGE);
        set(2, PEAK, 1);
        for (let c = 3; c <= 9; c++) set(c, EVENT);
        set(10, CHARGED, 1);
        set(11, CHARGED, width);
        steps.forEach((_, i) => {
          const at = RUN + STEP * i;
          for (let c = 0; c < 4; c++) set(at + c, GAUGE);
          set(at + 4, PEAK, at);
          for (let c = 5; c < 9; c++) set(at + c, EVENT);
          set(at + 9, CHARGED, at);
          set(at + 10, CHARGED, at + 2);
        });
        pools.forEach((_, i) => {
          const at = RUN + STEP * steps.length + POOL * i;
          set(at, GAUGE);
          set(at + 1, CHARGED, at);
        });
        const points = Math.min(requested, Math.floor(BUDGET / width)), peakColumns = [...kinds.keys()].filter((c) => kinds[c] === PEAK);
        return {
          steps,
          pools,
          costs: definition.resources.map((r) => r.costPerMinute),
          base: every,
          every,
          level: 0,
          points,
          requested,
          width,
          kinds,
          sources,
          peakColumns,
          data: new Float64Array(Math.min(points, 64) * width),
          count: 0,
          previous: null,
          live: new Float64Array(width + 2),
          peaks: new Float64Array(width).fill(-1),
          stations: null,
          poolState: null
        };
      }
      function capture(store, s, frame) {
        const ledger = s.ledger, clock = s.clock, counts = root2.LWProcessLedger.profile(ledger, root2.LWProcessKernel.tokens(s)).counts;
        store.stations ??= store.steps.map((id) => root2.LWProcessKernel.station(s, id));
        store.poolState ??= store.pools.map((id) => root2.LWProcessKernel.pool(s, id));
        const wip = clock.arrived - clock.completed - clock.failed, run2 = [
          clock.minute,
          wip,
          wip,
          clock.arrived,
          clock.completed,
          clock.failed,
          clock.dropped,
          clock.goals,
          clock.lost,
          clock.cycle,
          ledger.wipArea,
          clock.cost
        ];
        for (let c = 0; c < RUN; c++) frame[c] = run2[c];
        const by = root2.LWProcessLedger.BUCKETS.length, area = ledger.minutesBy;
        for (let i = 0; i < store.stations.length; i++) {
          const at = RUN + STEP * i, k = i * by, station = store.stations[i];
          frame[at] = counts[k + 1];
          frame[at + 1] = counts[k];
          frame[at + 2] = counts[k + 2];
          frame[at + 3] = counts[k + 4];
          frame[at + 4] = counts[k + 1];
          frame[at + 5] = ledger.stepCosts[i].starts;
          frame[at + 6] = station.completed;
          frame[at + 7] = station.visits;
          frame[at + 8] = station.waitMinutes;
          frame[at + 9] = area[k + 1];
          frame[at + 10] = area[k + 2];
        }
        let costRate = 0;
        store.poolState.forEach((pool, i) => {
          const at = RUN + STEP * store.steps.length + POOL * i;
          frame[at] = pool.busy;
          frame[at + 1] = pool.busyMinutes;
          costRate += pool.busy * store.costs[i];
        });
        frame[store.width] = costRate;
        const hours = s.definition.workingHours;
        frame[store.width + 1] = hours && !root2.LWProcessHours.open(hours, clock.minute) ? 0 : 1;
      }
      function fold(store, frame) {
        for (const c of store.peakColumns) store.peaks[c] = Math.max(store.peaks[c], frame[store.sources[c]]);
      }
      function record(store, g, frame, from) {
        const w = store.width;
        if ((store.count + 1) * w > store.data.length) {
          const grown = new Float64Array(Math.min(store.points, store.data.length / w * 2) * w);
          grown.set(store.data);
          store.data = grown;
        }
        const row = store.count * w, data = store.data, open = frame[w + 1] === 1;
        for (let c = 0; c < w; c++) {
          const kind = store.kinds[c];
          if (kind === MINUTE) data[row + c] = g;
          else if (kind === CHARGED) data[row + c] = frame[c] + (open || c === WIP_AREA ? frame[store.sources[c]] * (g - from) : 0);
          else if (kind === PEAK) data[row + c] = store.peaks[c];
          else data[row + c] = frame[c];
        }
        store.count++;
        store.peaks.fill(-1);
      }
      function decimate(store) {
        const w = store.width, data = store.data, carried = new Float64Array(w);
        let kept = 0;
        for (let i = 0; i < store.count; i += 2) {
          if (i > 0) carried.set(data.subarray((i - 1) * w, i * w));
          data.copyWithin(kept * w, i * w, (i + 1) * w);
          if (i > 0) for (const c of store.peakColumns) data[kept * w + c] = Math.max(data[kept * w + c], carried[c]);
          kept++;
        }
        const last = (store.count - 1) * w;
        if (store.count % 2 === 0) for (const c of store.peakColumns) store.peaks[c] = Math.max(store.peaks[c], data[last + c]);
        store.count = kept;
        store.every *= 2;
        store.level++;
      }
      function observe(store, s) {
        const live = store.live, previous = store.previous, m = s.clock.minute;
        if (previous && m <= previous[0]) return;
        capture(store, s, live);
        if (previous) {
          const p = previous[0];
          while (Math.floor(m / store.every) + 1 > store.points) decimate(store);
          let g = (Math.floor(p / store.every) + 1) * store.every;
          for (; g < m; g += store.every) {
            fold(store, previous);
            record(store, g, previous, p);
          }
          const before = Math.floor((m - 1) / store.every) * store.every;
          if (Math.max(p, before) + 1 < m) fold(store, previous);
        }
        fold(store, live);
        if (m % store.every === 0) record(store, m, live, m);
        store.live = previous ?? new Float64Array(store.width + 2);
        store.previous = live;
      }
      function read(store, after) {
        if (after !== void 0 && (after === null || typeof after !== "object" || !whole(after.level, 0, 64) || !whole(after.count, 0, Number.MAX_SAFE_INTEGER))) {
          throw Error("A series cursor needs a whole level and count.");
        }
        const offset = after && after.level === store.level ? Math.min(after.count, store.count) : 0, w = store.width;
        const column = (c) => Array.from({ length: store.count - offset }, (_, i) => store.data[(offset + i) * w + c]);
        const block = (names, at) => Object.fromEntries(names.map((name, i) => [name, column(at + i)]));
        return {
          base: store.base,
          every: store.every,
          level: store.level,
          points: store.points,
          perSample: w,
          count: store.count,
          offset,
          minutes: column(0),
          run: block(RUN_NAMES, 1),
          steps: Object.fromEntries(store.steps.map((id, i) => [id, block(STEP_NAMES, RUN + STEP * i)])),
          pools: Object.fromEntries(store.pools.map((id, i) => [id, block(["busy", "busyMinutes"], RUN + STEP * store.steps.length + POOL * i)]))
        };
      }
      root2.LWProcessSeries = { BUDGET, create: create2, observe, read };
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessSeries;
    })(globalThis);
  }
