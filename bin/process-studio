        if (order === "lifo") return (a, b) => base(b, a);
        return order === "priority" ? (a, b) => rank(b) - rank(a) || base(a, b) : base;
      };
      const unmet = (s, c, step) => (step.needs ?? []).find((n) => !root2.LWProcessNeeds.holds(n, c.data));
      function failNeed(s, c, step, need) {
        const label = need.label ? " (" + need.label + ")" : "";
        fail(s, c, 'Step "' + step.name + '" needs ' + root2.LWProcessNeeds.describe(need) + label + " but earlier steps did not deliver it.", step.id);
      }
      function note(map, key, value) {
        if (typeof value !== "number" || !Number.isFinite(value)) return;
        const a = map.get(key);
        if (!a) {
          map.set(key, { n: 1, sum: value, min: value, max: value });
          return;
        }
        a.n++;
        a.sum += value;
        a.min = Math.min(a.min, value);
        a.max = Math.max(a.max, value);
      }
      function journey(s, t, stepId) {
        let seen = s.seen.get(t.caseId);
        if (!seen) {
          seen = /* @__PURE__ */ new Set();
          s.seen.set(t.caseId, seen);
