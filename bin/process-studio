      function importBpmn2(source, options2 = {}) {
        const r = analyze(source, options2);
        if (r.rejections.length) throw Error(r.rejections.map((x) => x.message).join("\n"));
        return r;
      }
      function inspect2(source) {
        const doc = root2.LWProcessXml.parse(source);
        if (doc.ns !== MODEL || doc.local !== "definitions") throw Error("Expected a BPMN 2.0 definitions document.");
        const collab = kids(doc, "collaboration")[0], participants = collab ? kids(collab, "participant") : [];
        const refs = new Map(participants.filter((p) => p.attrs.processRef).map((p) => [p.attrs.processRef, p.attrs.name ?? p.attrs.id ?? ""]));
        const count = (n, into) => {
          for (const c of n.children) {
            if (c.ns !== MODEL || !/(Task|Event|Gateway|Process|callActivity|Flow)$/.test(c.local) || c.local === "sequenceFlow") continue;
            into[c.local] = (into[c.local] ?? 0) + 1;
