        if (d.dist === "triangular") return `Random between ${num(d.min)} and ${num(d.max)} min, most often ${num(d.mode)}`;
        if (d.dist === "normal") return `Normal, mean ${num(d.mean)} min, sd ${num(d.sd)}${bounds(d)}`;
