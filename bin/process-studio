var require_process_bpmn_expr = __commonJS({
  "../wildlands/source/process-bpmn-expr.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const OPS = {
        "==": "eq",
        "=": "eq",
        eq: "eq",
        "!=": "ne",
        ne: "ne",
        ">": "gt",
        gt: "gt",
        ">=": "gte",
        ge: "gte",
        gte: "gte",
        "<": "lt",
        lt: "lt",
        "<=": "lte",
        le: "lte",
        lte: "lte"
      };
      const SYMBOLS = { eq: "==", ne: "!=", gt: ">", gte: ">=", lt: "<", lte: "<=" };
      const FLIP = { eq: "eq", ne: "ne", gt: "lt", gte: "lte", lt: "gt", lte: "gte" };
      const FIELD = /^[a-z][a-zA-Z0-9_]{0,63}$/, MAX_LEAVES = 8, MAX_LEVELS = 3, MAX_LIST = 8;
      const SYMBOL_KINDS = { "&&": "and", "||": "or", "!": "not", "(": "open", ")": "close" };
      function wordKind(w) {
        const lower = w.toLowerCase();
        if (lower === "and") return "and";
        if (lower === "or") return "or";
        if (lower === "not") return "not";
        if (Object.hasOwn(OPS, lower) && lower.length > 1 && /^[a-z]+$/.test(w) && lower === w) return "cmp";
        if (["true", "false", "null"].includes(w)) return "lit";
        return "id";
      }
      function tokens(text) {
        const out = [];
        let i = 0;
        while (i < text.length) {
          const rest = text.slice(i), space = /^\s+/.exec(rest);
          if (space) {
            i += space[0].length;
            continue;
          }
          const sym = /^(&&|\|\||==|!=|>=|<=|>|<|=|!|\(|\))/.exec(rest);
          if (sym) {
            const s = sym[1];
            i += s.length;
            out.push({ t: SYMBOL_KINDS[s] ?? "cmp", v: s });
            continue;
          }
          const num = /^-?\d+(?:\.\d+)?/.exec(rest), str = /^'([^']*)'|^"([^"]*)"/.exec(rest), word = /^[A-Za-z_][A-Za-z0-9_]*/.exec(rest);
          if (num) {
            out.push({ t: "num", v: num[0] });
            i += num[0].length;
          } else if (str) {
            out.push({ t: "str", v: str[1] ?? str[2] ?? "" });
            i += str[0].length;
          } else if (word) {
            const w = word[0];
            i += w.length;
            out.push({ t: wordKind(w), v: w });
          } else throw Error('unexpected character "' + rest[0] + '"');
        }
        return out;
      }
      function parse(input) {
        let text = input.trim();
        const wrapped = /^[$#]\{([\s\S]*)\}$/.exec(text);
        if (wrapped) text = wrapped[1].trim();
        if (!text) throw Error("the expression is empty");
        const toks = tokens(text);
        let at = 0;
        const peek = () => toks[at], take = () => toks[at++];
        const operand = () => {
          const t = take();
          if (!t) throw Error("the expression ends early");
          if (t.t === "num") return { value: Number(t.v) };
          if (t.t === "str") return { value: t.v };
          if (t.t === "lit") return { value: t.v === "true" ? true : t.v === "false" ? false : null };
          if (t.t === "id") {
            if (!FIELD.test(t.v)) throw Error('"' + t.v + '" is not a usable case field name (lower-case start, letters, digits and _)');
            return { field: t.v };
          }
          throw Error('expected a field or a value near "' + t.v + '"');
        };
        const comparison = () => {
          const left = operand(), next = peek();
          if (!next || next.t !== "cmp") {
            if ("field" in left) return { field: left.field, op: "eq", value: true };
            throw Error("a value alone is not a condition");
          }
          take();
          const right = operand();
          let op = OPS[next.v.toLowerCase()];
          if ("field" in left) return "field" in right ? { field: left.field, op, valueField: right.field } : { field: left.field, op, value: right.value };
          if ("field" in right) {
            op = FLIP[op];
            return { field: right.field, op, value: left.value };
          }
          throw Error("a comparison needs at least one case field");
        };
        const unary = () => {
          const t = peek();
          if (!t) throw Error("the expression ends early");
          if (t.t === "not") {
            take();
            return { not: unary() };
          }
          if (t.t === "open") {
            take();
            const inner = or();
            if (take()?.t !== "close") throw Error("a closing parenthesis is missing");
            return inner;
          }
          return comparison();
        };
        const join = (kind, next, stop) => {
          const list = [next()];
          while (peek()?.t === stop) {
            take();
            list.push(next());
          }
          if (list.length === 1) return list[0];
          return kind === "all" ? { all: list.flatMap((c) => c.all ?? [c]) } : { any: list.flatMap((c) => c.any ?? [c]) };
        };
        const and = () => join("all", unary, "and"), or = () => join("any", and, "or");
        const result = or();
        if (at < toks.length) throw Error('unexpected "' + toks[at].v + '"');
        check2(result);
        return result;
      }
      function check2(when) {
        let leaves = 0;
        const walk = (w, level) => {
          const list = w.all ?? w.any, kids = list ?? (w.not ? [w.not] : void 0);
          if (!kids) {
            if (++leaves > MAX_LEAVES) throw Error("it has more than " + MAX_LEAVES + " comparisons");
            return;
          }
          if (level > MAX_LEVELS) throw Error("it nests more than " + MAX_LEVELS + " levels of and/or/not");
          if (kids.length > MAX_LIST) throw Error("it joins more than " + MAX_LIST + " conditions");
          kids.forEach((k) => walk(k, level + 1));
        };
        walk(when, 1);
      }
      function plain(name) {
        if (["true", "false", "null"].includes(name)) return false;
        if (Object.hasOwn(OPS, name) && /^[a-z]+$/.test(name)) return false;
        return !["and", "or", "not"].includes(name.toLowerCase());
      }
      function operandText(c) {
        if (c.valueField !== void 0) return plain(c.valueField) ? c.valueField : void 0;
        if (typeof c.value === "string") return !c.value.includes("'") ? "'" + c.value + "'" : !c.value.includes('"') ? '"' + c.value + '"' : void 0;
        const t = JSON.stringify(c.value);
        return typeof c.value !== "number" || /^-?\d+(?:\.\d+)?$/.test(t) ? t : void 0;
      }
      function format(when) {
        if (when.chance !== void 0) return void 0;
        if (when.not) {
          const inner = format(when.not);
          return inner === void 0 ? void 0 : "!(" + inner + ")";
        }
        const list = when.all ?? when.any;
        if (list) {
          const parts = list.map((c) => {
            const t = format(c);
            return t === void 0 ? void 0 : c.all || c.any ? "(" + t + ")" : t;
          });
          return parts.some((p) => p === void 0) ? void 0 : parts.join(when.all ? " && " : " || ");
        }
        if (when.field === void 0 || !plain(when.field)) return void 0;
        const right = operandText(when);
        return right === void 0 ? void 0 : when.field + " " + SYMBOLS[when.op] + " " + right;
      }
      root2.LWProcessBpmnExpr = { parse, format, OPS, isField: (name) => FIELD.test(name) };
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessBpmnExpr;
