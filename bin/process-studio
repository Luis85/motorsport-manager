        for (let go = true; go; ) {
          go = false;
          for (const e of net.edges) {
            if (back.has(e.to) && !back.has(e.from)) {
              back.add(e.from);
              go = true;
            }
            if (fwd.has(e.from) && !fwd.has(e.to)) {
              fwd.add(e.to);
              go = true;
            }
          }
        }
