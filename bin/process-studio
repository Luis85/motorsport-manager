      }
      const rank = (q, n) => Math.max(1, Math.ceil(q * n / 100));
      function bracket(counts, edges, need) {
        let cum = 0, i = 0;
        for (; i < counts.length - 1; i++) {
          cum += counts[i];
          if (cum >= need) break;
        }
        return [edges[i], edges[i + 1] ?? null];
      }
      function percentiles(store, values2, counts, edges) {
