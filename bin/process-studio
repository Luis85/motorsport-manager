          const waits = fork ? `Waits until the branches started by ${quote(fork.name)} have arrived, then continues as one ${one}.` : `Waits for the branches of its fork, then continues as one ${one}.`;
          return [waits, ...s.backlog ? [backlogText(s, many)] : []];
        }
        if (s.kind === "timer") {
          if (s.until !== void 0) return [`Waits until minute ${number(s.until)} of the run; nobody works on it and no capacity is used.`];
          const plain = `Waits ${number(s.duration ?? 0)} min`, waits = dated(c.definition) ? `Waits ${span(s.duration ?? 0, c.definition)}` : plain;
          return [s.timing ? rv.describeTiming(s, c.definition.calendar) : waits, "Nobody works on it and no capacity is used."];
        }
        return [];
      }
      function backlogOrder(b) {
        if (b.order === "lifo") return "newest first";
        if (b.order === "priority") return `by priority field ${b.priority ?? "?"}`;
        return "oldest first";
      }
      function backlogText(s, many) {
        const b = s.backlog, order = backlogOrder(b);
        const pull = b.pull !== void 0 ? `; releases work while the next task has fewer than ${number(b.pull)} in progress` : "";
        return `Backlog: at most ${number(b.capacity)} ${many} wait here, taken ${order}${pull}.`;
      }
      function who(s, c) {
        const entries = Object.entries(s.resources ?? {}), items = entries.map(([id, units2]) => {
          const pool = c.pools.get(id);
          if (!pool) return `${id}: ${number(units2)} units`;
