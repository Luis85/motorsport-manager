var import_kit_source = __toESM(require_kit_source());

// src/payload.cts
var import_node_zlib = require("node:zlib");
var import_node_crypto5 = require("node:crypto");
var sha256 = (data) => (0, import_node_crypto5.createHash)("sha256").update(data).digest("hex");
function inflatePayload(item, what) {
  const raw = (0, import_node_zlib.inflateRawSync)(Buffer.from(item.data, "base64"), { maxOutputLength: item.bytes });
  if (raw.length !== item.bytes || sha256(raw) !== item.sha256) throw Error(`Embedded ${what} integrity failed. Rebuild bin/process-studio.`);
  return new TextDecoder("utf-8", { fatal: true }).decode(raw);
}

// src/kit.cts
function checkKit(kit) {
  const valid = kit.format === "process-studio-kit" && kit.schemaVersion === 1 && /^[0-9a-f]{64}$/.test(kit.engine) && typeof kit.templateText === "string" && Object.keys(kit.inserts).length > 0;
  if (!valid) throw Error("The process engine kit is malformed. Rebuild bin/process-studio.");
  return kit;
}
var cached = null;
function distribution() {
  if (cached) return cached;
  let embedded;
  try {
    embedded = require_process_studio_embedded();
  } catch (error) {
    if (error.code !== "MODULE_NOT_FOUND") throw error;
  }
  let kit = null;
  if (embedded) {
    const payload = embedded.kit;
    const load = () => checkKit(JSON.parse(inflatePayload(payload, "engine kit")));
    return cached = { kind: "bundle", sourceIdentity: embedded.sourceIdentity, kit: () => kit ??= load() };
  }
  return cached = { kind: "checkout", sourceIdentity: null, kit: () => kit ??= checkKit((0, import_kit_source.checkoutKit)()) };
}

