var require_process_engine_state = __commonJS({
  "../wildlands/source/process-engine-state.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const copy = (v) => JSON.parse(JSON.stringify(v));
      const pairs = (map, value) => [...map].map(([k, v]) => [k, value(v)]);
      const fill = (target, source) => {
        for (let i = 0; i < target.length; i++) target[i] = source[i];
      };
      const valuesOf = (v) => ({ values: Array.from(v.data.subarray(0, v.count)), ordered: v.ordered });
      function exactOf(e) {
        const o = e.outcomes;
        return {
          limit: e.limit,
          completed: e.completed,
          over: e.over,
          cycle: valuesOf(e.cycle),
          outcomes: o ? { goal: valuesOf(o.goal), lost: valuesOf(o.lost), none: valuesOf(o.none) } : null
        };
      }
      function exactFrom(saved) {
        const store = root2.LWProcessLedgerExact.create(saved.outcomes !== null, saved.limit), FIRST = 64;
        const fill2 = (v) => {
          const data = new Float64Array(v.values.length ? Math.min(saved.limit, Math.max(FIRST, v.values.length)) : 0);
          data.set(v.values);
          return { data, count: v.values.length, ordered: v.ordered };
        };
        store.completed = saved.completed;
        store.over = saved.over;
        store.cycle = fill2(saved.cycle);
        if (saved.outcomes) store.outcomes = { goal: fill2(saved.outcomes.goal), lost: fill2(saved.outcomes.lost), none: fill2(saved.outcomes.none) };
        return store;
      }
      function ledgerOf(s) {
        const l = s.ledger, c = l.cases, f = l.fine;
        return {
          steps: l.stepCosts.map((v) => ({ starts: v.starts, fixedCost: v.fixedCost, workCost: v.workCost })),
          cycles: [...l.cycles],
