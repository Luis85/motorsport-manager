          add(4, "<bpmn:extensionElements>");
          add(5, `<wl:demand quantity="${quantity}"/>`);
          add(4, "</bpmn:extensionElements>");
          add(4, `<bpmn:resourceRef>Resource_${id}</bpmn:resourceRef>`);
          add(3, "</bpmn:performer>");
        }
        if (s.instances) {
          const cardinality = s.instances.count !== void 0 ? s.instances.count : "${" + s.instances.field + "}";
          add(3, `<bpmn:multiInstanceLoopCharacteristics isSequential="${s.instances.mode === "sequential"}">`);
          add(4, `<bpmn:loopCardinality xsi:type="bpmn:tFormalExpression">${cardinality}</bpmn:loopCardinality>`);
          add(3, "</bpmn:multiInstanceLoopCharacteristics>");
        }
        add(2, `</bpmn:${element}>`);
        if (!s.deadline) return;
        const dl = s.deadline, minutes = dl.after ?? distMean(dl.timing);
        add(2, `<bpmn:boundaryEvent id="Boundary_${s.id}" name="Deadline" attachedToRef="${x.nodeId(s)}" cancelActivity="${dl.mode === "interrupt"}">`);
        add(3, "<bpmn:extensionElements>");
        add(4, `<wl:deadline${attrs({ mode: dl.mode, flow: dl.flow, after: dl.after })}/>`);
        if (dl.timing) add(4, `<wl:timing${distAttrs(dl.timing)}/>`);
        add(3, "</bpmn:extensionElements>");
        add(3, `<bpmn:outgoing>Flow_${dl.flow}</bpmn:outgoing>`);
        add(3, "<bpmn:timerEventDefinition>");
        add(4, `<bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT${minutes}M</bpmn:timeDuration>`);
        add(3, "</bpmn:timerEventDefinition>");
        add(2, "</bpmn:boundaryEvent>");
      }
      function sequenceFlows(x) {
        const { d, add } = x, source = (f) => f.on === "deadline" ? "Boundary_" + f.from : x.nodeId(x.steps.get(f.from));
        for (const f of d.flows) {
          add(2, `<bpmn:sequenceFlow id="Flow_${f.id}"${attrs({ name: f.label, sourceRef: source(f), targetRef: x.nodeId(x.steps.get(f.to)) })}>`);
          add(3, "<bpmn:extensionElements>");
          add(4, `<wl:flow id="${f.id}"/>`);
          if (f.when) whenLines(f.when, 4, add);
          add(3, "</bpmn:extensionElements>");
          if (f.when?.chance !== void 0) {
            add(3, `<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="${WL}#chance">${f.when.chance}%</bpmn:conditionExpression>`);
          }
          const expression = f.when && f.when.chance === void 0 ? root2.LWProcessBpmnExpr.format(f.when) : void 0;
          if (expression !== void 0) add(3, `<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">\${${code(expression)}}</bpmn:conditionExpression>`);
          add(2, "</bpmn:sequenceFlow>");
        }
      }
      function diagram(x, pid) {
        const { d, add } = x, minX = Math.min(...d.steps.map((s) => s.scene.position[0])), minY = Math.min(...d.steps.map((s) => s.scene.position[1]));
        const shape = (s) => {
          const [w, h] = SIZE[isWork(s) ? "task" : s.kind === "start" || s.kind === "end" || s.kind === "timer" ? "event" : "gateway"];
          return { w, h, cx: 150 + (s.scene.position[0] - minX) * UNIT, cy: 120 + (s.scene.position[1] - minY) * UNIT };
        };
        add(1, '<bpmndi:BPMNDiagram id="Diagram_1">');
        add(2, `<bpmndi:BPMNPlane id="Plane_1" bpmnElement="${pid}">`);
        for (const s of d.steps) {
          const b = shape(s);
          add(3, `<bpmndi:BPMNShape id="${x.nodeId(s)}_di" bpmnElement="${x.nodeId(s)}"${s.kind === "decision" ? ' isMarkerVisible="true"' : ""}>`);
          add(4, `<dc:Bounds x="${b.cx - b.w / 2}" y="${b.cy - b.h / 2}" width="${b.w}" height="${b.h}"/>`);
          add(3, "</bpmndi:BPMNShape>");
          if (!s.deadline) continue;
          add(3, `<bpmndi:BPMNShape id="Boundary_${s.id}_di" bpmnElement="Boundary_${s.id}">`);
          add(4, `<dc:Bounds x="${b.cx - 18}" y="${b.cy + b.h / 2 - 18}" width="36" height="36"/>`);
          add(3, "</bpmndi:BPMNShape>");
        }
        const edge = (a, b) => {
          const dx = b.cx - a.cx, dy = b.cy - a.cy;
          const clip = (s, sign) => {
            const k = Math.max(Math.abs(dx) / (s.w / 2), Math.abs(dy) / (s.h / 2)) || 1;
            return [s.cx + sign * dx / k, s.cy + sign * dy / k];
          };
          return [clip(a, 1), clip(b, -1)];
        };
        for (const f of d.flows) {
          const from = shape(x.steps.get(f.from)), start = f.on === "deadline" ? { w: 36, h: 36, cx: from.cx, cy: from.cy + from.h / 2 } : from;
          add(3, `<bpmndi:BPMNEdge id="Flow_${f.id}_di" bpmnElement="Flow_${f.id}">`);
          for (const [px, py] of edge(start, shape(x.steps.get(f.to)))) add(4, `<di:waypoint x="${Math.round(px * 10) / 10}" y="${Math.round(py * 10) / 10}"/>`);
          add(3, "</bpmndi:BPMNEdge>");
        }
        add(2, "</bpmndi:BPMNPlane>");
        add(1, "</bpmndi:BPMNDiagram>");
      }
      function exportBpmn2(input, options2 = {}) {
        const d = root2.LWProcessCatalog.validate(input, true).definition;
        if (!d) throw Error("Only a structurally valid process definition can be exported.");
        const pid = "Process_" + d.id, inclusiveJoins = new Set(d.steps.filter((s) => s.kind === "fork" && s.mode === "inclusive").map((s) => s.join));
        const prefix = (s) => s.kind === "start" ? "StartEvent_" : s.kind === "end" ? "EndEvent_" : s.kind === "timer" ? "Event_" : isWork(s) ? "Activity_" : "Gateway_";
        const out = [], add = (depth, line) => out.push(" ".repeat(depth * 2) + line), bpsim = options2.bpsim === true;
        const x = {
          d,
          add,
          steps: new Map(d.steps.map((s) => [s.id, s])),
          pools: new Map(d.resources.map((r) => [r.id, r])),
          nodeId: (s) => prefix(s) + s.id,
          normal: (id) => d.flows.filter((f) => f.from === id && f.on !== "deadline")
        };
        add(0, '<?xml version="1.0" encoding="UTF-8"?>');
        const namespaces = `xmlns:bpmn="${MODEL}" xmlns:bpmndi="${DI}" xmlns:dc="${DC}" xmlns:di="${DIAG}" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:wl="${WL}"${bpsim ? ` xmlns:bpsim="${BPSIM}"` : ""}`;
        add(0, `<bpmn:definitions ${namespaces}` + attrs({
          id: "Definitions_" + d.id,
          name: d.name,
          targetNamespace: "urn:wildlands:process:" + d.id,
          exporter: "Wildlands Process Studio",
          exporterVersion: "1"
        }) + ">");
        for (const r of d.resources) {
          add(1, `<bpmn:resource id="Resource_${r.id}" name="${esc(r.name)}">`);
          add(2, "<bpmn:extensionElements>");
          add(3, `<wl:resource id="${r.id}" capacity="${r.capacity}" costPerMinute="${r.costPerMinute}"${r.kind ? ` kind="${r.kind}"` : ""}/>`);
          add(2, "</bpmn:extensionElements>");
          add(1, "</bpmn:resource>");
        }
        add(1, `<bpmn:process id="${pid}" name="${esc(d.name)}" isExecutable="false">`);
        if (d.description !== void 0) add(2, `<bpmn:documentation>${xml2().text(d.description)}</bpmn:documentation>`);
        processExtension(x);
        laneSet(x);
        for (const s of d.steps) stepElement(x, s, inclusiveJoins);
        sequenceFlows(x);
        add(1, "</bpmn:process>");
        diagram(x, pid);
        if (bpsim) {
          if (!root2.LWProcessBpmnBpsimWrite) throw Error("The BPSim writer is not loaded.");
          add(1, '<bpmn:relationship type="BPSimData">');
          add(2, "<bpmn:extensionElements>");
          const ids = { node: x.nodeId, flow: (f) => "Flow_" + f.id, resource: (r) => "Resource_" + r.id, process: pid };
          root2.LWProcessBpmnBpsimWrite.write(d, ids, (depth, line) => add(depth + 2, line));
          add(2, "</bpmn:extensionElements>");
          add(2, `<bpmn:source>${pid}</bpmn:source>`);
          add(2, `<bpmn:target>${pid}</bpmn:target>`);
          add(1, "</bpmn:relationship>");
        }
        add(0, "</bpmn:definitions>");
        return out.join("\n") + "\n";
      }
      root2.LWProcessBpmnExport = { export: exportBpmn2, vocabulary: { MODEL, DI, DC, WL, BPSIM, UNIT, OPS: root2.LWProcessBpmnExpr.OPS, COLORS } };
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessBpmnExport;
    })(globalThis);
  }
});

