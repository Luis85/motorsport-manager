          const out = outOf(i.key).length;
          if (i.kind === "pass") return out === 1;
          if (i.gateway === "exclusive" || i.gateway === "event") return out === 1;
          return (i.gateway === "parallel" || i.gateway === "inclusive") && into(i.key) < 2 && out === 1;
        };
