          failedAt: [...l.failedAt],
          wipArea: l.wipArea,
          fine: { cycle: [...f.cycle], failed: [...f.failed], outcomes: f.outcomes ? copy(f.outcomes) : null, steps: copy(f.steps) },
          books: pairs(c.books, (b) => ({ lead: [...b.lead], cost: b.cost, repeats: b.repeats })),
          leadTime: [...c.leadTime],
          flow: [...c.flow],
