          finishAgg: [...s.finishAgg],
          entryAgg: [...s.entryAgg],
          ledger: ledgerOf(s),
          series: series ? seriesOf(series, !!s.definition.workingHours) : null
        });
      }
      function applyLedger(s, saved) {
        const l = s.ledger, c = l.cases, f = l.fine;
        saved.steps.forEach((v, i) => Object.assign(l.stepCosts[i], v));
        fill(l.cycles, saved.cycles);
        fill(l.minutesBy, saved.minutesBy);
        fill(l.failedAt, saved.failedAt);
        l.wipArea = saved.wipArea;
        fill(f.cycle, saved.fine.cycle);
