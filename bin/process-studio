// ../wildlands/source/process-checkpoint-check.ts
var require_process_checkpoint_check = __commonJS({
  "../wildlands/source/process-checkpoint-check.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
