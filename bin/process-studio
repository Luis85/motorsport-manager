          progress = false;
          for (const g of net.items.filter(passes)) {
            const o = outOf(g.key)[0];
            if (o.to === g.key) {
              settle();
              ctx.reject(g.xml, g.local, "Gateway " + g.xml + " loops onto itself.");
              return;
            }
            const target = list(ins, o.to, () => /* @__PURE__ */ new Set());
            target.delete(o);
            for (const e of ins.get(g.key) ?? []) {
