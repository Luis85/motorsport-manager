            reach.add(e.to);
            queue.push(e.to);
          }
        }
        const gone = net.items.filter((i) => !reach.has(i.key) && !i.synthetic);
        if (gone.length) ctx.warn("Pruned " + gone.length + " element(s) no longer reachable from the start: " + gone.map((i) => i.xml).join(", ") + ".");
