        }
        const n = counts.reduce((a, b) => a + b, 0);
        return { n, exact: false, points: n ? QUANTILES.map((q) => ({ q, exact: false, bracket: bracket(counts, edges, rank(q, n)) })) : [] };
      }
      function read(store, fine, edges) {
        const o = store.outcomes, f = fine.outcomes;
        return {
          limit: store.limit,
          quantiles: [...QUANTILES],
          cycle: percentiles(store, store.cycle, fine.cycle, edges),
