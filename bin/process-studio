// ../wildlands/source/process-ledger-cases.ts
var require_process_ledger_cases = __commonJS({
  "../wildlands/source/process-ledger-cases.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const WORKING = 0, CLOSED = 6, REPEAT_BINS = 6, FLOW_BINS = 10;
      const create2 = (retained, closed2 = false) => ({
        books: /* @__PURE__ */ new Map(),
        running: /* @__PURE__ */ new Set(),
        hours: closed2,
        leadTime: Array(closed2 ? 7 : 6).fill(0),
        flow: Array(FLOW_BINS).fill(0),
        completedCost: 0,
        failedCost: 0,
        failedMinutes: 0,
        firstPass: 0,
        repeats: Array(REPEAT_BINS).fill(0),
        ring: [],
        head: 0,
        capacity: retained
      });
      function book(store, caseId) {
        let entry = store.books.get(caseId);
        if (!entry) {
          entry = { lead: Array(store.hours ? 7 : 6).fill(0), cost: 0, rate: 0, repeats: 0 };
          store.books.set(caseId, entry);
        }
        return entry;
      }
      function started(store, caseId, fixed, perMinute) {
        const entry = book(store, caseId);
        entry.cost += fixed;
        if (!perMinute) return;
        entry.rate += perMinute;
        store.running.add(entry);
      }
      function released(store, caseId, perMinute) {
        const entry = store.books.get(caseId);
        if (!entry || !perMinute) return;
        entry.rate -= perMinute;
        if (!entry.rate) store.running.delete(entry);
      }
      function charge(store, books, buckets, minutes) {
        for (let i = 0; i < books.length; i++) books[i].lead[buckets[i]] += minutes;
        for (const entry of store.running) entry.cost += entry.rate * minutes;
      }
      function closed(_store, books, minutes) {
        for (const entry of books) entry.lead[CLOSED] += minutes;
      }
      const repeated = (store, caseId) => {
        book(store, caseId).repeats++;
      };
      function flowBin(working, lead) {
        if (!lead) return FLOW_BINS - 1;
        let bin = 0;
        while (bin < FLOW_BINS - 1 && (bin + 1) * lead <= 10 * working) bin++;
        return bin;
      }
      function remember(store, entry) {
        if (store.ring.length < store.capacity) {
          store.ring.push(entry);
          return;
        }
        store.ring[store.head] = entry;
        store.head = (store.head + 1) % store.capacity;
      }
      function completed(store, c, end, outcome) {
        const entry = book(store, c.id), lead = c.finished - c.entered;
        entry.lead.forEach((minutes, i) => {
          store.leadTime[i] += minutes;
        });
        store.flow[flowBin(entry.lead[WORKING], lead)]++;
        store.completedCost += entry.cost;
        store.repeats[Math.min(entry.repeats, REPEAT_BINS - 1)]++;
        if (!entry.repeats) store.firstPass++;
        remember(store, {
          caseId: c.id,
          entered: c.entered,
          finished: c.finished,
          status: "completed",
          end,
          outcome,
          repeats: entry.repeats,
          working: entry.lead[WORKING]
        });
      }
      function failed(store, c) {
        const entry = book(store, c.id);
        store.failedCost += entry.cost;
        store.failedMinutes += c.finished - c.entered;
        remember(store, {
          caseId: c.id,
          entered: c.entered,
          finished: c.finished,
          status: "failed",
          end: null,
          outcome: null,
          repeats: entry.repeats,
          working: null
        });
      }
      function retired(store, caseId) {
        const entry = store.books.get(caseId);
        if (entry) store.running.delete(entry);
        store.books.delete(caseId);
      }
      const totals = (store) => {
        const [working, waiting, blocked, backlog, timer, joining, closed2] = store.leadTime;
        return {
          leadTime: { working, waiting, blocked, backlog, timer, joining, ...store.hours ? { closed: closed2 } : {} },
          flowEfficiency: { counts: [...store.flow] },
          costOf: { completed: store.completedCost, failed: store.failedCost },
          failedMinutes: store.failedMinutes,
          firstPass: store.firstPass,
          repeats: { counts: [...store.repeats] }
        };
      };
      const recent = (store) => [...store.ring.slice(store.head), ...store.ring.slice(0, store.head)].map((entry) => ({ ...entry }));
      root2.LWProcessLedgerCases = { create: create2, book, started, released, charge, closed, repeated, completed, failed, retired, totals, recent };
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessLedgerCases;
    })(globalThis);
