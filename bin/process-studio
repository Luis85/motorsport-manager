// ../wildlands/source/process-replicate.ts
var require_process_replicate = __commonJS({
  "../wildlands/source/process-replicate.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const LIMITS = Object.freeze({ runs: 200, work: 1e6 }), MAX_SEED = 2147483647;
      const NORMAL95 = 1.959963984540054, SERIES_DF = 1e3, BISECTIONS = 64, UPPER = 12.75;
      function central(t, df) {
        const theta = Math.atan(t / Math.sqrt(df)), cos = Math.cos(theta), c2 = cos * cos, odd = df % 2 === 1;
        if (df === 1) return 2 * theta / Math.PI;
        let term = odd ? cos : 1, sum = term;
        for (let k = odd ? 3 : 2; k <= df - 2; k += 2) {
          term *= c2 * (k - 1) / k;
          sum += term;
        }
        return odd ? 2 / Math.PI * (theta + Math.sin(theta) * sum) : Math.sin(theta) * sum;
      }
      function expansion(df) {
        const z = NORMAL95, z2 = z * z, z3 = z2 * z, z5 = z3 * z2, z7 = z5 * z2, z9 = z7 * z2;
        const g1 = (z3 + z) / 4, g2 = (5 * z5 + 16 * z3 + 3 * z) / 96, g3 = (3 * z7 + 19 * z5 + 17 * z3 - 15 * z) / 384;
        const g4 = (79 * z9 + 776 * z7 + 1482 * z5 - 1920 * z3 - 945 * z) / 92160;
        return z + g1 / df + g2 / (df * df) + g3 / df ** 3 + g4 / df ** 4;
      }
      const solved = /* @__PURE__ */ new Map();
      function t95(df) {
        if (df === Infinity) return NORMAL95;
        if (!Number.isSafeInteger(df) || df < 1) throw Error("Degrees of freedom must be a whole number of at least 1.");
        if (df > SERIES_DF) return expansion(df);
        let t = solved.get(df);
        if (t === void 0) {
          let low = NORMAL95, high = UPPER;
          for (let i = 0; i < BISECTIONS; i++) {
            const middle = (low + high) / 2;
            if (central(middle, df) < 0.95) low = middle;
            else high = middle;
          }
          t = (low + high) / 2;
          solved.set(df, t);
        }
        return t;
      }
      const round = (value) => Math.round(value * 1e6) / 1e6 || 0;
      const whole = (value, min, max) => Number.isSafeInteger(value) && value >= min && value <= max;
      function summarize(values) {
        const xs = values.filter((v) => v !== null), n = xs.length;
        if (!n) return { n, mean: null, sd: null, ci95: null, p10: null, p50: null, p90: null };
        const mean = xs.reduce((sum, x) => sum + x, 0) / n, sorted = [...xs].sort((a, b) => a - b);
        const rank = (q) => sorted[Math.max(0, Math.ceil(q * n / 100) - 1)];
        const sd = n > 1 ? Math.sqrt(xs.reduce((sum, x) => sum + (x - mean) * (x - mean), 0) / (n - 1)) : null;
        const half = sd === null ? null : t95(n - 1) * sd / Math.sqrt(n);
        return {
          n,
          mean: round(mean),
          sd: sd === null ? null : round(sd),
          ci95: half === null ? null : [round(mean - half), round(mean + half)],
          p10: round(rank(10)),
          p50: round(rank(50)),
          p90: round(rank(90))
        };
      }
      function plan(options2, definitionSeed, work = 1) {
        const limit = root2.LWProcessRuntime.limits.minutes, { minutes, runs } = options2;
        if (!whole(minutes, 1, limit)) throw Error("Minutes must be a whole number from 1 to " + limit + ".");
        if (!whole(runs, 1, LIMITS.runs)) throw Error("Replications must be a whole number from 1 to " + LIMITS.runs + ".");
        if (runs * minutes * work > LIMITS.work) {
          throw Error("A replication plan may simulate at most " + LIMITS.work + " minutes in total; this one needs " + runs * minutes * work + ".");
        }
        const horizon = options2.horizon === void 0 ? limit : options2.horizon;
        if (horizon !== null && !whole(horizon, minutes, Number.MAX_SAFE_INTEGER)) {
          throw Error("Horizon must be unlimited or a whole number of at least the run minutes.");
        }
        const seed = options2.seed ?? definitionSeed ?? 1;
        if (!whole(seed, 0, MAX_SEED)) throw Error("Seed must be a whole number from 0 to " + MAX_SEED + ".");
        if (seed + runs - 1 > MAX_SEED) throw Error("Seeds " + seed + " to " + (seed + runs - 1) + " pass the largest seed, " + MAX_SEED + ".");
        const warmup = options2.warmup;
        if (warmup !== void 0 && !whole(warmup, 0, minutes - 1)) throw Error("Warm-up must be a whole number of minutes from 0 to " + (minutes - 1) + ".");
        return { minutes, horizon, seeds: Array.from({ length: runs }, (_, i) => seed + i), ...warmup === void 0 ? {} : { warmup } };
      }
      const outcomes = (d) => d.steps.some((s) => s.kind === "end" && s.outcome !== void 0);
      function windowed(d, warmup) {
        const after = " after minute " + warmup;
        return [
          { id: "window.completed", label: "Completed cases" + after },
          { id: "window.failed", label: "Failed cases" + after },
          { id: "window.dropped", label: "Dropped arrivals" + after },
