var require_process_time = __commonJS({
  "../wildlands/source/process-time.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const UNIT = "business minutes", HOURS_FROM = 120;
      function number(n) {
        if (!Number.isFinite(n)) return String(n);
        const [whole, fraction] = String(Math.abs(n)).split(".");
        return (n < 0 ? "-" : "") + whole.replace(/\B(?=(\d{3})+(?!\d))/g, ",") + (fraction !== void 0 ? "." + fraction : "");
      }
      const tenth = (n) => Math.round(n * 10) / 10;
      function minutes(n) {
        const text = number(tenth(n)) + " min";
        return Math.abs(n) >= HOURS_FROM ? `${text} (\u2248 ${number(tenth(n / 60))} h)` : text;
      }
      const maybe = (n) => n === null || n === void 0 || !Number.isFinite(n) ? "\u2014" : minutes(n);
      const usable = (v) => typeof v === "number" && Number.isFinite(v) && v > 0;
      function span(n, calendar) {
        if (!calendar || !usable(calendar.minutesPerDay) || !usable(calendar.daysPerWeek) || !Number.isFinite(n)) return minutes(n);
        const days = Math.abs(n) / calendar.minutesPerDay;
        if (days < 1) return minutes(n);
        const weekly = days > calendar.daysPerWeek, value = weekly ? days / calendar.daysPerWeek : days, shown = tenth(value);
        const unit = (weekly ? "business week" : "business day") + (shown === 1 ? "" : "s");
        return `${number(tenth(n))} min (${shown === value ? "" : "\u2248 "}${number(shown)} ${unit})`;
      }
      const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
      const pad = (n) => String(n).padStart(2, "0");
      const calc = () => globalThis.LWProcessHours;
      const hours = (h) => calc().describe(h);
      const at = (w) => `${DAYS[w.weekday]} ${pad(Math.floor(w.minuteOfDay / 60))}:${pad(w.minuteOfDay % 60)}`;
      const clock = (minute, h) => {
        const w = calc().where(h, minute);
        return `Day ${number(w.day)} \xB7 ${at(w)}`;
      };
      function closedUntil(minute, h) {
        const w = calc().where(h, minute);
        if (w.open) return "";
        const next = calc().where(h, w.opens);
        return `Closed until ${at(next)} on day ${number(next.day)}`;
      }
      root2.LWProcessTime = Object.freeze({ UNIT, HOURS_FROM, number, minutes, maybe, span, hours, clock, closedUntil });
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessTime;
