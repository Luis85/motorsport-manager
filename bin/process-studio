      function ranked(q, d) {
        const names = new Map(d.resources.map((r) => [r.id, r.name]));
        return q.resources.map((metric, i) => ({ name: names.get(metric.id) ?? metric.id, metric, pct: Math.round(metric.utilization * 100), i })).sort((a, b) => b.pct - a.pct || a.i - b.i);
      }
