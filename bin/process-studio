var require_process_bpmn_import = __commonJS({
  "../wildlands/source/process-bpmn-import.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const { MODEL } = root2.LWProcessBpmnExport.vocabulary;
      const kids = (n, l, ns) => root2.LWProcessBpmnExt.kids(n, l, ns);
      const DEFAULTS = {
        defaultDuration: 5,
        process: null,
        lanes: "pools",
        defaultCapacity: 1,
        autoSystemPool: true,
        systemCapacity: 4,
        minutesPerDay: 480,
        minutesPerHour: 60,
        unsupported: "reject",
        bpsim: true,
        scenario: null
      };
      function resolve(o = {}) {
        const out = { ...DEFAULTS }, known = new Set(Object.keys(DEFAULTS));
        for (const k of Object.keys(o)) if (!known.has(k)) throw Error("Unknown import option: " + k + ".");
        const whole = (name, low, high) => {
          const v = o[name];
          if (v === void 0) return;
          if (!Number.isInteger(v) || v < low || v > high) throw Error("Option " + name + " must be a whole number from " + low + " to " + high + ".");
          out[name] = v;
        };
        whole("defaultDuration", 1, 1e5);
        whole("defaultCapacity", 1, 1e3);
        whole("systemCapacity", 1, 1e3);
        whole("minutesPerDay", 1, 1440);
        whole("minutesPerHour", 1, 60);
        if (o.lanes !== void 0) {
          if (o.lanes !== "pools" && o.lanes !== "ignore") throw Error("Option lanes must be pools or ignore.");
          out.lanes = o.lanes;
        }
        if (o.unsupported !== void 0) {
          if (o.unsupported !== "reject" && o.unsupported !== "drop") throw Error("Option unsupported must be reject or drop.");
          out.unsupported = o.unsupported;
        }
        for (const k of ["autoSystemPool", "bpsim"]) {
          if (o[k] === void 0) continue;
          if (typeof o[k] !== "boolean") throw Error("Option " + k + " must be true or false.");
          out[k] = o[k];
        }
        for (const k of ["process", "scenario"]) {
          if (o[k] === void 0) continue;
          if (typeof o[k] !== "string" || !o[k]) throw Error("Option " + k + " must be a non-empty id or name.");
          out[k] = o[k];
        }
        return out;
      }
      class Halt extends Error {
      }
      const empty = (o) => ({ process: null, processes: [], scenario: null, scenarios: [], horizon: null, options: o });
      function analyze(source, raw = {}) {
        const o = resolve(raw), warnings = [], rejections = [], mapping = [];
        const info = empty(o);
        const warn = (m) => {
          if (!warnings.includes(m)) warnings.push(m);
        };
        const ctx = {
          o,
          processes: [],
          bps: void 0,
          warn,
          reject: (id, type, message2) => {
            rejections.push({ id, type, message: message2 });
          },
          unsupported: (item, id, type, message2) => {
            if (o.unsupported === "drop") {
              warn(message2 + " It was dropped.");
              if (item) item.drop = true;
            } else {
              rejections.push({ id, type, message: message2 });
            }
          },
          note: (id, type, target, how) => {
            mapping.push({ id, type, target, how });
          }
        };
        const halt = () => {
          if (rejections.length) throw new Halt();
        };
        let definition;
        try {
          definition = root2.LWProcessBpmnImportParts.run(source, ctx, info, halt);
        } catch (error) {
          if (!(error instanceof Halt)) {
            const message2 = error instanceof Error ? error.message : String(error);
            for (const line of message2.split("\n")) rejections.push({ id: "", type: "import", message: line });
          }
        }
