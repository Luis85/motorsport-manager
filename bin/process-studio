// ../wildlands/source/process-random.ts
var require_process_random = __commonJS({
  "../wildlands/source/process-random.ts"(exports2, module2) {
    (function(inputRoot) {
      "use strict";
      const root2 = inputRoot;
      const limits = root2.LWProcessLimits;
      function hash(text) {
        let h1 = 1779033703, h2 = 3144134277, h3 = 1013904242, h4 = 2773480762;
        for (let i = 0; i < text.length; i++) {
          const k = text.charCodeAt(i);
          h1 = h2 ^ Math.imul(h1 ^ k, 597399067);
          h2 = h3 ^ Math.imul(h2 ^ k, 2869860233);
          h3 = h4 ^ Math.imul(h3 ^ k, 951274213);
          h4 = h1 ^ Math.imul(h4 ^ k, 2716044179);
        }
        h1 = Math.imul(h3 ^ h1 >>> 18, 597399067);
        h2 = Math.imul(h4 ^ h2 >>> 22, 2869860233);
        h3 = Math.imul(h1 ^ h3 >>> 17, 951274213);
        h4 = Math.imul(h2 ^ h4 >>> 19, 2716044179);
        return [(h1 ^ h2 ^ h3 ^ h4) >>> 0, (h2 ^ h1) >>> 0, (h3 ^ h1) >>> 0, (h4 ^ h1) >>> 0];
      }
      function unit(seed, key) {
        let [a, b, c, d] = hash(seed + "|" + key), out = 0;
        for (let round = 0; round < 13; round++) {
          const t = (a + b | 0) + d | 0;
          d = d + 1 | 0;
          a = b ^ b >>> 9;
          b = c + (c << 3) | 0;
          c = c << 21 | c >>> 11;
          c = c + t | 0;
          out = t >>> 0;
        }
        return out / 4294967296;
      }
      const LN2 = 0.6931471805599453;
      function ln(x) {
        let m = x, exponent = 0;
        while (m < 0.5) {
          m *= 2;
          exponent--;
        }
        const y = (m - 1) / (m + 1), y2 = y * y;
        let term = y, sum = 0;
        for (let k = 1; k < 80; k += 2) {
          sum += term / k;
          term *= y2;
        }
        return 2 * sum + exponent * LN2;
      }
      const clamp = (value, low, high) => Math.min(high, Math.max(low, value));
      const int = (seed, key, min, max) => min + Math.floor(unit(seed, key) * (max - min + 1));
      const chance = (seed, key, percent) => unit(seed, key) * 100 < percent;
      function weighted(seed, key, values) {
        const total = values.reduce((n, v) => n + v.weight, 0), r = unit(seed, key) * total;
        let upto = 0;
        for (const v of values) {
          upto += v.weight;
          if (r < upto) return v.value;
        }
        return values[values.length - 1].value;
      }
      function normal(seed, key, mean, sd) {
        for (let attempt = 0; attempt < 64; attempt++) {
          const v1 = 2 * unit(seed, key + "|n" + attempt + "|a") - 1, v2 = 2 * unit(seed, key + "|n" + attempt + "|b") - 1, q = v1 * v1 + v2 * v2;
          if (q >= 1 || q === 0) continue;
          return mean + sd * v1 * Math.sqrt(-2 * ln(q) / q);
        }
        return mean;
      }
      function erlang(seed, key, k, mean) {
        let sum = 0;
        for (let i = 0; i < k; i++) sum += -(mean / k) * ln(1 - unit(seed, key + "|e" + i));
        return sum;
      }
      function sample(seed, key, dist) {
        if (dist.dist === "normal") {
          const low = dist.min ?? 1, high = Math.min(limits.minutes, dist.max ?? dist.mean + 6 * dist.sd);
          return clamp(Math.round(normal(seed, key, dist.mean, dist.sd)), low, high);
        }
        if (dist.dist === "erlang") return clamp(Math.round(erlang(seed, key, dist.k, dist.mean)), 1, limits.minutes);
        const u = unit(seed, key), min = dist.min ?? 1, max = dist.max ?? limits.minutes;
        let value;
        if (dist.dist === "uniform") value = min + Math.floor(u * (max - min + 1));
        else if (dist.dist === "triangular") {
          const mode = dist.mode ?? min, span = max - min, c = span ? (mode - min) / span : 0;
          value = span === 0 ? min : Math.round(u < c ? min + Math.sqrt(u * span * (mode - min)) : max - Math.sqrt((1 - u) * span * (max - mode)));
        } else value = Math.round(-(dist.mean ?? 1) * ln(1 - u));
        const exponential = dist.dist === "exponential";
        return clamp(value, Math.max(1, exponential ? 1 : min), Math.min(limits.minutes, exponential ? dist.max ?? limits.minutes : max));
      }
      root2.LWProcessRandom = { unit, int, chance, weighted, sample };
      if (typeof module2 !== "undefined" && module2.exports) module2.exports = root2.LWProcessRandom;
    })(globalThis);
  }
});

