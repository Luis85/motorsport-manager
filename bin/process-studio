            const prefix = item.xml.toLowerCase().replace(/[^a-z0-9-]+/g, "-");
            ctx.note(item.xml, local, "none", "inlined with " + steps + ' step(s) (phase "' + name.slice(0, 40) + '"); ids prefixed "' + prefix + '-"');
          }
        }
