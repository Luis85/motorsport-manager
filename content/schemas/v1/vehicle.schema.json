{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceleration_mps2": {
      "maximum": 30.0,
      "minimum": 0.1,
      "type": "number"
    },
    "braking_mps2": {
      "maximum": 40.0,
      "minimum": 0.1,
      "type": "number"
    },
    "description": {
      "maxLength": 2048,
      "minLength": 0,
      "type": "string"
    },
    "id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "vehicle"
      ]
    },
    "lateral_acceleration_mps2": {
      "maximum": 60.0,
      "minimum": 1.0,
      "type": "number"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "top_speed_mps": {
      "maximum": 150.0,
      "minimum": 1.0,
      "type": "number"
    },
    "width_m": {
      "maximum": 4.0,
      "minimum": 0.5,
      "type": "number"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "name",
    "description",
    "top_speed_mps",
    "lateral_acceleration_mps2",
    "acceleration_mps2",
    "braking_mps2",
    "width_m"
  ],
  "title": "Motorsport Manager vehicle v1",
  "type": "object"
}
