{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 2048,
      "minLength": 0,
      "type": "string"
    },
    "id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "circuit_style"
      ]
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "visual": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "enum": [
            "meadow",
            "woodland",
            "coastal"
          ]
        },
        "season": {
          "enum": [
            "summer",
            "autumn"
          ]
        },
        "seed": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "environment",
        "season",
        "seed"
      ],
      "type": "object"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "name",
    "description",
    "visual"
  ],
  "title": "Motorsport Manager circuit_style v1",
  "type": "object"
}
