{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "color": {
      "maxLength": 6,
      "minLength": 6,
      "pattern": "^[0-9a-fA-F]{6}$",
      "type": "string"
    },
    "description": {
      "maxLength": 2048,
      "minLength": 0,
      "type": "string"
    },
    "id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "team"
      ]
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "name",
    "description",
    "color"
  ],
  "title": "Motorsport Manager team v1",
  "type": "object"
}
