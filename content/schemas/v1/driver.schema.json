{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consistency": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "description": {
      "maxLength": 2048,
      "minLength": 0,
      "type": "string"
    },
    "id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "driver"
      ]
    },
    "name": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "reliability": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "short": {
      "maxLength": 8,
      "minLength": 1,
      "type": "string"
    },
    "skill": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "wet_skill": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "name",
    "description",
    "short",
    "skill",
    "consistency",
    "wet_skill",
    "reliability"
  ],
  "title": "Motorsport Manager driver v1",
  "type": "object"
}
