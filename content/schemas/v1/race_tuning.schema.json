  "required": [
    "kind",
    "schema_version",
    "id",
    "name",
    "description",
    "model",
    "fuel",
    "pace",
    "service",
    "condition",
    "sessions"
  ],
  "title": "Motorsport Manager race_tuning v1",
  "type": "object"
}
