{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "color": {
      "pattern": "^[0-9a-fA-F]{6}$",
      "type": "string"
    },
    "description": {
      "maxLength": 2048,
      "minLength": 0,
      "type": "string"
    },
    "family": {
      "enum": [
        "slick",
        "intermediate",
        "wet"
      ]
    },
    "grip": {
      "maximum": 2.0,
      "minimum": 0.1,
      "type": "number"
    },
    "id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "tyre"
      ]
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "optimum_c": {
      "maximum": 130.0,
      "minimum": 30.0,
      "type": "number"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "short": {
      "maxLength": 8,
      "minLength": 1,
      "type": "string"
    },
    "surface_response": {
      "additionalProperties": false,
      "properties": {
        "dry_floor": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "dry_loss": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "dry_onset": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "inter_base": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "inter_gain": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "inter_loss": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "inter_peak": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "wet_base": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        "wet_gain": {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "dry_floor",
        "dry_onset",
        "dry_loss",
        "inter_base",
        "inter_gain",
        "inter_peak",
        "inter_loss",
        "wet_base",
        "wet_gain"
      ],
      "type": "object"
    },
    "thermal_profile_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "wear": {
      "maximum": 30.0,
      "minimum": 0.01,
      "type": "number"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "name",
    "description",
    "short",
    "color",
    "family",
    "grip",
    "wear",
    "optimum_c",
    "thermal_profile_id",
    "surface_response"
  ],
  "title": "Motorsport Manager tyre v1",
  "type": "object"
}
