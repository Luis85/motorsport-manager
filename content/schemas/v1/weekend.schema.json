{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 2048,
      "minLength": 0,
      "type": "string"
    },
    "id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "weekend"
      ]
    },
    "mechanic_profile_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "race_tuning_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "roster_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "settings": {
      "additionalProperties": false,
      "properties": {
        "intensity": {
          "enum": [
            "calm",
            "standard",
            "volatile"
          ]
        },
        "laps": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "qual_duration": {
          "maximum": 1800.0,
          "minimum": 120.0,
          "type": "number"
        },
        "rival_styles": {
          "type": "boolean"
        },
        "scenario": {
          "enum": [
            "dry",
            "wet",
            "changeable"
          ]
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "tactical_duels": {
          "type": "boolean"
        },
        "weather_mode": {
          "enum": [
            "seeded",
            "scripted_training"
          ]
        }
      },
      "required": [
        "laps",
        "seed",
        "qual_duration",
        "scenario",
        "intensity",
        "weather_mode",
        "rival_styles",
        "tactical_duels"
      ],
      "type": "object"
    },
    "setup_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "tyre_allocation_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    },
    "vehicle_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)+$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "name",
    "description",
    "vehicle_id",
    "roster_id",
    "tyre_allocation_id",
    "setup_id",
    "race_tuning_id",
    "settings"
  ],
  "title": "Motorsport Manager weekend v1",
  "type": "object"
}
